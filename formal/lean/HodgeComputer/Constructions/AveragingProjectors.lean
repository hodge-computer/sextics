import Mathlib.RingTheory.Ideal.Colon
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.RepresentationTheory.Invariants
import Mathlib.RepresentationTheory.Subrepresentation

/-!
# Combining averaging projectors through a two-sided ideal

If a family of operators sends every vector into a stable submodule, so does
the two-sided ideal that it generates. The ideal of such operators is already
Mathlib's colon ideal `N.colon ⊤`, equivalently the annihilator of the quotient.
The lemmas below expose this consequence and connect it to subgroup averages.

The hypotheses concern an abstract representation and an invariant subspace.
Applications establish separately why that subspace represents geometric
support and why the relevant fixed subspaces lie in it.

Prepared for benediamond with OpenAI Codex assistance.
-/

noncomputable section

namespace HodgeAveragingProjectors

section Module

variable {A V : Type*} [Ring A] [AddCommGroup V] [Module A V]

/-- The two-sided ideal generated by operators with image in `N` also has
image in `N`. Stability is encoded by `N : Submodule A V`. -/
theorem smul_mem_of_mem_span (N : Submodule A V) (s : Set A)
    (hs : ∀ e ∈ s, ∀ v : V, e • v ∈ N)
    {a : A} (ha : a ∈ TwoSidedIdeal.span s) (v : V) : a • v ∈ N := by
  have hspan : TwoSidedIdeal.span s ≤
      (N.colon ((⊤ : Submodule A V) : Set V)).toTwoSided := by
    apply TwoSidedIdeal.span_le.mpr
    intro e he
    exact Ideal.mem_toTwoSided.mpr <| Submodule.mem_colon.mpr fun v _ => hs e he v
  exact Submodule.mem_colon.mp (Ideal.mem_toTwoSided.mp (hspan ha)) v
    (Submodule.mem_top)

/-- An operator in the generated ideal supports every vector that it fixes.
No idempotence hypothesis is needed. -/
theorem mem_of_mem_span_fixed (N : Submodule A V) (s : Set A)
    (hs : ∀ e ∈ s, ∀ v : V, e • v ∈ N)
    {a : A} (ha : a ∈ TwoSidedIdeal.span s) {v : V} (hv : a • v = v) : v ∈ N := by
  simpa only [hv] using smul_mem_of_mem_span N s hs ha v

end Module

section Representation

variable {k G V : Type*} [CommRing k] [Monoid G] [AddCommGroup V] [Module k V]

/-- The ideal-span lemma in the usual language of a representation and a
stable subspace, using Mathlib's group-algebra module structure. -/
theorem apply_mem_of_mem_span (ρ : Representation k G V) (N : Subrepresentation ρ)
    (s : Set (MonoidAlgebra k G))
    (hs : ∀ e ∈ s, ∀ v : V, ρ.asAlgebraHom e v ∈ N)
    {a : MonoidAlgebra k G} (ha : a ∈ TwoSidedIdeal.span s) (v : V) :
    ρ.asAlgebraHom a v ∈ N := by
  have hs' : ∀ e ∈ s, ∀ w : ρ.asModule, e • w ∈ N.asSubmodule := by
    intro e he w
    exact hs e he w
  exact smul_mem_of_mem_span N.asSubmodule s hs' ha (ρ.asModuleEquiv.symm v)

end Representation

section Subgroup

variable {k G V : Type*} [CommRing k] [Group G] [AddCommGroup V] [Module k V]

/-- The normalized average of a finite subgroup, embedded in the ambient
group algebra. The ambient group itself need not be finite. -/
def subgroupAverage (k : Type*) [CommRing k] (H : Subgroup G)
    [Fintype H] [Invertible (Fintype.card H : k)] : MonoidAlgebra k G :=
  MonoidAlgebra.mapDomainAlgHom k k H.subtype (GroupAlgebra.average k H)

/-- Embedding the subgroup average and then acting is the existing averaging
projector of the restricted representation. -/
theorem subgroupAverage_action (ρ : Representation k G V) (H : Subgroup G)
    [Fintype H] [Invertible (Fintype.card H : k)] :
    ρ.asAlgebraHom (subgroupAverage k H) =
      Representation.averageMap (ρ.comp H.subtype) := by
  have hmap (z : MonoidAlgebra k H) :
      ρ.asAlgebraHom (MonoidAlgebra.mapDomainAlgHom k k H.subtype z) =
        Representation.asAlgebraHom (ρ.comp H.subtype) z := by
    induction z using MonoidAlgebra.induction_linear with
    | zero => simp
    | add x y hx hy => simp only [map_add, hx, hy]
    | single h c => simp [Representation.asAlgebraHom_single]
  exact hmap (GroupAlgebra.average k H)

/-- A subgroup average has image in any subspace containing its invariant
subspace. Combine this with `apply_mem_of_mem_span` when `N` is stable under
the ambient group. -/
theorem subgroupAverage_apply_mem (ρ : Representation k G V) (H : Subgroup G)
    [Fintype H] [Invertible (Fintype.card H : k)] (N : Submodule k V)
    (hN : Representation.invariants (ρ.comp H.subtype) ≤ N) (v : V) :
    ρ.asAlgebraHom (subgroupAverage k H) v ∈ N := by
  rw [subgroupAverage_action]
  exact hN (Representation.averageMap_invariant (ρ.comp H.subtype) v)

end Subgroup

end HodgeAveragingProjectors

#print axioms HodgeAveragingProjectors.smul_mem_of_mem_span
#print axioms HodgeAveragingProjectors.apply_mem_of_mem_span
#print axioms HodgeAveragingProjectors.subgroupAverage_apply_mem

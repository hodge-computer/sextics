import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic

/-!
# Sections and degree-zero sheaf cohomology

The additive Yoneda equivalence identifies sections with morphisms from the
free abelian sheaf on an open. The same construction identifies degree-zero
sheaf cohomology with actual sections and respects restriction maps.

These generic constructions retain their public names from `GeometricConeCech`.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2GeometricConeCech

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian Opposite

namespace HZero

universe v w

variable {C : Type v} [Category.{v} C]

/-- Additive Yoneda for the free abelian presheaf generated by an object.
The construction is explicit on the free generators. -/
def freeYonedaSections (F : Cᵒᵖ ⥤ AddCommGrpCat.{v}) (U : C) :
    (yoneda.obj U ⋙ AddCommGrpCat.free ⟶ F) ≃+ F.obj (op U) where
  toFun α := α.app (op U) (FreeAbelianGroup.of (𝟙 U))
  invFun x :=
    { app V := AddCommGrpCat.ofHom (FreeAbelianGroup.lift
        (fun g : V.unop ⟶ U => F.map g.op x))
      naturality V W f := by
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro g
        simp [Functor.comp_map, AddCommGrpCat.free_map,
          AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, yoneda_obj_map,
          ← Functor.map_comp]
        rw [F.map_comp] <;> rfl }
  left_inv α := by
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro g
    simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.ofHom_apply,
      FreeAbelianGroup.lift_apply_of]
    have h := congrArg
      (fun k : (yoneda.obj U ⋙ AddCommGrpCat.free).obj (op U) ⟶ F.obj V =>
        k (FreeAbelianGroup.of (𝟙 U))) (α.naturality g.op)
    simpa [Functor.comp_map, AddCommGrpCat.free_map, AddCommGrpCat.hom_comp,
      AddCommGrpCat.hom_ofHom, yoneda_obj_map] using h.symm
  right_inv x := by
    simp [AddCommGrpCat.hom_ofHom]
  map_add' α β := rfl

theorem freeYonedaSections_precomp (F : Cᵒᵖ ⥤ AddCommGrpCat.{v})
    {U V : C} (g : V ⟶ U) (α : yoneda.obj U ⋙ AddCommGrpCat.free ⟶ F) :
    freeYonedaSections F V
        (Functor.whiskerRight (yoneda.map g) AddCommGrpCat.free ≫ α) =
      F.map g.op (freeYonedaSections F U α) := by
  have h := congrArg
    (fun k : (yoneda.obj U ⋙ AddCommGrpCat.free).obj (op U) ⟶ F.obj (op V) =>
      k (FreeAbelianGroup.of (𝟙 U))) (α.naturality g.op)
  simpa [freeYonedaSections, NatTrans.comp_app, Functor.whiskerRight_app,
    Functor.comp_map, AddCommGrpCat.free_map, AddCommGrpCat.hom_comp,
    AddCommGrpCat.hom_ofHom, yoneda_obj_map, yoneda_map_app] using h


variable {J : GrothendieckTopology C}
  [HasSheafify J AddCommGrpCat.{v}]
  [HasExt.{w} (Sheaf J AddCommGrpCat.{v})]

/-- The canonical degree-zero comparison for the same `H'` used in
Mathlib's Mayer-Vietoris sequence. -/
def sectionsEquiv (F : Sheaf J AddCommGrpCat.{v}) (U : C) :
    F.H' 0 U ≃+ F.obj.obj (op U) :=
  Ext.addEquiv₀.trans
    (((sheafificationAdjunction J AddCommGrpCat).homAddEquiv
      (yoneda.obj U ⋙ AddCommGrpCat.free) F).trans
        (freeYonedaSections F.obj U))

@[simp] theorem sectionsEquiv_mk₀ (F : Sheaf J AddCommGrpCat.{v}) (U : C)
    (α : (presheafToSheaf J AddCommGrpCat).obj
      (yoneda.obj U ⋙ AddCommGrpCat.free) ⟶ F) :
    sectionsEquiv F U (Ext.mk₀ α) =
      freeYonedaSections F.obj U
        ((sheafificationAdjunction J AddCommGrpCat).homEquiv _ _ α) := by
  change freeYonedaSections F.obj U
    ((sheafificationAdjunction J AddCommGrpCat).homAddEquiv _ _
      (Ext.addEquiv₀ (Ext.mk₀ α))) = _
  rw [show Ext.addEquiv₀ (Ext.mk₀ α) = α from Ext.addEquiv₀.apply_symm_apply α] <;> rfl

/-- The comparison respects the actual restriction maps, rather than
merely identifying abstract groups of the same size. -/
theorem sectionsEquiv_naturality (F : Sheaf J AddCommGrpCat.{v})
    {U V : C} (g : V ⟶ U) (z : F.H' 0 U) :
    sectionsEquiv F V ((F.cohomologyPresheaf 0).map g.op z) =
      F.obj.map g.op (sectionsEquiv F U z) := by
  obtain ⟨α, rfl⟩ := (Ext.mk₀_bijective _ _).surjective z
  change sectionsEquiv F V
    ((Ext.mk₀ ((presheafToSheaf J AddCommGrpCat).map
      (Functor.whiskerRight (yoneda.map g) AddCommGrpCat.free))).comp
        (Ext.mk₀ α) (zero_add 0)) = _
  rw [Ext.mk₀_comp_mk₀, sectionsEquiv_mk₀, sectionsEquiv_mk₀,
    (sheafificationAdjunction J AddCommGrpCat).homEquiv_naturality_left]
  exact freeYonedaSections_precomp F.obj g _


end HZero

end CycleQ2GeometricConeCech

end

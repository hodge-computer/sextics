/-!
# The original section functional identifies its actual row ideal

The image of the existing linkage functional for M*t is exactly the ideal
generated by the original three rows. A regular row makes this map
injective, so it identifies the original left ideal with that row ideal.
The comparison retains the same vector t and the negative fourth-power
transition on its source; it does not replace the original matrix section.

One simultaneous regular-section choice covers both the 36 refinements
used for first-order flatness and the 27 refinements of the original
three linkage charts. The resulting endpoint has one common nonzero
complex vector, the existing proper flat nonempty first-order curve, and
all the original local ideal comparisons, with no additional premise.

The global sheaf morphism and its ideal-sheaf identification remain to be
constructed. No global divisor, Abel--Jacobi, or residue-exactness theorem
is asserted here. Source-only draft: no elaboration or kernel replay was
run. Prepared for fqlx with OpenAI ChatGPT assistance; the geometric route
and attribution to Ben Diamond are recorded in solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2SeedSectionIdealComparison

open CategoryTheory AlgebraicGeometry Matrix
open CycleQ2SegreFactorSequence CycleQ2SegreLinkageDuality
  CycleQ2SeedProjectiveImageTwist CycleQ2SeedImageTwistedDuality
  CycleQ2SeedSectionInverse

section Algebra

variable {R : Type*} [CommRing R]

/-- A regular value suffices for injectivity of an actual ideal functional.
The balance identity uses the ideal's original inclusion into the ring. -/
theorem functional_injective_of_regular_value (I : Ideal R)
    (φ : I →ₗ[R] R) (a : I) (hreg : IsSMulRegular R (φ a)) :
    Function.Injective φ := by
  intro x y hxy
  apply Subtype.ext
  apply hreg
  change φ a * (x : R) = φ a * (y : R)
  calc
    φ a * (x : R) = (x : R) * φ a := mul_comm _ _
    _ = (a : R) * φ x := CycleQ2SectionInverseIdeal.balanced I φ x a
    _ = (a : R) * φ y := by rw [hxy]
    _ = (y : R) * φ a := CycleQ2SectionInverseIdeal.balanced I φ a y
    _ = φ a * (y : R) := mul_comm _ _

/-- The actual three-row ideal, with the original constant vector retained. -/
def rowIdeal (F : FactorData R) (t : Fin 3 → R) : Ideal R :=
  Ideal.span (Set.range (F.matrix *ᵥ t))

/-- Evaluation on the left linkage ideal has exactly the original row image. -/
theorem sectionFunctional_range (F : FactorData R) (t : Fin 3 → R) :
    LinearMap.range (sectionFunctional F t) = rowIdeal F t := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    have hx : x = ∑ q : Fin 3 × Fin 3,
        (weights F q * pairing F (rightElement F q.2) x) • leftElement F q.1 := by
      apply Subtype.ext
      simpa only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul, leftElement] using
        left_reconstruction F x
    rw [hx, map_sum]
    apply Ideal.sum_mem
    intro q _
    rw [map_smul, sectionFunctional_left]
    exact (rowIdeal F t).smul_mem _ (Ideal.subset_span ⟨q.1, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact ⟨leftElement F a, sectionFunctional_left F t a⟩

theorem sectionFunctional_injective_of_regular_row (F : FactorData R)
    (t : Fin 3 → R) (a : Fin 3)
    (hreg : IsSMulRegular R ((F.matrix *ᵥ t) a)) :
    Function.Injective (sectionFunctional F t) := by
  apply functional_injective_of_regular_value F.leftIdeal
    (sectionFunctional F t) (leftElement F a)
  simpa only [sectionFunctional_left] using hreg

/-- The original functional, corestricted to the original row ideal. -/
def sectionIdealEquiv (F : FactorData R) (t : Fin 3 → R) (a : Fin 3)
    (hreg : IsSMulRegular R ((F.matrix *ᵥ t) a)) :
    F.leftIdeal ≃ₗ[R] rowIdeal F t :=
  (LinearEquiv.ofInjective (sectionFunctional F t)
    (sectionFunctional_injective_of_regular_row F t a hreg)).trans
      (LinearEquiv.ofEq _ _ (sectionFunctional_range F t))

theorem sectionIdealEquiv_val (F : FactorData R) (t : Fin 3 → R) (a : Fin 3)
    (hreg : IsSMulRegular R ((F.matrix *ᵥ t) a)) (x : F.leftIdeal) :
    (sectionIdealEquiv F t a hreg x : R) = sectionFunctional F t x := rfl

/-- The negative fourth-power source transition makes evaluation invariant.
This is the required local map from I_E(-4), retaining the same t. -/
theorem sectionFunctional_twisted_transition (F G : FactorData R) (u : Rˣ)
    (hM : G.matrix = (u : R) ^ 14 • F.matrix)
    (hL : ∀ a, G.left a = (u : R) ^ 10 * F.left a)
    (t : Fin 3 → R) (x : F.leftIdeal) :
    sectionFunctional G t
        ((((u⁻¹ : Rˣ) : R) ^ 4) • idealEquiv F G u hL x) =
      sectionFunctional F t x := by
  rw [sectionFunctional_transition F G u hM hL t,
    map_smul, LinearEquiv.symm_apply_apply, map_smul, smul_eq_mul,
    ← mul_assoc, ← mul_pow, Units.mul_inv, one_pow, one_mul]

end Algebra

/-! ## Original projective linkage charts and their pivot refinements -/

open CycleQ2SeedProjectiveImageChart CycleQ2SeedImageLocalization

abbrev Pivot := CycleQ2SegreCech.Chart

def linkagePivot (i : Fin 3) (p : Pivot) : AffineRing i :=
  (chartFactorData i).matrix p.1 p.2

abbrev LinkageRefinement (i : Fin 3) (p : Pivot) :=
  Localization.Away (linkagePivot i p)

def refinedFactorData (i : Fin 3) (p : Pivot) : FactorData (LinkageRefinement i p) :=
  localizedFactorData (chartFactorData i) (Submonoid.powers (linkagePivot i p))
    (LinkageRefinement i p)

theorem refinedFactorData_pivot_isUnit (i : Fin 3) (p : Pivot) :
    IsUnit ((refinedFactorData i p).matrix p.1 p.2) :=
  IsLocalization.Away.algebraMap_isUnit (linkagePivot i p)

def refinedVector (t : Fin 3 → ℂ) (i : Fin 3) (p : Pivot) :
    Fin 3 → LinkageRefinement i p :=
  fun j => algebraMap ℂ (LinkageRefinement i p) (t j)

/-- The target ideal on a refinement is the actual extension of the
original affine row ideal, not an unrelated principal-ideal model. -/
theorem refined_rowIdeal_eq_map (t : Fin 3 → ℂ) (i : Fin 3) (p : Pivot) :
    rowIdeal (refinedFactorData i p) (refinedVector t i p) =
      (rowIdeal (chartFactorData i)
        (fun j => algebraMap ℂ (AffineRing i) (t j))).map
          (algebraMap (AffineRing i) (LinkageRefinement i p)) := by
  rw [rowIdeal, rowIdeal, Ideal.map_span, Set.image_range]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext a
  simp only [Matrix.mulVec, dotProduct, map_sum, map_mul]
  apply Finset.sum_congr rfl
  intro j _
  change algebraMap (AffineRing i) (LinkageRefinement i p)
      ((chartFactorData i).matrix a j) * algebraMap ℂ (LinkageRefinement i p) (t j) =
    algebraMap (AffineRing i) (LinkageRefinement i p)
      ((chartFactorData i).matrix a j) *
        algebraMap (AffineRing i) (LinkageRefinement i p)
          (algebraMap ℂ (AffineRing i) (t j))
  rw [← IsScalarTower.algebraMap_apply ℂ (AffineRing i) (LinkageRefinement i p)]

/-! ## A single vector for flatness and all original local ideal maps -/

open scoped DualNumber
open CycleQ2FirstOrderCurveChartFlat CycleQ2FirstOrderCurvePivotCover
  CycleQ2FirstOrderCurveCharts CycleQ2FirstOrderCurve
  CycleQ2FirstOrderCurveSeedFiber CycleQ2SpecializedProjectiveCurve
  CycleQ2SeedSectionNonempty CycleQ2IncidencePolynomialJacobianBinding

attribute [local instance] CycleQ2IncidenceFirstOrder.firstOrderAlgebra

abbrev RegularityIndex := (Fin 4 × Pivot) ⊕ (Fin 3 × Pivot)

def RegularityRing : RegularityIndex → Type
  | .inl a => SeedRefinement a.1 a.2
  | .inr a => LinkageRefinement a.1 a.2

instance regularityRing_commRing (a : RegularityIndex) : CommRing (RegularityRing a) := by
  cases a <;> dsimp only [RegularityRing] <;> infer_instance

instance regularityRing_algebra (a : RegularityIndex) : Algebra ℂ (RegularityRing a) := by
  cases a <;> dsimp only [RegularityRing] <;> infer_instance

instance regularityRing_noetherian (a : RegularityIndex) :
    IsNoetherianRing (RegularityRing a) := by
  cases a <;> dsimp only [RegularityRing] <;> infer_instance

def regularityCoefficient : ∀ a : RegularityIndex, Fin 3 → RegularityRing a
  | .inl a => seedRefinedCoefficient a.1 a.2
  | .inr a => fun j => (refinedFactorData a.1 a.2).matrix a.2.1 j

theorem regularityCoefficient_hasUnit (a : RegularityIndex) :
    ∃ j, IsUnit (regularityCoefficient a j) := by
  cases a with
  | inl a =>
    exact ⟨a.2.2, IsLocalization.Away.algebraMap_isUnit (seedPivot a.1 a.2)⟩
  | inr a =>
    exact ⟨a.2.2, refinedFactorData_pivot_isUnit a.1 a.2⟩

theorem exists_one_vector_regular :
    ∃ t : Fin 3 → ℂ, t ≠ 0 ∧
      (∀ (i : Fin 4) (p : Pivot),
        IsSMulRegular (SeedRefinement i p) (seedRefinedEquation t i p)) ∧
      (∀ (i : Fin 3) (p : Pivot), IsSMulRegular (LinkageRefinement i p)
        (((refinedFactorData i p).matrix *ᵥ refinedVector t i p) p.1)) := by
  obtain ⟨t, ht, hreg⟩ :=
    CycleQ2SimultaneousRegularSection.exists_nonzero_simultaneous_regular
      (k := ℂ) RegularityRing regularityCoefficient regularityCoefficient_hasUnit
  refine ⟨t, ht, ?_, ?_⟩
  · intro i p
    rw [seedRefinedEquation_eq_sum]
    exact hreg (.inl (i, p))
  · intro i p
    have h := hreg (.inr (i, p))
    change IsSMulRegular (LinkageRefinement i p)
      (∑ j, t j • (refinedFactorData i p).matrix p.1 j) at h
    have he : ((refinedFactorData i p).matrix *ᵥ refinedVector t i p) p.1 =
        ∑ j, t j • (refinedFactorData i p).matrix p.1 j := by
      simp only [Matrix.mulVec, dotProduct, refinedVector, Algebra.smul_def]
      apply Finset.sum_congr rfl
      intro j _
      exact mul_comm _ _
    rw [he]
    exact h

/-- CLOSED SOURCE-LEVEL ENDPOINT: one original complex vector simultaneously
gives the proper flat nonempty first-order curve and every original local
section-ideal comparison. No independent witness is substituted. -/
theorem exists_nonempty_flat_curve_with_section_ideal_comparisons :
    ∃ t : Fin 3 → ℂ, t ≠ 0 ∧
      AlgebraicGeometry.Flat (firstOrderCurveToBase t) ∧
      AlgebraicGeometry.IsProper (firstOrderCurveToBase t) ∧
      Nonempty (specializedCurve
        (seedPoint (57 : ℂ) Complex.I) t ≅ FirstOrderCurveSeedFiber t) ∧
      Nonempty (specializedCurve (seedPoint (57 : ℂ) Complex.I) t) ∧
      Nonempty (FirstOrderCurveSeedFiber t) ∧
      (∀ (i : Fin 4) (p : Pivot),
        IsSMulRegular (SeedRefinement i p) (seedRefinedEquation t i p)) ∧
      ∀ (i : Fin 3) (p : Pivot),
        IsSMulRegular (LinkageRefinement i p)
          (((refinedFactorData i p).matrix *ᵥ refinedVector t i p) p.1) ∧
        ∃ e : (refinedFactorData i p).leftIdeal ≃ₗ[LinkageRefinement i p]
            rowIdeal (refinedFactorData i p) (refinedVector t i p),
          ∀ x, (e x : LinkageRefinement i p) =
            sectionFunctional (refinedFactorData i p) (refinedVector t i p) x := by
  obtain ⟨t, ht, hfirst, hlinkage⟩ := exists_one_vector_regular
  have hflat (i : Fin 4) :
      Module.Flat (DualNumber ℂ) (CycleQ2FirstOrderChartReduction.FirstOrderCurveChart t i) :=
    curveChart_flat_of_refined t i (fun p => refinedCurveChart_flat t i p (hfirst i p))
  let e := firstOrderCurveSeedFiberIso t
  obtain ⟨x⟩ := seed_specializedCurve_nonempty t
  refine ⟨t, ht, firstOrderCurveToBase_flat_of_affineCharts t hflat,
    firstOrderCurveToBase_proper t, ⟨e⟩, ⟨x⟩, ⟨e.hom x⟩, hfirst, ?_⟩
  intro i p
  exact ⟨hlinkage i p,
    sectionIdealEquiv (refinedFactorData i p) (refinedVector t i p)
    p.1 (hlinkage i p), fun x => rfl⟩

end CycleQ2SeedSectionIdealComparison


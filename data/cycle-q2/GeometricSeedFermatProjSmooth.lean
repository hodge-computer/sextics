import Proposal.GeometricSeedFermatChartRetract
import Mathlib.AlgebraicGeometry.Morphisms.Smooth
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Smoothness of the actual weighted projective Fermat seed

For `r ^ 3 = 2`, the four weight-one coordinate opens cover the projective
spectrum of the original quotient by `seedFamily r 0`. A projective prime
containing all four weight-one coordinates would also contain the last
coordinate, by the Fermat relation, and hence contain the irrelevant ideal.

On each of these opens, the native `Proj.basicOpenIsoSpec` identifies the
structure morphism with the coefficient map of the homogeneous localization.
The preceding chart retraction theorem proves that exact complex algebra
smooth. Zariski locality therefore proves smoothness of the actual weighted
projective structure morphism, with no smoothness hypothesis on the scheme.

Status: source-only proof draft; no Lean elaboration or kernel replay was run
in this session. Prepared for `fqlx` with OpenAI ChatGPT assistance.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2SeedFermatProjSmooth

open CategoryTheory TopologicalSpace AlgebraicGeometry MvPolynomial
open CycleQ2GeometricSeedSmooth CycleQ2SeedFermatCone
  CycleQ2SeedFermatProj CycleQ2SeedFermatChartRetract

/-- Positive-degree classes belong to the ideal generated by the original
five coordinate classes in the actual quotient. -/
theorem irrelevant_le_coordinateIdeal (r : ℂ) :
    (HomogeneousIdeal.irrelevant (coneGrade r)).toIdeal ≤
      Ideal.span (Set.range (coordinateClass r)) := by
  apply (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr
  intro n hn q hq
  obtain ⟨p, hp, rfl⟩ := hq
  have hpI : p ∈ MvPolynomial.idealOfVars (Fin 5) ℂ := by
    have hpow : p ∈ MvPolynomial.idealOfVars (Fin 5) ℂ ^ 1 := by
      apply (MvPolynomial.mem_pow_idealOfVars_iff' 1 p).mpr
      intro e he
      have he0 : e = 0 := (Finsupp.degree_eq_zero_iff e).mp (by omega)
      subst e
      by_contra hc
      have hz : 0 = n := by simpa only [map_zero] using hp hc
      omega
    simpa only [pow_one] using hpow
  have hmap : MvPolynomial.idealOfVars (Fin 5) ℂ ≤
      (Ideal.span (Set.range (coordinateClass r))).comap (coneQuotient r) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨j, rfl⟩
  exact hmap hpI

/-- Every point of the actual weighted Proj has a nonvanishing weight-one
coordinate. This is the precise place where the Fermat relation is used. -/
theorem exists_weightOne_not_mem (r : ℂ) (hr : r ^ 3 = 2) (q : threefold r) :
    ∃ i : Fin 4, coordinateClass r i.castSucc ∉ q.asHomogeneousIdeal.toIdeal := by
  classical
  by_contra! h
  let P : Ideal (ConeRing r) := q.asHomogeneousIdeal.toIdeal
  letI : P.IsPrime := q.isPrime
  have hz (i : Fin 4) : Ideal.Quotient.mk P (coordinateClass r i.castSucc) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (h i)
  have hw3 : Ideal.Quotient.mk P (coordinateClass r 4) ^ 3 = 0 := by
    have hF := congrArg (Ideal.Quotient.mk P) (fermatRelation r hr)
    simpa only [map_add, map_pow, map_zero, hz 0, hz 1, hz 2, hz 3,
      zero_pow (by decide : (6 : ℕ) ≠ 0), zero_add] using hF
  have hw : coordinateClass r 4 ∈ P :=
    Ideal.Quotient.eq_zero_iff_mem.mp (eq_zero_of_pow_eq_zero hw3)
  have hspan : Ideal.span (Set.range (coordinateClass r)) ≤ P := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    fin_cases j
    · exact h 0
    · exact h 1
    · exact h 2
    · exact h 3
    · exact hw
  exact q.not_irrelevant_le ((irrelevant_le_coordinateIdeal r).trans hspan)

/-- An actual weight-one coordinate open of the weighted projective seed. -/
def coordinateOpen (r : ℂ) (i : Fin 4) : (threefold r).Opens :=
  Proj.basicOpen (coneGrade r) (coordinateClass r i.castSucc)

theorem coordinateOpens_cover (r : ℂ) (hr : r ^ 3 = 2) :
    (⨆ i : Fin 4, coordinateOpen r i) = ⊤ := by
  apply top_le_iff.mp
  intro q _
  obtain ⟨i, hi⟩ := exists_weightOne_not_mem r hr q
  exact Opens.mem_iSup.mpr ⟨i, hi⟩

/-- The native projective affine chart, with no replacement of its ring. -/
def coordinateChart (r : ℂ) (i : Fin 4) :
    (coordinateOpen r i).toScheme ≅ Spec (CommRingCat.of (ChartRing r i)) :=
  Proj.basicOpenIsoSpec (coneGrade r) (coordinateClass r i.castSucc)
    (coordinate_mem_grade r i) (by decide)

/-- The chart coefficient map is exactly the restriction of the chosen
projective structure morphism to `Spec ℂ`. -/
theorem coordinateChart_overComplex (r : ℂ) (i : Fin 4) :
    (coordinateChart r i).inv ≫ (coordinateOpen r i).ι ≫ threefoldToComplex r =
      Spec.map (CommRingCat.ofHom (algebraMap ℂ (ChartRing r i))) := by
  change (Proj.basicOpenIsoSpec (coneGrade r) (coordinateClass r i.castSucc)
      (coordinate_mem_grade r i) (by decide)).inv ≫
      (Proj.basicOpen (coneGrade r) (coordinateClass r i.castSucc)).ι ≫
      threefoldToComplex r = _
  rw [Proj.basicOpenIsoSpec_inv_ι_assoc, threefoldToComplex,
    Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
  rfl

theorem coordinateOpen_smooth (r : ℂ) (hr : r ^ 3 = 2) (i : Fin 4) :
    AlgebraicGeometry.Smooth ((coordinateOpen r i).ι ≫ threefoldToComplex r) := by
  apply (MorphismProperty.cancel_left_of_respectsIso
    (P := @AlgebraicGeometry.Smooth) (coordinateChart r i).inv
    ((coordinateOpen r i).ι ≫ threefoldToComplex r)).mp
  rw [coordinateChart_overComplex]
  apply (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Smooth)).mpr
  exact RingHom.smooth_algebraMap.mpr (chartRing_smooth r hr i)

/-- The zero-cubic seed with `r ^ 3 = 2` is a smooth actual weighted
projective scheme over the original complex coefficient field. -/
theorem threefold_smooth (r : ℂ) (hr : r ^ 3 = 2) :
    AlgebraicGeometry.Smooth (threefoldToComplex r) := by
  exact IsZariskiLocalAtSource.of_iSup_eq_top
    (P := @AlgebraicGeometry.Smooth) (fun i : Fin 4 => coordinateOpen r i)
    (coordinateOpens_cover r hr) (coordinateOpen_smooth r hr)

/-- The coefficient field itself supplies the required cube-root parameter,
so this smooth projective seed exists without a supplied root witness. -/
theorem exists_threefold_smooth :
    ∃ r : ℂ, r ^ 3 = 2 ∧ AlgebraicGeometry.Smooth (threefoldToComplex r) := by
  obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (2 : ℂ) (n := 3) (by decide)
  exact ⟨r, hr, threefold_smooth r hr⟩

end CycleQ2SeedFermatProjSmooth

end

#print axioms CycleQ2SeedFermatProjSmooth.coordinateOpens_cover
#print axioms CycleQ2SeedFermatProjSmooth.coordinateChart_overComplex
#print axioms CycleQ2SeedFermatProjSmooth.threefold_smooth
#print axioms CycleQ2SeedFermatProjSmooth.exists_threefold_smooth

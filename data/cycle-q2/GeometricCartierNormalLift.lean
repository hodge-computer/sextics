import Proposal.GeometricNormalConnecting
import Proposal.GeometricCurveCover
import Mathlib.Algebra.Regular.SMul

/-!
# Actual Cartier generators and normal lifts on the containing surface

The curve ideal in `P/(F,h)` is generated by `f2` where `g1` is invertible,
and by `f1` where `g2` is invertible.  The generators are regular: their
regularity is deduced from the already proved monic regular sequences in
the ambient polynomial ring, rather than assumed from smoothness.

These are the actual local ideal modules used for an inverse-ideal lift
of the normal connecting cochain.  Surface cohomology and its coordinate
cover comparison are not identified by a choice of a trace-matched vector.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section
open scoped BigOperators TensorProduct

namespace CycleQ2GeometricCartierNormalLift

section Algebra

variable {R : Type*} [CommRing R]

/-- A relation in `(F,h)` becomes divisible by its cofactor modulo that ideal.
This is the algebraic cancellation needed after inverting the cofactor. -/
theorem cofactor_torsion (a b c d h k F x : R)
    (hF : F = a*c+b*d+h*k)
    (hb : ∀ y : R, b*y ∈ Ideal.span ({h} : Set R) → y ∈ Ideal.span ({h} : Set R))
    (ha : ∀ y : R, a*y ∈ Ideal.span ({h,b} : Set R) → y ∈ Ideal.span ({h,b} : Set R))
    (hx : b*x ∈ Ideal.span ({F,h} : Set R)) :
    c*x ∈ Ideal.span ({F,h} : Set R) := by
  obtain ⟨u,v,hu⟩ := Ideal.mem_span_pair.mp hx
  have hcu : c*u ∈ Ideal.span ({h,b} : Set R) := ha _ (by
    apply Ideal.mem_span_pair.mpr
    refine ⟨-k*u-v, x-d*u, ?_⟩
    linear_combination -hu + u*hF)
  obtain ⟨s,t,hst⟩ := Ideal.mem_span_pair.mp hcu
  have hrem : c*x-F*t ∈ Ideal.span ({h} : Set R) := hb _ (by
    apply Ideal.mem_span_singleton'.mpr
    refine ⟨F*s+c*v, ?_⟩
    linear_combination c*hu + F*hst)
  have hsub : Ideal.span ({h} : Set R) ≤ Ideal.span ({F,h} : Set R) :=
    Ideal.span_mono (by intro z hz; simp only [Set.mem_singleton_iff] at hz; simp [hz])
  have hFt : F*t ∈ Ideal.span ({F,h} : Set R) :=
    Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  simpa using (Ideal.span ({F,h} : Set R)).add_mem (hsub hrem) hFt

/-- If a cofactor kills all torsion of a generator, inverting that cofactor
makes the generator regular. The proof uses the actual localization fractions. -/
theorem regular_after_localizing (b g : R)
    (h : ∀ x : R, b*x=0 → g*x=0) :
    IsSMulRegular (Localization.Away g) (algebraMap R (Localization.Away g) b) := by
  apply IsSMulRegular.of_right_eq_zero_of_smul
  intro x hx
  change algebraMap R (Localization.Away g) b * x = 0 at hx
  obtain ⟨⟨p,s⟩,hps⟩ := IsLocalization.surj (Submonoid.powers g) x
  have hp : algebraMap R (Localization.Away g) (b*p) = 0 := by
    rw [map_mul, ← hps, ← mul_assoc, hx, zero_mul]
  obtain ⟨t,ht⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers g)
    (Localization.Away g) (b*p)).mp hp
  have htp : g*((t:R)*p)=0 := h _ (by simpa [mul_assoc,mul_left_comm] using ht)
  have hp0 : algebraMap R (Localization.Away g) p = 0 := by
    apply (IsLocalization.map_eq_zero_iff (Submonoid.powers g) (Localization.Away g) p).mpr
    refine ⟨(⟨g,1,pow_one g⟩ : Submonoid.powers g)*t, ?_⟩
    simpa only [Submonoid.coe_mul, mul_assoc] using htp
  exact (IsUnit.mul_left_eq_zero (IsLocalization.map_units (Localization.Away g) s)).mp
    (hps.trans hp0)

end Algebra

open MvPolynomial CycleQ2ConormalJacobian CycleQ2NormalConnecting CycleQ2SeedTrace
  CycleQ2SeedRegularLeading CycleQ2GeometricSeedNormalIdeals

/-- The quotient by the literal surface equations. -/
def surfaceQuotient (r θ : ℂ) : P →+* SurfaceRing r θ :=
  Ideal.Quotient.mk (surfaceIdeal r θ)

theorem surfaceIdeal_eq_pair (r θ : ℂ) :
    surfaceIdeal r θ = Ideal.span ({actualSeedEquation r θ,thetaH θ} : Set P) := by
  unfold surfaceIdeal
  congr 1
  ext x
  simp [surfaceEquations, Set.mem_range, Fin.exists_fin_succ, eq_comm, or_comm]

@[simp] theorem surfaceQuotient_F (r θ : ℂ) :
    surfaceQuotient r θ (actualSeedEquation r θ) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨0,rfl⟩)

@[simp] theorem surfaceQuotient_h (r θ : ℂ) : surfaceQuotient r θ (thetaH θ) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨1,rfl⟩)

/-- Multiplication by `f2` in the actual surface quotient has only `g1`-torsion. -/
theorem first_generator_torsion (r θ : ℂ) (x : SurfaceRing r θ)
    (hx : surfaceQuotient r θ originalF2*x=0) :
    surfaceQuotient r θ (originalG1 r)*x=0 := by
  obtain ⟨p,rfl⟩ := Ideal.Quotient.mk_surjective x
  change surfaceQuotient r θ originalF2 * surfaceQuotient r θ p = 0 at hx
  change surfaceQuotient r θ (originalG1 r) * surfaceQuotient r θ p = 0
  rw [← map_mul] at hx ⊢
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [surfaceIdeal_eq_pair]
  apply cofactor_torsion (originalF1 r) originalF2 (originalG1 r) originalG2
    (thetaH θ) (thetaK θ) (actualSeedEquation r θ) p rfl
  · exact fun y hy => CycleQ2MonicRegular.pair_regular_mod_first auxiliaryOrder
      (h_leading_data θ).2 f2_leading_data.2 (fun i => (f2_h_coprime θ i).symm) y hy
  · exact fun y hy => CycleQ2MonicRegular.triple_regular_mod_pair auxiliaryOrder
      (h_leading_data θ).2 f2_leading_data.2 (f1_leading_data r).2
      (fun i => (f2_h_coprime θ i).symm) (fun i => (f1_h_coprime r θ i).symm)
      (fun i => (f1_f2_coprime r i).symm) y hy
  · simpa only [surfaceIdeal_eq_pair] using Ideal.Quotient.eq_zero_iff_mem.mp hx

/-- Multiplication by `f1` has the complementary `g2`-torsion bound. -/
theorem second_generator_torsion (r θ : ℂ) (x : SurfaceRing r θ)
    (hx : surfaceQuotient r θ (originalF1 r)*x=0) :
    surfaceQuotient r θ originalG2*x=0 := by
  obtain ⟨p,rfl⟩ := Ideal.Quotient.mk_surjective x
  change surfaceQuotient r θ (originalF1 r) * surfaceQuotient r θ p = 0 at hx
  change surfaceQuotient r θ originalG2 * surfaceQuotient r θ p = 0
  rw [← map_mul] at hx ⊢
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [surfaceIdeal_eq_pair]
  apply cofactor_torsion originalF2 (originalF1 r) originalG2 (originalG1 r)
    (thetaH θ) (thetaK θ) (actualSeedEquation r θ) p (by unfold actualSeedEquation; ring)
  · exact fun y hy => CycleQ2MonicRegular.pair_regular_mod_first auxiliaryOrder
      (h_leading_data θ).2 (f1_leading_data r).2 (fun i => (f1_h_coprime r θ i).symm) y hy
  · exact fun y hy => CycleQ2MonicRegular.triple_regular_mod_pair auxiliaryOrder
      (h_leading_data θ).2 (f1_leading_data r).2 f2_leading_data.2
      (fun i => (f1_h_coprime r θ i).symm) (fun i => (f2_h_coprime θ i).symm)
      (f1_f2_coprime r) y hy
  · simpa only [surfaceIdeal_eq_pair] using Ideal.Quotient.eq_zero_iff_mem.mp hx

abbrev FirstSurfaceOpen (r θ : ℂ) := Localization.Away (surfaceQuotient r θ (originalG1 r))
abbrev SecondSurfaceOpen (r θ : ℂ) := Localization.Away (surfaceQuotient r θ originalG2)

def firstPolyMap (r θ : ℂ) : P →+* FirstSurfaceOpen r θ :=
  (algebraMap (SurfaceRing r θ) (FirstSurfaceOpen r θ)).comp (surfaceQuotient r θ)

def secondPolyMap (r θ : ℂ) : P →+* SecondSurfaceOpen r θ :=
  (algebraMap (SurfaceRing r θ) (SecondSurfaceOpen r θ)).comp (surfaceQuotient r θ)

theorem first_generator_regular (r θ : ℂ) :
    IsSMulRegular (FirstSurfaceOpen r θ) (firstPolyMap r θ originalF2) :=
  regular_after_localizing (surfaceQuotient r θ originalF2)
    (surfaceQuotient r θ (originalG1 r)) (first_generator_torsion r θ)

theorem second_generator_regular (r θ : ℂ) :
    IsSMulRegular (SecondSurfaceOpen r θ) (secondPolyMap r θ (originalF1 r)) :=
  regular_after_localizing (surfaceQuotient r θ (originalF1 r))
    (surfaceQuotient r θ originalG2) (second_generator_torsion r θ)


section PrincipalIdeal

variable {S : Type*} [CommRing S]

def multiplicationToIdeal (I : Ideal S) (b : S) (hI : I = Ideal.span ({b} : Set S)) :
    S →ₗ[S] I where
  toFun x := ⟨x*b, by rw [hI]; exact Ideal.mem_span_singleton'.mpr ⟨x,rfl⟩⟩
  map_add' x y := by apply Subtype.ext; exact add_mul x y b
  map_smul' a x := by apply Subtype.ext; exact mul_assoc a x b

def principalIdealEquiv (I : Ideal S) (b : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) : S ≃ₗ[S] I :=
  LinearEquiv.ofBijective (multiplicationToIdeal I b hI) ⟨by
    intro x y hxy
    have hxy' := congrArg Subtype.val hxy
    change x*b=y*b at hxy'
    apply hb
    change b*x=b*y
    simpa only [mul_comm] using hxy',
    by
      intro x
      have hx : (x:S) ∈ Ideal.span ({b} : Set S) := by
        rw [←hI]
        exact x.property
      obtain ⟨a,ha⟩ := Ideal.mem_span_singleton'.mp hx
      exact ⟨a,Subtype.ext ha⟩⟩

/-- Division by the actual regular generator, as a linear functional on the ideal. -/
def inverseIdealGenerator (I : Ideal S) (b : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) : I →ₗ[S] S :=
  (principalIdealEquiv I b hb hI).symm.toLinearMap

theorem inverseIdealGenerator_mul (I : Ideal S) (b : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) (x : I) :
    inverseIdealGenerator I b hb hI x*b=(x:S) :=
  congrArg Subtype.val ((principalIdealEquiv I b hb hI).apply_symm_apply x)

/-- A genuine element of the inverse ideal `Hom(I,S)`, with cofactor normalization. -/
def cofactorHom (I : Ideal S) (b c : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) : I →ₗ[S] S :=
  (-c) • inverseIdealGenerator I b hb hI

theorem cofactorHom_mul (I : Ideal S) (b c : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) (x : I) :
    b*cofactorHom I b c hb hI x = -c*(x:S) := by
  change b*((-c)*inverseIdealGenerator I b hb hI x) = _
  rw [show b*((-c)*inverseIdealGenerator I b hb hI x) =
    (-c)*(inverseIdealGenerator I b hb hI x*b) by ring, inverseIdealGenerator_mul]

theorem cofactorHom_generator (I : Ideal S) (b c : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) (hbi : b ∈ I) :
    cofactorHom I b c hb hI ⟨b,hbi⟩ = -c := by
  apply hb
  change b*cofactorHom I b c hb hI ⟨b,hbi⟩ = b*(-c)
  rw [cofactorHom_mul]
  exact mul_comm _ _

theorem cofactorHom_other_generator (I : Ideal S) (a b c d : S)
    (hb : IsSMulRegular S b) (hI : I = Ideal.span ({b} : Set S)) (hai : a ∈ I)
    (hrel : a*c+b*d=0) : cofactorHom I b c hb hI ⟨a,hai⟩ = d := by
  apply hb
  change b*cofactorHom I b c hb hI ⟨a,hai⟩ = b*d
  rw [cofactorHom_mul]
  linear_combination -hrel

end PrincipalIdeal

section MappedIdeal

variable {S : Type*} [CommRing S]

theorem mapped_curveIdeal_principal_first (r θ : ℂ) (φ : P →+* S)
    (hF : φ (actualSeedEquation r θ)=0) (hh : φ (thetaH θ)=0)
    (u : Sˣ) (hu : (u:S)=φ (originalG1 r)) :
    (ambientCurveIdeal r θ).map φ = Ideal.span ({φ originalF2} : Set S) := by
  have hrel : φ (originalF1 r)*(u:S)+φ originalF2*φ originalG2=0 := by
    simpa only [actualSeedEquation,map_add,map_mul,hh,zero_mul,add_zero,←hu] using hF
  have hfirst : φ (originalF1 r)=(-φ originalG2*(↑(u⁻¹):S))*φ originalF2 := by
    linear_combination (↑(u⁻¹):S)*hrel - φ (originalF1 r)*u.inv_mul
  refine le_antisymm ?_ ?_
  · apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    change φ (curveEquations r θ i) ∈ Ideal.span ({φ originalF2} : Set S)
    fin_cases i
    · exact Ideal.mem_span_singleton'.mpr ⟨-φ originalG2*(↑(u⁻¹):S),hfirst.symm⟩
    · exact Ideal.subset_span (by simp [curveEquations])
    · change φ (thetaH θ) ∈ _
      rw [hh]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro x rfl
    exact Ideal.mem_map_of_mem φ (curveEquation_mem r θ 1)

theorem mapped_curveIdeal_principal_second (r θ : ℂ) (φ : P →+* S)
    (hF : φ (actualSeedEquation r θ)=0) (hh : φ (thetaH θ)=0)
    (u : Sˣ) (hu : (u:S)=φ originalG2) :
    (ambientCurveIdeal r θ).map φ = Ideal.span ({φ (originalF1 r)} : Set S) := by
  have hrel : φ (originalF1 r)*φ (originalG1 r)+φ originalF2*(u:S)=0 := by
    simpa only [actualSeedEquation,map_add,map_mul,hh,zero_mul,add_zero,←hu] using hF
  have hsecond : φ originalF2=(-φ (originalG1 r)*(↑(u⁻¹):S))*φ (originalF1 r) := by
    linear_combination (↑(u⁻¹):S)*hrel - φ originalF2*u.inv_mul
  refine le_antisymm ?_ ?_
  · apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    change φ (curveEquations r θ i) ∈ Ideal.span ({φ (originalF1 r)} : Set S)
    fin_cases i
    · exact Ideal.subset_span (by simp [curveEquations])
    · exact Ideal.mem_span_singleton'.mpr
        ⟨-φ (originalG1 r)*(↑(u⁻¹):S),hsecond.symm⟩
    · change φ (thetaH θ) ∈ _
      rw [hh]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro x rfl
    exact Ideal.mem_map_of_mem φ (curveEquation_mem r θ 0)

end MappedIdeal

def firstCofactorUnit (r θ : ℂ) : (FirstSurfaceOpen r θ)ˣ :=
  (IsLocalization.Away.algebraMap_isUnit (S := FirstSurfaceOpen r θ)
    (surfaceQuotient r θ (originalG1 r))).unit

def secondCofactorUnit (r θ : ℂ) : (SecondSurfaceOpen r θ)ˣ :=
  (IsLocalization.Away.algebraMap_isUnit (S := SecondSurfaceOpen r θ)
    (surfaceQuotient r θ originalG2)).unit

@[simp] theorem firstCofactorUnit_value (r θ : ℂ) :
    (firstCofactorUnit r θ : FirstSurfaceOpen r θ)=firstPolyMap r θ (originalG1 r) :=
  IsUnit.unit_spec _

@[simp] theorem secondCofactorUnit_value (r θ : ℂ) :
    (secondCofactorUnit r θ : SecondSurfaceOpen r θ)=secondPolyMap r θ originalG2 :=
  IsUnit.unit_spec _

def firstCurveIdeal (r θ : ℂ) : Ideal (FirstSurfaceOpen r θ) :=
  (curveIdealOnSurface r θ).map (algebraMap (SurfaceRing r θ) (FirstSurfaceOpen r θ))

def secondCurveIdeal (r θ : ℂ) : Ideal (SecondSurfaceOpen r θ) :=
  (curveIdealOnSurface r θ).map (algebraMap (SurfaceRing r θ) (SecondSurfaceOpen r θ))

theorem firstCurveIdeal_eq_map (r θ : ℂ) :
    firstCurveIdeal r θ=(ambientCurveIdeal r θ).map (firstPolyMap r θ) := by
  rw [firstCurveIdeal,curveIdealOnSurface,CycleQ2GeometricRelativeConormal.relativeIdeal,
    Ideal.map_map]
  rfl

theorem secondCurveIdeal_eq_map (r θ : ℂ) :
    secondCurveIdeal r θ=(ambientCurveIdeal r θ).map (secondPolyMap r θ) := by
  rw [secondCurveIdeal,curveIdealOnSurface,CycleQ2GeometricRelativeConormal.relativeIdeal,
    Ideal.map_map]
  rfl

theorem firstCurveIdeal_principal (r θ : ℂ) :
    firstCurveIdeal r θ=Ideal.span ({firstPolyMap r θ originalF2} : Set (FirstSurfaceOpen r θ)) := by
  rw [firstCurveIdeal_eq_map]
  exact mapped_curveIdeal_principal_first r θ (firstPolyMap r θ)
    (by simp [firstPolyMap]) (by simp [firstPolyMap])
    (firstCofactorUnit r θ) (firstCofactorUnit_value r θ)

theorem secondCurveIdeal_principal (r θ : ℂ) :
    secondCurveIdeal r θ=Ideal.span
      ({secondPolyMap r θ (originalF1 r)} : Set (SecondSurfaceOpen r θ)) := by
  rw [secondCurveIdeal_eq_map]
  exact mapped_curveIdeal_principal_second r θ (secondPolyMap r θ)
    (by simp [secondPolyMap]) (by simp [secondPolyMap])
    (secondCofactorUnit r θ) (secondCofactorUnit_value r θ)

/-- The actual inverse-ideal generator on the first surface open. -/
def firstInverseIdealHom (r θ : ℂ) : firstCurveIdeal r θ →ₗ[FirstSurfaceOpen r θ] FirstSurfaceOpen r θ :=
  cofactorHom (firstCurveIdeal r θ) (firstPolyMap r θ originalF2)
    (firstPolyMap r θ (originalG1 r)) (first_generator_regular r θ) (firstCurveIdeal_principal r θ)

/-- The corresponding cofactor generator on the second surface open. -/
def secondInverseIdealHom (r θ : ℂ) :
    secondCurveIdeal r θ →ₗ[SecondSurfaceOpen r θ] SecondSurfaceOpen r θ :=
  -cofactorHom (secondCurveIdeal r θ) (secondPolyMap r θ (originalF1 r))
    (secondPolyMap r θ originalG2) (second_generator_regular r θ) (secondCurveIdeal_principal r θ)


section InverseIdealReduction

variable {R U V : Type*} [CommRing R] [CommRing U] [CommRing V]
  [Algebra R U] [Algebra R V]

/-- Restrict an actual inverse-ideal functional to the original ideal, then
reduce its values along the actual map to the closed subscheme. -/
def inverseIdealOnOriginal (I : Ideal R) (ρ : U →ₐ[R] V)
    (ν : I.map (algebraMap R U) →ₗ[U] U) : I →ₗ[R] V :=
  ρ.toLinearMap.comp ((ν.restrictScalars R).comp (Algebra.idealMap U I))

theorem inverseIdealOnOriginal_mul (I : Ideal R) (ρ : U →ₐ[R] V)
    (hI : ∀ x ∈ I, algebraMap R V x = 0)
    (ν : I.map (algebraMap R U) →ₗ[U] U) (x y : I) :
    inverseIdealOnOriginal I ρ ν (x*y) = 0 := by
  change ρ (ν (Algebra.idealMap U I (x*y))) = 0
  rw [Algebra.idealMap_mul]
  have hmul : Algebra.idealMap U I x * Algebra.idealMap U I y =
      algebraMap R U (x:R) • Algebra.idealMap U I y := by
    apply Subtype.ext
    rfl
  rw [hmul, map_smul]
  change ρ (algebraMap R U (x:R) * ν (Algebra.idealMap U I y)) = 0
  rw [map_mul, ρ.commutes, hI _ x.property, zero_mul]

/-- The reduction of an actual inverse-ideal section is the canonical normal
functional on the actual conormal module. Products vanish because the
coefficient map kills the ideal, rather than by an assumed normal comparison. -/
def inverseIdealReduction (I : Ideal R) (ρ : U →ₐ[R] V)
    (hI : ∀ x ∈ I, algebraMap R V x = 0)
    (ν : I.map (algebraMap R U) →ₗ[U] U) :
    V ⊗[R] I.Cotangent →ₗ[V] V :=
  (Ideal.Cotangent.lift (inverseIdealOnOriginal I ρ ν)
    (inverseIdealOnOriginal_mul I ρ hI ν)).liftBaseChange V

@[simp] theorem inverseIdealReduction_equation (I : Ideal R) (ρ : U →ₐ[R] V)
    (hI : ∀ x ∈ I, algebraMap R V x = 0)
    (ν : I.map (algebraMap R U) →ₗ[U] U) (x : I) :
    inverseIdealReduction I ρ hI ν ((1:V) ⊗ₜ[R] I.toCotangent x) =
      ρ (ν (Algebra.idealMap U I x)) := by
  simp only [inverseIdealReduction, LinearMap.liftBaseChange_tmul, one_smul,
    Ideal.Cotangent.lift_toCotangent]
  rfl

end InverseIdealReduction

/-- The four actual surface functions used for the Cartier boundary family.
The first two invert the cofactors; the last two lie in the curve ideal. -/
def coverElement (r θ : ℂ) : Fin 4 → SurfaceRing r θ :=
  ![surfaceQuotient r θ (originalG1 r), surfaceQuotient r θ originalG2,
    surfaceQuotient r θ (originalF1 r), surfaceQuotient r θ originalF2]

def coverProduct (r θ : ℂ) (s : Finset (Fin 4)) : SurfaceRing r θ :=
  ∏ i ∈ s, coverElement r θ i

abbrev CoverLocal (r θ : ℂ) (s : Finset (Fin 4)) :=
  Localization.Away (coverProduct r θ s)

def coverUnit (r θ : ℂ) (s : Finset (Fin 4)) (i : Fin 4) (hi : i ∈ s) :
    (CoverLocal r θ s)ˣ :=
  (IsLocalization.Away.isUnit_of_dvd (S := CoverLocal r θ s) (coverProduct r θ s)
    (Finset.dvd_prod_of_mem (coverElement r θ) hi)).unit

@[simp] theorem coverUnit_value (r θ : ℂ) (s : Finset (Fin 4))
    (i : Fin 4) (hi : i ∈ s) :
    (coverUnit r θ s i hi : CoverLocal r θ s) =
      algebraMap (SurfaceRing r θ) (CoverLocal r θ s) (coverElement r θ i) :=
  IsUnit.unit_spec _

def coverRestriction (r θ : ℂ) {s t : Finset (Fin 4)} (hst : s ⊆ t) :
    CoverLocal r θ s →ₐ[SurfaceRing r θ] CoverLocal r θ t where
  __ := IsLocalization.Away.lift (S := CoverLocal r θ s) (coverProduct r θ s)
    (IsLocalization.Away.isUnit_of_dvd (S := CoverLocal r θ t) (coverProduct r θ t)
      (Finset.prod_dvd_prod_of_subset s t (coverElement r θ) hst))
  commutes' x := IsLocalization.Away.lift_eq _ _ x

@[simp] theorem coverRestriction_base (r θ : ℂ) {s t : Finset (Fin 4)}
    (hst : s ⊆ t) (x : SurfaceRing r θ) :
    coverRestriction r θ hst (algebraMap (SurfaceRing r θ) (CoverLocal r θ s) x) =
      algebraMap (SurfaceRing r θ) (CoverLocal r θ t) x :=
  (coverRestriction r θ hst).commutes x

theorem coverRestriction_unit (r θ : ℂ) {s t : Finset (Fin 4)}
    (hst : s ⊆ t) (i : Fin 4) (hi : i ∈ s) :
    Units.map (coverRestriction r θ hst).toMonoidHom (coverUnit r θ s i hi) =
      coverUnit r θ t i (hst hi) := by
  apply Units.ext
  change coverRestriction r θ hst (coverUnit r θ s i hi : CoverLocal r θ s) =
    (coverUnit r θ t i (hst hi) : CoverLocal r θ t)
  rw [coverUnit_value,coverUnit_value,coverRestriction_base]

@[simp] theorem coverRestriction_inverse (r θ : ℂ) {s t : Finset (Fin 4)}
    (hst : s ⊆ t) (i : Fin 4) (hi : i ∈ s) :
    coverRestriction r θ hst (↑((coverUnit r θ s i hi)⁻¹) : CoverLocal r θ s) =
      (↑((coverUnit r θ t i (hst hi))⁻¹) : CoverLocal r θ t) := by
  rw [← coverRestriction_unit r θ hst i hi]
  rfl

@[simp] theorem coverProduct_pair (r θ : ℂ) :
    coverProduct r θ {0,1} =
      surfaceQuotient r θ (originalG1 r)*surfaceQuotient r θ originalG2 := by
  simp [coverProduct, coverElement]

abbrev SurfaceOverlap (r θ : ℂ) := CoverLocal r θ {0,1}

def overlapPolyMap (r θ : ℂ) : P →+* SurfaceOverlap r θ :=
  (algebraMap (SurfaceRing r θ) (SurfaceOverlap r θ)).comp (surfaceQuotient r θ)

def overlapCurveIdeal (r θ : ℂ) : Ideal (SurfaceOverlap r θ) :=
  (curveIdealOnSurface r θ).map (algebraMap (SurfaceRing r θ) (SurfaceOverlap r θ))

theorem overlapCurveIdeal_eq_map (r θ : ℂ) :
    overlapCurveIdeal r θ = (ambientCurveIdeal r θ).map (overlapPolyMap r θ) := by
  rw [overlapCurveIdeal,curveIdealOnSurface,CycleQ2GeometricRelativeConormal.relativeIdeal,
    Ideal.map_map]
  rfl

def overlapEquation (r θ : ℂ) (i : Fin 3) : overlapCurveIdeal r θ :=
  ⟨overlapPolyMap r θ (curveEquations r θ i), by
    rw [overlapCurveIdeal_eq_map]
    exact Ideal.mem_map_of_mem _ (curveEquation_mem r θ i)⟩

theorem overlap_generator_regular (r θ : ℂ) :
    IsSMulRegular (SurfaceOverlap r θ) (overlapPolyMap r θ originalF2) := by
  apply regular_after_localizing (surfaceQuotient r θ originalF2) (coverProduct r θ {0,1})
  intro x hx
  rw [coverProduct_pair, mul_right_comm, first_generator_torsion r θ x hx, zero_mul]

theorem overlapCurveIdeal_principal (r θ : ℂ) :
    overlapCurveIdeal r θ =
      Ideal.span ({overlapPolyMap r θ originalF2} : Set (SurfaceOverlap r θ)) := by
  rw [overlapCurveIdeal_eq_map]
  exact mapped_curveIdeal_principal_first r θ (overlapPolyMap r θ)
    (by simp [overlapPolyMap]) (by simp [overlapPolyMap])
    (coverUnit r θ {0,1} 0 (by simp)) (by simp [coverElement,overlapPolyMap])

def overlapInverseIdealHom (r θ : ℂ) :
    overlapCurveIdeal r θ →ₗ[SurfaceOverlap r θ] SurfaceOverlap r θ :=
  cofactorHom (overlapCurveIdeal r θ) (overlapPolyMap r θ originalF2)
    (overlapPolyMap r θ (originalG1 r))
    (overlap_generator_regular r θ) (overlapCurveIdeal_principal r θ)

theorem overlap_relation (r θ : ℂ) :
    overlapPolyMap r θ (originalF1 r)*overlapPolyMap r θ (originalG1 r)+
      overlapPolyMap r θ originalF2*overlapPolyMap r θ originalG2=0 := by
  have hF : overlapPolyMap r θ (actualSeedEquation r θ)=0 := by simp [overlapPolyMap]
  have hh : overlapPolyMap r θ (thetaH θ)=0 := by simp [overlapPolyMap]
  simpa only [actualSeedEquation,map_add,map_mul,hh,zero_mul,add_zero] using hF

theorem overlapInverseIdealHom_equation (r θ : ℂ) (i : Fin 3) :
    overlapInverseIdealHom r θ (overlapEquation r θ i) =
      kernelVector (overlapPolyMap r θ (originalG1 r)) (overlapPolyMap r θ originalG2) i := by
  fin_cases i
  · exact cofactorHom_other_generator (overlapCurveIdeal r θ)
      (overlapPolyMap r θ (originalF1 r)) (overlapPolyMap r θ originalF2)
      (overlapPolyMap r θ (originalG1 r)) (overlapPolyMap r θ originalG2)
      (overlap_generator_regular r θ) (overlapCurveIdeal_principal r θ)
      (overlapEquation r θ 0).property (overlap_relation r θ)
  · exact cofactorHom_generator (overlapCurveIdeal r θ)
      (overlapPolyMap r θ originalF2) (overlapPolyMap r θ (originalG1 r))
      (overlap_generator_regular r θ) (overlapCurveIdeal_principal r θ)
      (overlapEquation r θ 1).property
  · change overlapInverseIdealHom r θ (overlapEquation r θ 2)=0
    have he : overlapEquation r θ 2 = 0 := by
      apply Subtype.ext
      change overlapPolyMap r θ (thetaH θ)=0
      simp [overlapPolyMap]
    rw [he,map_zero]

def surfaceNormalCoefficient (r θ : ℂ) (A L : P) : SurfaceOverlap r θ :=
  (overlapPolyMap r θ (thetaK θ)*overlapPolyMap r θ L-overlapPolyMap r θ A) *
    (↑((coverUnit r θ {0,1} 0 (by simp))⁻¹) : SurfaceOverlap r θ) *
    (↑((coverUnit r θ {0,1} 1 (by simp))⁻¹) : SurfaceOverlap r θ)

/-- The genuine inverse-ideal section lifting the fixed normal connecting cochain. -/
def inverseIdealConnectingLift (r θ : ℂ) (A L : P) :
    overlapCurveIdeal r θ →ₗ[SurfaceOverlap r θ] SurfaceOverlap r θ :=
  surfaceNormalCoefficient r θ A L • overlapInverseIdealHom r θ

theorem inverseIdealConnectingLift_equation (r θ : ℂ) (A L : P) (i : Fin 3) :
    inverseIdealConnectingLift r θ A L (overlapEquation r θ i) =
      surfaceNormalCoefficient r θ A L *
        kernelVector (overlapPolyMap r θ (originalG1 r)) (overlapPolyMap r θ originalG2) i := by
  simp only [inverseIdealConnectingLift,LinearMap.smul_apply,
    overlapInverseIdealHom_equation,smul_eq_mul]

def overlapToCurve (r θ : ℂ) :
    SurfaceOverlap r θ →ₐ[SurfaceRing r θ] Overlap r θ where
  __ := IsLocalization.Away.lift (S := SurfaceOverlap r θ)
    (g := algebraMap (SurfaceRing r θ) (Overlap r θ)) (coverProduct r θ {0,1}) (by
    rw [coverProduct_pair,map_mul]
    change IsUnit (algebraMap P (Overlap r θ) (originalG1 r) *
      algebraMap P (Overlap r θ) originalG2)
    rw [←CycleQ2ActualNormalCech.firstOverlapUnit_value,
      ←CycleQ2ActualNormalCech.secondOverlapUnit_value]
    exact (firstOverlapUnit r θ).isUnit.mul (secondOverlapUnit r θ).isUnit)
  commutes' x := IsLocalization.Away.lift_eq _ _ x

@[simp] theorem overlapToCurve_polynomial (r θ : ℂ) (p : P) :
    overlapToCurve r θ (overlapPolyMap r θ p) = overlapAmbient r θ p := by
  change overlapToCurve r θ
    (algebraMap (SurfaceRing r θ) (SurfaceOverlap r θ) (surfaceQuotient r θ p)) = _
  rw [(overlapToCurve r θ).commutes]
  rfl

theorem overlapToCurve_firstUnit (r θ : ℂ) :
    Units.map (overlapToCurve r θ).toMonoidHom (coverUnit r θ {0,1} 0 (by simp)) =
      firstOverlapUnit r θ := by
  apply Units.ext
  change overlapToCurve r θ (coverUnit r θ {0,1} 0 (by simp) : SurfaceOverlap r θ) = _
  rw [coverUnit_value,(overlapToCurve r θ).commutes]
  exact (CycleQ2ActualNormalCech.firstOverlapUnit_value r θ).symm

theorem overlapToCurve_secondUnit (r θ : ℂ) :
    Units.map (overlapToCurve r θ).toMonoidHom (coverUnit r θ {0,1} 1 (by simp)) =
      secondOverlapUnit r θ := by
  apply Units.ext
  change overlapToCurve r θ (coverUnit r θ {0,1} 1 (by simp) : SurfaceOverlap r θ) = _
  rw [coverUnit_value,(overlapToCurve r θ).commutes]
  exact (CycleQ2ActualNormalCech.secondOverlapUnit_value r θ).symm

theorem overlapToCurve_normalCoefficient (r θ : ℂ) (A L : P) :
    overlapToCurve r θ (surfaceNormalCoefficient r θ A L)=normalOverlapCoefficient r θ A L := by
  unfold surfaceNormalCoefficient normalOverlapCoefficient overlapCoefficient
  simp only [map_mul,map_sub,overlapToCurve_polynomial]
  rw [←overlapToCurve_firstUnit r θ,←overlapToCurve_secondUnit r θ]
  rfl

theorem surfaceCurveIdeal_annihilates (r θ : ℂ) :
    ∀ x ∈ curveIdealOnSurface r θ, algebraMap (SurfaceRing r θ) (Overlap r θ) x=0 := by
  have h : curveIdealOnSurface r θ ≤
      RingHom.ker (algebraMap (SurfaceRing r θ) (Overlap r θ)) := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro p hp
    exact CycleQ2ActualNormalCech.overlap_annihilates r θ p hp
  exact fun x hx => h hx

def reducedInverseIdealConnectingLift (r θ : ℂ) (A L : P) :
    RelativeNormal r θ (Overlap r θ) :=
  inverseIdealReduction (curveIdealOnSurface r θ) (overlapToCurve r θ)
    (surfaceCurveIdeal_annihilates r θ) (inverseIdealConnectingLift r θ A L)

theorem reducedInverseIdealConnectingLift_equation (r θ : ℂ) (A L : P) (i : Fin 3) :
    reducedInverseIdealConnectingLift r θ A L (relativeEquationClass r θ (Overlap r θ) i) =
      normalOverlapCoefficient r θ A L *
        kernelVector (overlapAmbient r θ (originalG1 r)) (overlapAmbient r θ originalG2) i := by
  have he : reducedInverseIdealConnectingLift r θ A L
      (relativeEquationClass r θ (Overlap r θ) i) =
      overlapToCurve r θ (inverseIdealConnectingLift r θ A L (overlapEquation r θ i)) :=
    inverseIdealReduction_equation (R := SurfaceRing r θ) (U := SurfaceOverlap r θ)
      (V := Overlap r θ) (curveIdealOnSurface r θ) (overlapToCurve r θ)
      (surfaceCurveIdeal_annihilates r θ) (inverseIdealConnectingLift r θ A L)
      ⟨surfaceQuotient r θ (curveEquations r θ i),
        Ideal.mem_map_of_mem _ (curveEquation_mem r θ i)⟩
  rw [he]
  rw [inverseIdealConnectingLift_equation,map_mul,overlapToCurve_normalCoefficient]
  congr 1
  fin_cases i <;> simp [kernelVector,overlapToCurve_polynomial]

/-- The actual inverse-ideal lift reduces to the already fixed normal
connecting representative, with its original sign and every literal equation value. -/
theorem reducedInverseIdealConnectingLift_eq (r θ : ℂ) (A L : P) :
    reducedInverseIdealConnectingLift r θ A L =
      CycleQ2GeometricRelativeNormalConnecting.relativeConnectingRepresentative r θ A L := by
  apply (overlapNormalModuleEquiv r θ).injective
  apply Subtype.ext
  apply CycleQ2GenuineNormalConnecting.curveNormal_ext r θ
  intro i
  have h₁ := normalModuleEquiv_symm_equation r θ (Overlap r θ)
    (overlapNormalModuleEquiv r θ (reducedInverseIdealConnectingLift r θ A L)) i
  have h₂ := normalModuleEquiv_symm_equation r θ (Overlap r θ)
    (overlapNormalModuleEquiv r θ
      (CycleQ2GeometricRelativeNormalConnecting.relativeConnectingRepresentative r θ A L)) i
  change (overlapNormalModuleEquiv r θ (reducedInverseIdealConnectingLift r θ A L)).val
    ((1:Overlap r θ) ⊗ₜ[P] conormalGenerator r θ i) =
    (overlapNormalModuleEquiv r θ
      (CycleQ2GeometricRelativeNormalConnecting.relativeConnectingRepresentative r θ A L)).val
      ((1:Overlap r θ) ⊗ₜ[P] conormalGenerator r θ i)
  rw [←h₁,←h₂]
  change (overlapNormalModuleEquiv r θ).symm
      (overlapNormalModuleEquiv r θ (reducedInverseIdealConnectingLift r θ A L))
      (relativeEquationClass r θ (Overlap r θ) i) =
    (overlapNormalModuleEquiv r θ).symm
      (overlapNormalModuleEquiv r θ
        (CycleQ2GeometricRelativeNormalConnecting.relativeConnectingRepresentative r θ A L))
      (relativeEquationClass r θ (Overlap r θ) i)
  simp only [LinearEquiv.symm_apply_apply,reducedInverseIdealConnectingLift_equation,
    CycleQ2GeometricRelativeNormalConnecting.relativeConnectingRepresentative_equation]

section InvertibleEquation

variable {R S : Type*} [CommRing R] [CommRing S]

/-- On a locus where an ideal element is invertible, an actual inverse-ideal
functional is multiplication by its value divided by that element. -/
theorem inverseIdealHom_scalar (I : Ideal R) (ν : I →ₗ[R] R) (φ : R →+* S)
    (a : I) (u : Sˣ) (hu : (u:S)=φ (a:R)) (x : I) :
    φ (ν x) = (φ (ν a) * (↑(u⁻¹):S)) * φ (x:R) := by
  have hprod : (a:R) • x = (x:R) • a := by
    apply Subtype.ext
    exact mul_comm _ _
  have hv := congrArg ν hprod
  rw [map_smul,map_smul] at hv
  change (a:R)*ν x=(x:R)*ν a at hv
  have hφ := congrArg φ hv
  simp only [map_mul,←hu] at hφ
  calc
    φ (ν x) = (↑(u⁻¹):S) * ((u:S)*φ (ν x)) := (u.inv_mul_cancel_left _).symm
    _ = (↑(u⁻¹):S) * (φ (x:R)*φ (ν a)) := by rw [hφ]
    _ = (φ (ν a) * (↑(u⁻¹):S)) * φ (x:R) := by ring

end InvertibleEquation

theorem coverRestriction_comp (r θ : ℂ) {s t u : Finset (Fin 4)}
    (hst : s ⊆ t) (htu : t ⊆ u) :
    (coverRestriction r θ htu).comp (coverRestriction r θ hst) =
      coverRestriction r θ (Finset.Subset.trans hst htu) := by
  apply AlgHom.coe_ringHom_injective
  apply IsLocalization.ringHom_ext (Submonoid.powers (coverProduct r θ s))
  apply RingHom.ext
  intro x
  simp only [RingHom.comp_apply,AlgHom.comp_toRingHom,AlgHom.coe_toRingHom,
    AlgHom.comp_apply,coverRestriction_base]

theorem coverRestriction_comp_apply (r θ : ℂ) {s t u : Finset (Fin 4)}
    (hst : s ⊆ t) (htu : t ⊆ u) (x : CoverLocal r θ s) :
    coverRestriction r θ htu (coverRestriction r θ hst x) =
      coverRestriction r θ (Finset.Subset.trans hst htu) x :=
  DFunLike.congr_fun (coverRestriction_comp r θ hst htu) x

def coverPolyMap (r θ : ℂ) (s : Finset (Fin 4)) : P →+* CoverLocal r θ s :=
  (algebraMap (SurfaceRing r θ) (CoverLocal r θ s)).comp (surfaceQuotient r θ)

@[simp] theorem coverRestriction_polynomial (r θ : ℂ) {s t : Finset (Fin 4)}
    (hst : s ⊆ t) (p : P) :
    coverRestriction r θ hst (coverPolyMap r θ s p) = coverPolyMap r θ t p :=
  coverRestriction_base r θ hst (surfaceQuotient r θ p)

def boundary012 (r θ : ℂ) (A L : P) : CoverLocal r θ {0,1,2} :=
  coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)
      (inverseIdealConnectingLift r θ A L (overlapEquation r θ 0)) *
    (↑((coverUnit r θ {0,1,2} 2 (by simp))⁻¹) : CoverLocal r θ {0,1,2})

def boundary013 (r θ : ℂ) (A L : P) : CoverLocal r θ {0,1,3} :=
  coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)
      (inverseIdealConnectingLift r θ A L (overlapEquation r θ 1)) *
    (↑((coverUnit r θ {0,1,3} 3 (by simp))⁻¹) : CoverLocal r θ {0,1,3})

/-- The first scalar boundary entry is the actual restriction of the
inverse-ideal lift, expressed as a multiplication functional. -/
theorem boundary012_evaluation (r θ : ℂ) (A L : P) (x : overlapCurveIdeal r θ) :
    coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)
      (inverseIdealConnectingLift r θ A L x) =
      boundary012 r θ A L *
        coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)
          (x:SurfaceOverlap r θ) := by
  apply inverseIdealHom_scalar (overlapCurveIdeal r θ)
    (inverseIdealConnectingLift r θ A L)
    (coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)).toRingHom
    (overlapEquation r θ 0) (coverUnit r θ {0,1,2} 2 (by simp))
  change (coverUnit r θ {0,1,2} 2 (by simp) : CoverLocal r θ {0,1,2}) =
    coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)
      (overlapPolyMap r θ (originalF1 r))
  rw [coverUnit_value]
  exact ((coverRestriction r θ
    (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)).commutes _).symm

/-- The second scalar entry has the same provenance on the `f2` open. -/
theorem boundary013_evaluation (r θ : ℂ) (A L : P) (x : overlapCurveIdeal r θ) :
    coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)
      (inverseIdealConnectingLift r θ A L x) =
      boundary013 r θ A L *
        coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)
          (x:SurfaceOverlap r θ) := by
  apply inverseIdealHom_scalar (overlapCurveIdeal r θ)
    (inverseIdealConnectingLift r θ A L)
    (coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)).toRingHom
    (overlapEquation r θ 1) (coverUnit r θ {0,1,3} 3 (by simp))
  change (coverUnit r θ {0,1,3} 3 (by simp) : CoverLocal r θ {0,1,3}) =
    coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)
      (overlapPolyMap r θ originalF2)
  rw [coverUnit_value]
  exact ((coverRestriction r θ
    (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)).commutes _).symm

theorem boundary012_formula (r θ : ℂ) (A L : P) :
    boundary012 r θ A L =
      coverPolyMap r θ {0,1,2} (thetaK θ*L-A) *
        (↑((coverUnit r θ {0,1,2} 0 (by simp))⁻¹) : CoverLocal r θ {0,1,2}) *
        (↑((coverUnit r θ {0,1,2} 2 (by simp))⁻¹) : CoverLocal r θ {0,1,2}) := by
  unfold boundary012
  rw [inverseIdealConnectingLift_equation]
  change coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)
    (surfaceNormalCoefficient r θ A L*overlapPolyMap r θ originalG2) * _ = _
  unfold surfaceNormalCoefficient
  simp only [map_mul,map_sub,coverRestriction_inverse]
  have h₁ : coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,2} by simp)
      (overlapPolyMap r θ originalG2) =
      (coverUnit r θ {0,1,2} 1 (by simp) : CoverLocal r θ {0,1,2}) := by
    simp [overlapPolyMap,coverElement]
  rw [h₁,Units.inv_mul_cancel_right]
  simp only [coverPolyMap,overlapPolyMap,RingHom.comp_apply,coverRestriction_base,
    map_mul,map_sub]

theorem boundary013_formula (r θ : ℂ) (A L : P) :
    boundary013 r θ A L =
      -coverPolyMap r θ {0,1,3} (thetaK θ*L-A) *
        (↑((coverUnit r θ {0,1,3} 1 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) *
        (↑((coverUnit r θ {0,1,3} 3 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) := by
  unfold boundary013
  rw [inverseIdealConnectingLift_equation]
  change coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)
    (surfaceNormalCoefficient r θ A L*(-overlapPolyMap r θ (originalG1 r))) * _ = _
  unfold surfaceNormalCoefficient
  simp only [map_mul,map_sub,map_neg,coverRestriction_inverse]
  have h₀ : coverRestriction r θ (show ({0,1}:Finset (Fin 4)) ⊆ {0,1,3} by simp)
      (overlapPolyMap r θ (originalG1 r)) =
      (coverUnit r θ {0,1,3} 0 (by simp) : CoverLocal r θ {0,1,3}) := by
    simp [overlapPolyMap,coverElement]
  rw [h₀]
  have hcancel (B : CoverLocal r θ {0,1,3}) :
      B * (↑((coverUnit r θ {0,1,3} 0 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) *
          (↑((coverUnit r θ {0,1,3} 1 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) *
          -(coverUnit r θ {0,1,3} 0 (by simp) : CoverLocal r θ {0,1,3}) =
        -B * (↑((coverUnit r θ {0,1,3} 1 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) := by
    calc
      _ = -(B * (↑((coverUnit r θ {0,1,3} 1 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) *
          ((↑((coverUnit r θ {0,1,3} 0 (by simp))⁻¹) : CoverLocal r θ {0,1,3}) *
            (coverUnit r θ {0,1,3} 0 (by simp) : CoverLocal r θ {0,1,3}))) := by ring
      _ = _ := by rw [Units.inv_mul,mul_one]; ring
  rw [hcancel]
  simp only [coverPolyMap,overlapPolyMap,RingHom.comp_apply,coverRestriction_base,
    map_mul,map_sub]

/-- Four face values, with their coefficient types kept as explicit parameters. -/
structure FourFaces (T012 T013 T023 T123 : Type*) where
  face012 : T012
  face013 : T013
  face023 : T023
  face123 : T123

/-- The explicit alternating two-cochains on the four actual surface opens. -/
abbrev SurfaceCechTwo (r θ : ℂ) :=
  FourFaces (CoverLocal r θ {0,1,2}) (CoverLocal r θ {0,1,3})
    (CoverLocal r θ {0,2,3}) (CoverLocal r θ {1,2,3})

def cartierBoundaryTwoCochain (r θ : ℂ) (A L : P) : SurfaceCechTwo r θ :=
  ⟨boundary012 r θ A L,boundary013 r θ A L,0,0⟩

def surfaceCechTwoDifferential (r θ : ℂ) (c : SurfaceCechTwo r θ) :
    CoverLocal r θ Finset.univ :=
  coverRestriction r θ (Finset.subset_univ {1,2,3}) c.face123 -
    coverRestriction r θ (Finset.subset_univ {0,2,3}) c.face023 +
    coverRestriction r θ (Finset.subset_univ {0,1,3}) c.face013 -
    coverRestriction r θ (Finset.subset_univ {0,1,2}) c.face012

/-- The two scalar descriptions of the same inverse-ideal functional agree
on the quadruple overlap. This proves the cocycle identity without choosing
an unrelated representative in surface cohomology. -/
theorem boundary_overlap (r θ : ℂ) (A L : P) :
    coverRestriction r θ (Finset.subset_univ {0,1,3}) (boundary013 r θ A L) =
      coverRestriction r θ (Finset.subset_univ {0,1,2}) (boundary012 r θ A L) := by
  let φ := coverRestriction r θ (Finset.subset_univ ({0,1}:Finset (Fin 4)))
  have hscalar := inverseIdealHom_scalar (overlapCurveIdeal r θ)
    (inverseIdealConnectingLift r θ A L) φ.toRingHom (overlapEquation r θ 0)
    (coverUnit r θ Finset.univ 2 (by simp)) (by
      change (coverUnit r θ Finset.univ 2 (by simp) : CoverLocal r θ Finset.univ) =
        φ (overlapPolyMap r θ (originalF1 r))
      rw [coverUnit_value]
      exact (φ.commutes _).symm) (overlapEquation r θ 1)
  change φ (inverseIdealConnectingLift r θ A L (overlapEquation r θ 1)) =
    (φ (inverseIdealConnectingLift r θ A L (overlapEquation r θ 0)) *
      (↑((coverUnit r θ Finset.univ 2 (by simp))⁻¹) : CoverLocal r θ Finset.univ)) *
      φ (overlapEquation r θ 1 : SurfaceOverlap r θ) at hscalar
  have h₂ : φ (overlapEquation r θ 1 : SurfaceOverlap r θ) =
      (coverUnit r θ Finset.univ 3 (by simp) : CoverLocal r θ Finset.univ) := by
    rw [coverUnit_value]
    exact φ.commutes _
  unfold boundary012 boundary013
  simp only [map_mul,coverRestriction_inverse]
  rw [coverRestriction_comp_apply,coverRestriction_comp_apply]
  change φ (inverseIdealConnectingLift r θ A L (overlapEquation r θ 1)) *
    (↑((coverUnit r θ Finset.univ 3 (by simp))⁻¹) : CoverLocal r θ Finset.univ) =
      φ (inverseIdealConnectingLift r θ A L (overlapEquation r θ 0)) *
        (↑((coverUnit r θ Finset.univ 2 (by simp))⁻¹) : CoverLocal r θ Finset.univ)
  rw [hscalar,h₂,Units.mul_inv_cancel_right]

theorem cartierBoundaryTwoCochain_cocycle (r θ : ℂ) (A L : P) :
    surfaceCechTwoDifferential r θ (cartierBoundaryTwoCochain r θ A L) = 0 := by
  simp only [surfaceCechTwoDifferential,cartierBoundaryTwoCochain,map_zero,sub_self,
    zero_add,boundary_overlap]

/-- The ambient test with fixed cubic has the original negative sign on the
`012` face, at the same literal `(57,1)` incidence seed. -/
theorem literal_ambient_boundary012 :
    boundary012 57 1 derivativeA 0 =
      -coverPolyMap 57 1 {0,1,2} derivativeA *
        (↑((coverUnit 57 1 {0,1,2} 0 (by simp))⁻¹) : CoverLocal 57 1 {0,1,2}) *
        (↑((coverUnit 57 1 {0,1,2} 2 (by simp))⁻¹) : CoverLocal 57 1 {0,1,2}) := by
  rw [boundary012_formula]
  simp only [mul_zero,zero_sub,map_neg]

/-- The complementary face has the positive ambient-test numerator. -/
theorem literal_ambient_boundary013 :
    boundary013 57 1 derivativeA 0 =
      coverPolyMap 57 1 {0,1,3} derivativeA *
        (↑((coverUnit 57 1 {0,1,3} 1 (by simp))⁻¹) : CoverLocal 57 1 {0,1,3}) *
        (↑((coverUnit 57 1 {0,1,3} 3 (by simp))⁻¹) : CoverLocal 57 1 {0,1,3}) := by
  rw [boundary013_formula]
  simp only [mul_zero,zero_sub,map_neg,neg_neg]


private theorem weighted_mem_of_C_mul (Q : Ideal P) (c : ℂ) (hc : c ≠ 0) (p : P)
    (hp : C c*p ∈ Q) : p ∈ Q := by
  have hh := Q.mul_mem_left (C (c⁻¹)) hp
  simpa only [←mul_assoc,←map_mul,inv_mul_cancel₀ hc,map_one,one_mul] using hh

/-- If a prime of the actual surface contains both curve equations and
both cofactors, it contains every homogeneous coordinate. This is the
actual cover criterion, deduced from the literal equations. -/
theorem surface_coordinates_mem_of_four (r θ : ℂ) (hr : r ≠ 0)
    (Q : Ideal (SurfaceRing r θ)) [Q.IsPrime]
    (hg1 : surfaceQuotient r θ (originalG1 r) ∈ Q)
    (hg2 : surfaceQuotient r θ originalG2 ∈ Q)
    (hf1 : surfaceQuotient r θ (originalF1 r) ∈ Q)
    (hf2 : surfaceQuotient r θ originalF2 ∈ Q) :
    ∀ j : Fin 5, surfaceQuotient r θ (X j) ∈ Q := by
  let T : Ideal P := Q.comap (surfaceQuotient r θ)
  letI : T.IsPrime := Ideal.comap_isPrime _ _
  have ht1 : originalF1 r ∈ T := hf1
  have ht2 : originalF2 ∈ T := hf2
  have htg1 : originalG1 r ∈ T := hg1
  have htg2 : originalG2 ∈ T := hg2
  have hth : thetaH θ ∈ T := by
    change surfaceQuotient r θ (thetaH θ) ∈ Q
    rw [surfaceQuotient_h]
    exact Q.zero_mem
  have hshape1 : originalG1 r =
      originalF1 r*(X 0^2+C (2*r)*X 1*X 3)+C (3*r^2)*(X 1*X 3)^2 := by
    simp only [originalG1,originalF1,map_mul,map_pow,map_ofNat]
    ring
  have hA : (X (1:Fin 5)*X 3) ∈ T := by
    apply (inferInstance : T.IsPrime).mem_of_pow_mem 2
    apply weighted_mem_of_C_mul T (3*r^2)
      (mul_ne_zero (by norm_num) (pow_ne_zero 2 hr))
    have hh := T.sub_mem htg1 (T.mul_mem_right (X 0^2+C (2*r)*X 1*X 3) ht1)
    simpa only [hshape1,add_sub_cancel_left] using hh
  have hshape2 : originalG2 = originalF2*(X 4-2*X 2^2)+C 3*X 2^4 := by
    simp only [originalG2,originalF2,map_ofNat]
    ring
  have hB : (X (2:Fin 5)) ∈ T := by
    apply (inferInstance : T.IsPrime).mem_of_pow_mem 4
    apply weighted_mem_of_C_mul T 3 (by norm_num)
    have hh := T.sub_mem htg2 (T.mul_mem_right (X 4-2*X 2^2) ht2)
    simpa only [hshape2,add_sub_cancel_left] using hh
  let ι : CycleQ2SeedTrace.Poly →+* P :=
    (MvPolynomial.rename (Fin.castSucc : Fin 4 → Fin 5)).toRingHom
  let T₀ : Ideal CycleQ2SeedTrace.Poly := T.comap ι
  letI : T₀.IsPrime := Ideal.comap_isPrime _ _
  have hrenameF : ι (relation r 0) = originalF1 r := by
    simp [ι,relation,originalF1]
  have hrenameH : ι (CycleQ2SeedCechTheta.curveH θ) = thetaH θ := by
    simp [ι,CycleQ2SeedCechTheta.curveH,h,b,thetaH,originalH,originalB]
  have hcurve : CycleQ2SeedCechTheta.curveIdeal r θ ≤ T₀ := by
    apply Ideal.span_le.mpr
    intro p hp
    rcases hp with rfl | hp
    · change ι (relation r 0) ∈ T
      rw [hrenameF]
      exact ht1
    · rcases hp with rfl
      change ι (CycleQ2SeedCechTheta.curveH θ) ∈ T
      rw [hrenameH]
      exact hth
  have hc := CycleQ2SeedTwoOpenCover.coordinates_mem_of_A_B r θ T₀ hcurve
    (show CycleQ2SeedCech.curveA ∈ T₀ by
      change ι CycleQ2SeedCech.curveA ∈ T
      simpa [ι,CycleQ2SeedCech.curveA] using hA)
    (show CycleQ2SeedCech.curveB ∈ T₀ by
      change ι CycleQ2SeedCech.curveB ∈ T
      simpa [ι,CycleQ2SeedCech.curveB] using hB)
  have hw : (X (4:Fin 5)) ∈ T := by
    have hh := T.sub_mem ht2 (T.pow_mem_of_mem hB 2 (by decide))
    simpa only [originalF2,add_sub_cancel_right] using hh
  intro j
  change X j ∈ T
  fin_cases j
  · have hh := hc 0
    change ι (X 0) ∈ T at hh
    simpa [ι] using hh
  · have hh := hc 1
    change ι (X 1) ∈ T at hh
    simpa [ι] using hh
  · exact hB
  · have hh := hc 3
    change ι (X 3) ∈ T at hh
    simpa [ι] using hh
  · exact hw

/-- The four actual principal opens cover every relevant prime of the
surface cone; no covering or smoothness hypothesis is supplied. -/
theorem surface_relevant_prime_cover (r θ : ℂ) (hr : r ≠ 0)
    (Q : Ideal (SurfaceRing r θ)) [Q.IsPrime]
    (hx : ∃ j : Fin 5, surfaceQuotient r θ (X j) ∉ Q) :
    ∃ i : Fin 4, coverElement r θ i ∉ Q := by
  by_contra! hbad
  have hc := surface_coordinates_mem_of_four r θ hr Q (hbad 0) (hbad 1) (hbad 2) (hbad 3)
  obtain ⟨j,hj⟩ := hx
  exact hj (hc j)

/-- In particular the literal `(57,1)` four-open family covers the exact
punctured three-coordinate locus used by the surface Cech presentation. -/
theorem literal_surface_coordinate_prime_cover
    (Q : Ideal (SurfaceRing 57 1)) [Q.IsPrime]
    (hx : surfaceQuotient 57 1 (X 1) ∉ Q ∨
      surfaceQuotient 57 1 (X 2) ∉ Q ∨ surfaceQuotient 57 1 (X 3) ∉ Q) :
    ∃ i : Fin 4, coverElement 57 1 i ∉ Q := by
  apply surface_relevant_prime_cover 57 1 (by norm_num) Q
  rcases hx with h₁ | h₂ | h₃
  · exact ⟨1,h₁⟩
  · exact ⟨2,h₂⟩
  · exact ⟨3,h₃⟩

/-- The ideal generated by the four functions of the actual Cartier cover. -/
def fourCoverIdeal (r θ : ℂ) : Ideal (SurfaceRing r θ) :=
  Ideal.span (Set.range (coverElement r θ))

/-- The three-coordinate punctured locus used in the actual surface model. -/
def surfaceCoordinateIdeal (r θ : ℂ) : Ideal (SurfaceRing r θ) :=
  Ideal.span ({surfaceQuotient r θ (X 1),surfaceQuotient r θ (X 2),
    surfaceQuotient r θ (X 3)} : Set (SurfaceRing r θ))

theorem coordinate_mem_radical_fourCoverIdeal (r θ : ℂ) (hr : r ≠ 0) (j : Fin 5) :
    surfaceQuotient r θ (X j) ∈ (fourCoverIdeal r θ).radical := by
  rw [Ideal.radical_eq_sInf]
  apply Ideal.mem_sInf.mpr
  rintro Q ⟨hQ,hprime⟩
  letI : Q.IsPrime := hprime
  exact surface_coordinates_mem_of_four r θ hr Q
    (hQ (Ideal.subset_span ⟨0,rfl⟩)) (hQ (Ideal.subset_span ⟨1,rfl⟩))
    (hQ (Ideal.subset_span ⟨2,rfl⟩)) (hQ (Ideal.subset_span ⟨3,rfl⟩)) j

theorem coordinate_power_mem_fourCoverIdeal (r θ : ℂ) (hr : r ≠ 0) (j : Fin 5) :
    ∃ n : ℕ, surfaceQuotient r θ (X j)^n ∈ fourCoverIdeal r θ :=
  Ideal.mem_radical_iff.mp (coordinate_mem_radical_fourCoverIdeal r θ hr j)

/-- When theta is nonzero, the actual surface equations force all five
coordinates into any prime containing X₁,X₂,X₃. The theta hypothesis is
essential: the sparse theta-zero surface does not satisfy this conclusion. -/
theorem surface_coordinates_mem_of_three (r θ : ℂ) (hθ : θ ≠ 0)
    (Q : Ideal (SurfaceRing r θ)) [Q.IsPrime]
    (hx1 : surfaceQuotient r θ (X 1) ∈ Q)
    (hx2 : surfaceQuotient r θ (X 2) ∈ Q)
    (hx3 : surfaceQuotient r θ (X 3) ∈ Q) :
    ∀ j : Fin 5, surfaceQuotient r θ (X j) ∈ Q := by
  let T : Ideal P := Q.comap (surfaceQuotient r θ)
  letI : T.IsPrime := Ideal.comap_isPrime _ _
  have h1 : (X (1:Fin 5)) ∈ T := hx1
  have h2 : (X (2:Fin 5)) ∈ T := hx2
  have h3 : (X (3:Fin 5)) ∈ T := hx3
  have hbase : originalH ∈ T := by
    apply T.sub_mem
    · exact T.add_mem
        (T.add_mem
          (T.add_mem
            (T.add_mem (T.pow_mem_of_mem h3 3 (by decide))
              (T.pow_mem_of_mem h2 3 (by decide)))
            (T.mul_mem_left (X 1*X 2) h3))
          (T.mul_mem_left (X 0*X 2) h3))
        (T.mul_mem_left (X 0) (T.pow_mem_of_mem h1 2 (by decide)))
    · exact T.mul_mem_left (C Complex.I)
        (T.add_mem (T.pow_mem_of_mem h1 3 (by decide)) (T.pow_mem_of_mem h3 3 (by decide)))
  have hh : thetaH θ ∈ T := by
    change surfaceQuotient r θ (thetaH θ) ∈ Q
    rw [surfaceQuotient_h]
    exact Q.zero_mem
  have h0 : (X (0:Fin 5)) ∈ T := by
    apply (inferInstance : T.IsPrime).mem_of_pow_mem 3
    apply weighted_mem_of_C_mul T θ hθ
    have hdiff := T.sub_mem hh hbase
    simpa only [thetaH,add_sub_cancel_left] using hdiff
  have hf1 : originalF1 r ∈ T :=
    T.sub_mem (T.pow_mem_of_mem h0 2 (by decide)) (T.mul_mem_left (C r*X 1) h3)
  have hF : actualSeedEquation r θ ∈ T := by
    change surfaceQuotient r θ (actualSeedEquation r θ) ∈ Q
    rw [surfaceQuotient_F]
    exact Q.zero_mem
  have hprod : originalF2*originalG2 ∈ T := by
    have hdiff := T.sub_mem (T.sub_mem hF (T.mul_mem_right (thetaK θ) hh))
      (T.mul_mem_right (originalG1 r) hf1)
    simpa only [actualSeedEquation,add_sub_cancel_right,add_sub_cancel_left] using hdiff
  have hprod_eq : originalF2*originalG2=X 4^3+X 2^6 := by
    unfold originalF2 originalG2
    ring
  have h4 : (X (4:Fin 5)) ∈ T := by
    apply (inferInstance : T.IsPrime).mem_of_pow_mem 3
    have hdiff := T.sub_mem hprod (T.pow_mem_of_mem h2 6 (by decide))
    simpa only [hprod_eq,add_sub_cancel_right] using hdiff
  intro j
  change X j ∈ T
  fin_cases j
  · exact h0
  · exact h1
  · exact h2
  · exact h3
  · exact h4

private theorem coverElement_mem_of_coordinates (r θ : ℂ)
    (Q : Ideal (SurfaceRing r θ))
    (hx : ∀ j : Fin 5, surfaceQuotient r θ (X j) ∈ Q) (i : Fin 4) :
    coverElement r θ i ∈ Q := by
  let φ : P →+* ((SurfaceRing r θ) ⧸ Q) :=
    (Ideal.Quotient.mk Q).comp (surfaceQuotient r θ)
  have hX : ∀ j : Fin 5, φ (X j)=0 :=
    fun j => Ideal.Quotient.eq_zero_iff_mem.mpr (hx j)
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  fin_cases i
  · change φ (originalG1 r)=0
    simp only [originalG1,map_add,map_mul,map_pow,hX]
    ring
  · change φ originalG2=0
    simp only [originalG2,map_add,map_sub,map_mul,map_pow,hX]
    ring
  · change φ (originalF1 r)=0
    simp only [originalF1,map_sub,map_mul,map_pow,hX]
    ring
  · change φ originalF2=0
    simp only [originalF2,map_add,map_pow,hX]
    ring

theorem fourCoverIdeal_le_radical_surfaceCoordinateIdeal (r θ : ℂ) (hθ : θ ≠ 0) :
    fourCoverIdeal r θ ≤ (surfaceCoordinateIdeal r θ).radical := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i,rfl⟩
  rw [Ideal.radical_eq_sInf]
  apply Ideal.mem_sInf.mpr
  rintro Q ⟨hQ,hprime⟩
  letI : Q.IsPrime := hprime
  apply coverElement_mem_of_coordinates r θ Q
  exact surface_coordinates_mem_of_three r θ hθ Q
    (hQ (Ideal.subset_span (by simp [surfaceCoordinateIdeal])))
    (hQ (Ideal.subset_span (by simp [surfaceCoordinateIdeal])))
    (hQ (Ideal.subset_span (by simp [surfaceCoordinateIdeal])))

theorem coverElement_power_mem_surfaceCoordinateIdeal (r θ : ℂ) (hθ : θ ≠ 0)
    (i : Fin 4) : ∃ n : ℕ, coverElement r θ i ^ n ∈ surfaceCoordinateIdeal r θ :=
  Ideal.mem_radical_iff.mp
    (fourCoverIdeal_le_radical_surfaceCoordinateIdeal r θ hθ (Ideal.subset_span ⟨i,rfl⟩))

/-- The actual four-open and three-coordinate families have exactly the same
punctured locus at nonzero r and theta. The equality is proved from the
literal equations on the actual quotient surface. -/
theorem cover_radical_eq_coordinate_radical (r θ : ℂ) (hr : r ≠ 0) (hθ : θ ≠ 0) :
    (fourCoverIdeal r θ).radical = (surfaceCoordinateIdeal r θ).radical := by
  apply le_antisymm
  · exact Ideal.radical_le_radical_iff.mpr
      (fourCoverIdeal_le_radical_surfaceCoordinateIdeal r θ hθ)
  · apply Ideal.radical_le_radical_iff.mpr
    apply Ideal.span_le.mpr
    intro x hx
    rcases hx with rfl | hx
    · exact coordinate_mem_radical_fourCoverIdeal r θ hr 1
    · rcases hx with rfl | hx
      · exact coordinate_mem_radical_fourCoverIdeal r θ hr 2
      · rcases hx with rfl
        exact coordinate_mem_radical_fourCoverIdeal r θ hr 3

theorem literal_cover_radical_eq_coordinate_radical :
    (fourCoverIdeal 57 1).radical = (surfaceCoordinateIdeal 57 1).radical :=
  cover_radical_eq_coordinate_radical 57 1 (by norm_num) (by norm_num)

end CycleQ2GeometricCartierNormalLift

import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! Degreewise generators of a graded specialization kernel.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false

namespace CycleQ2LiteralAmbientProjFiberDegree

variable {R A B K : Type*} [CommRing R] [CommRing A] [CommRing B] [CommRing K]
variable [Algebra R A] [Algebra R K]

/-- If the kernel is generated by base scalars of degree zero, a homogeneous
element of its degree-`n` part has a finite expression using coefficients of
degree `n`. The grading may consist of additive subgroups, as for the native
homogeneous coordinate quotients. -/
theorem homogeneous_kernel_decomposition_of_degree_zero {σ : Type*}
    [SetLike σ A] [AddSubmonoidClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜]
    (hscalar : ∀ r : R, algebraMap R A r ∈ 𝒜 0)
    (φ : A →+* B) (hker : RingHom.ker φ = (RingHom.ker (algebraMap R K)).map (algebraMap R A))
    (n : ℕ) (a : A) (ha : a ∈ 𝒜 n) (hz : φ a = 0) :
    ∃ (m : ℕ) (r : Fin m → R) (t : Fin m → A),
      (∀ j, algebraMap R K (r j) = 0) ∧ (∀ j, t j ∈ 𝒜 n) ∧
      a = ∑ j, algebraMap R A (r j) * t j := by
  classical
  have hm : a ∈ (RingHom.ker (algebraMap R K)).map (algebraMap R A) :=
    hker ▸ (show a ∈ RingHom.ker φ from hz)
  obtain ⟨m, b, g, he⟩ := Submodule.mem_span_set'.mp hm
  choose r hr heq using fun j => (g j).property
  have eqn : a = ∑ j, algebraMap R A (r j) * b j := by
    rw [← he]
    exact Finset.sum_congr rfl fun j _ => by rw [heq j]; exact mul_comm _ _
  refine ⟨m, r, fun j => DirectSum.decompose 𝒜 (b j) n, hr, fun j => ?_, ?_⟩
  · exact (DirectSum.decompose 𝒜 (b j) n).property
  · calc
      a = GradedRing.proj 𝒜 n a := (DirectSum.decompose_of_mem_same 𝒜 ha).symm
      _ = ∑ j, GradedRing.proj 𝒜 n (algebraMap R A (r j) * b j) := by
        conv_lhs => rw [eqn, map_sum]
      _ = _ := Finset.sum_congr rfl fun j _ =>
        DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜 (hscalar (r j))

/-- An algebra grading by submodules already places base scalars in degree zero. -/
theorem homogeneous_kernel_decomposition (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    (φ : A →+* B) (hker : RingHom.ker φ = (RingHom.ker (algebraMap R K)).map (algebraMap R A))
    (n : ℕ) (a : A) (ha : a ∈ 𝒜 n) (hz : φ a = 0) :
    ∃ (m : ℕ) (r : Fin m → R) (t : Fin m → A),
      (∀ j, algebraMap R K (r j) = 0) ∧ (∀ j, t j ∈ 𝒜 n) ∧
      a = ∑ j, algebraMap R A (r j) * t j := by
  apply homogeneous_kernel_decomposition_of_degree_zero 𝒜 _ φ hker n a ha hz
  intro r
  simpa [Algebra.smul_def] using (𝒜 0).smul_mem r (SetLike.GradedOne.one_mem (A := 𝒜))

end CycleQ2LiteralAmbientProjFiberDegree

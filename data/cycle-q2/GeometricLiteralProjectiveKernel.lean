import Proposal.GeometricLiteralProjectiveDeformation

/-!
# Faithful epsilon kernels on the twelve actual projective charts

These are kernels of the native chart reductions of the original
projective deformation. Their generator is the original weight-zero
epsilon. Localization torsion is retained in both kernel and annihilator
calculations. The resulting coefficient equivalence uses the genuine
reduced multiplication action, with no flatness assumption supplied.

Prepared for fqlx with OpenAI ChatGPT assistance; see solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2LiteralProjectiveKernel

open HomogeneousLocalization CycleQ2CartierSurfaceGrading CycleQ2ProjectiveCartierIdeal
  CycleQ2GeometricSeedNormalIdeals CycleQ2LiteralGradedDeformation
  CycleQ2LiteralGradedReduction CycleQ2LiteralProjectiveDeformation

/-- The original epsilon is already homogeneous of degree zero. -/
def chartEpsilon (a : Fin 4) (l : Fin 3) : ChartRing a l :=
  fromZeroRingHom deformationGrade (Submonoid.powers (chartDenominator a l))
    ⟨epsilonElement, epsilonElement_mem_grade⟩

theorem chartEpsilon_val (a : Fin 4) (l : Fin 3) :
    (chartEpsilon a l).val =
      algebraMap GradedDeformation (Localization.Away (chartDenominator a l)) epsilonElement := rfl

theorem chartReduction_mk_eq_zero_iff (a : Fin 4) (l : Fin 3) (n : ℕ)
    (p : GradedDeformation) (hp : p ∈ deformationGrade (n • (coverDegree a + 1))) :
    chartReduction a l (Away.mk deformationGrade (chartDenominator_homogeneous a l) n p hp) = 0 ↔
      ∃ k : ℕ, reduction (chartDenominator a l ^ k * p) = 0 := by
  rw [chartReduction_mk, HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_zero,
    Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
  constructor
  · rintro ⟨⟨b,hb⟩,hz⟩
    obtain ⟨k,rfl⟩ := hb
    refine ⟨k, ?_⟩
    rw [map_mul, map_pow]
    change reductionGraded (chartDenominator a l) ^ k * reduction p = 0
    rw [reduction_chartDenominator]
    exact hz
  · rintro ⟨k,hk⟩
    refine ⟨⟨refinedDenominator 57 1 a l ^ k,
      Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩, ?_⟩
    rw [map_mul, map_pow] at hk
    change reductionGraded (chartDenominator a l) ^ k * reduction p = 0 at hk
    rwa [reduction_chartDenominator] at hk

theorem chartKernel_eq_comap (a : Fin 4) (l : Fin 3) :
    RingHom.ker (chartReduction a l) =
      ((RingHom.ker reduction.toRingHom).map
        (algebraMap GradedDeformation (Localization.Away (chartDenominator a l)))).comap
        (algebraMap (ChartRing a l) (Localization.Away (chartDenominator a l))) := by
  ext x
  obtain ⟨n,p,hp,rfl⟩ := Away.mk_surjective deformationGrade (chartDenominator_homogeneous a l) x
  change chartReduction a l (Away.mk deformationGrade (chartDenominator_homogeneous a l) n p hp) = 0 ↔ _
  rw [chartReduction_mk_eq_zero_iff]
  change (∃ k : ℕ, reduction (chartDenominator a l ^ k * p) = 0) ↔
    (Away.mk deformationGrade (chartDenominator_homogeneous a l) n p hp).val ∈
      (RingHom.ker reduction.toRingHom).map
        (algebraMap GradedDeformation (Localization.Away (chartDenominator a l)))
  rw [Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_mem_map_algebraMap_iff]
  constructor
  · rintro ⟨k,hk⟩
    exact ⟨chartDenominator a l ^ k, ⟨k,rfl⟩, hk⟩
  · rintro ⟨t,⟨k,rfl⟩,hk⟩
    exact ⟨k,hk⟩

/-- The actual native kernel is generated by the original epsilon. -/
theorem chartKernel_principal (a : Fin 4) (l : Fin 3) :
    RingHom.ker (chartReduction a l) = Ideal.span ({chartEpsilon a l} : Set (ChartRing a l)) := by
  rw [chartKernel_eq_comap, reduction_kernel_principal, Ideal.map_span, Set.image_singleton,
    ← chartEpsilon_val]
  exact CycleQ2GradedLocalizationProjection.principalIdeal_comap_val deformationGrade
    (chartDenominator_homogeneous a l) (chartEpsilon a l)

/-- No cancellation of chart denominators is assumed: the two sides use
exactly the same surviving localization torsion. -/
theorem chartEpsilon_mul_eq_zero_iff (a : Fin 4) (l : Fin 3) (x : ChartRing a l) :
    chartEpsilon a l * x = 0 ↔ chartReduction a l x = 0 := by
  obtain ⟨n,p,hp,rfl⟩ := Away.mk_surjective deformationGrade (chartDenominator_homogeneous a l) x
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.val_zero, chartEpsilon_val, Away.val_mk, Localization.mk_eq_mk',
    IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_zero_iff,
    chartReduction_mk_eq_zero_iff]
  constructor
  · rintro ⟨⟨b,hb⟩,hz⟩
    obtain ⟨k,rfl⟩ := hb
    refine ⟨k, (epsilon_mul_eq_zero_iff _).mp ?_⟩
    simpa only [mul_assoc, mul_comm, mul_left_comm] using hz
  · rintro ⟨k,hk⟩
    refine ⟨⟨chartDenominator a l ^ k,
      Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩, ?_⟩
    have hz := (epsilon_mul_eq_zero_iff _).mpr hk
    simpa only [mul_assoc, mul_comm, mul_left_comm] using hz

theorem chartReduction_epsilon (a : Fin 4) (l : Fin 3) :
    chartReduction a l (chartEpsilon a l) = 0 := by
  apply (chartEpsilon_mul_eq_zero_iff a l _).mp
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_zero, chartEpsilon_val,
    ← map_mul, epsilonElement_square, map_zero]

theorem chartKernel_mul_zero (a : Fin 4) (l : Fin 3) (x y : ChartRing a l)
    (hx : chartReduction a l x = 0) (hy : chartReduction a l y = 0) : x * y = 0 := by
  have hx' : x ∈ Ideal.span ({chartEpsilon a l} : Set (ChartRing a l)) := by
    rw [← chartKernel_principal]
    exact hx
  obtain ⟨z,rfl⟩ := Ideal.mem_span_singleton'.mp hx'
  rw [mul_assoc, (chartEpsilon_mul_eq_zero_iff a l y).mpr hy, mul_zero]

/-- A lift is used only to define the coefficient map. Its independence
is proved from the actual annihilator identity below. -/
def chartLift (a : Fin 4) (l : Fin 3) (x : RefinedRing 57 1 a l) : ChartRing a l :=
  (chartReduction_surjective a l x).choose

theorem chartLift_reduction (a : Fin 4) (l : Fin 3) (x : RefinedRing 57 1 a l) :
    chartReduction a l (chartLift a l x) = x := (chartReduction_surjective a l x).choose_spec

def epsilonCoefficient (a : Fin 4) (l : Fin 3) (x : RefinedRing 57 1 a l) : ChartRing a l :=
  chartEpsilon a l * chartLift a l x

theorem epsilonCoefficient_of_reduction (a : Fin 4) (l : Fin 3) (x : ChartRing a l) :
    epsilonCoefficient a l (chartReduction a l x) = chartEpsilon a l * x := by
  apply sub_eq_zero.mp
  rw [epsilonCoefficient, ← mul_sub, chartEpsilon_mul_eq_zero_iff,
    map_sub, chartLift_reduction, sub_self]

theorem reduction_epsilonCoefficient (a : Fin 4) (l : Fin 3) (x : RefinedRing 57 1 a l) :
    chartReduction a l (epsilonCoefficient a l x) = 0 := by
  rw [epsilonCoefficient, map_mul, chartReduction_epsilon, zero_mul]

local instance chartReductionAlgebra (a : Fin 4) (l : Fin 3) :
    Algebra (ChartRing a l) (RefinedRing 57 1 a l) := (chartReduction a l).toAlgebra

def epsilonLinear (a : Fin 4) (l : Fin 3) : RefinedRing 57 1 a l →ₗ[ChartRing a l] ChartRing a l where
  toFun := epsilonCoefficient a l
  map_add' x y := by
    obtain ⟨u,rfl⟩ := chartReduction_surjective a l x
    obtain ⟨v,rfl⟩ := chartReduction_surjective a l y
    rw [← map_add, epsilonCoefficient_of_reduction, epsilonCoefficient_of_reduction,
      epsilonCoefficient_of_reduction, mul_add]
  map_smul' z x := by
    obtain ⟨u,rfl⟩ := chartReduction_surjective a l x
    change epsilonCoefficient a l (chartReduction a l z * chartReduction a l u) =
      z * epsilonCoefficient a l (chartReduction a l u)
    rw [← map_mul, epsilonCoefficient_of_reduction, epsilonCoefficient_of_reduction]
    ring

theorem epsilonCoefficient_injective (a : Fin 4) (l : Fin 3) :
    Function.Injective (epsilonCoefficient a l) := by
  intro x y hxy
  apply sub_eq_zero.mp
  obtain ⟨u,hu⟩ := chartReduction_surjective a l (x - y)
  rw [← hu]
  apply (chartEpsilon_mul_eq_zero_iff a l u).mp
  rw [← epsilonCoefficient_of_reduction, hu]
  change epsilonLinear a l (x - y) = 0
  rw [map_sub]
  exact sub_eq_zero.mpr hxy

/-- The faithful coefficient module is the original reduced chart ring,
with exactly the scalar action induced by the original reduction. -/
def epsilonKernelEquiv (a : Fin 4) (l : Fin 3) :
    RefinedRing 57 1 a l ≃ₗ[ChartRing a l] RingHom.ker (chartReduction a l) :=
  LinearEquiv.ofBijective
    ((epsilonLinear a l).codRestrict _ (reduction_epsilonCoefficient a l)) (by
      constructor
      · intro x y hxy
        exact epsilonCoefficient_injective a l (congrArg Subtype.val hxy)
      · rintro ⟨z,hz⟩
        have hm : z ∈ Ideal.span ({chartEpsilon a l} : Set (ChartRing a l)) := by
          rw [← chartKernel_principal]
          exact hz
        obtain ⟨u,hu⟩ := Ideal.mem_span_singleton'.mp hm
        refine ⟨chartReduction a l u, Subtype.ext ?_⟩
        change epsilonCoefficient a l (chartReduction a l u) = z
        rw [epsilonCoefficient_of_reduction, mul_comm, hu])

end CycleQ2LiteralProjectiveKernel

end

#print axioms CycleQ2LiteralProjectiveKernel.chartKernel_principal
#print axioms CycleQ2LiteralProjectiveKernel.chartEpsilon_mul_eq_zero_iff
#print axioms CycleQ2LiteralProjectiveKernel.epsilonKernelEquiv

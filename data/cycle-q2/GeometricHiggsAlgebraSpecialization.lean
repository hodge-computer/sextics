set_option autoImplicit false

/-!
# Endomorphisms generated by an irreducible family

Schur's lemma and Jacobson density identify the full endomorphism algebra
of a finite-dimensional irreducible representation over an algebraically
closed field.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/


noncomputable section

namespace CycleQ2HiggsMatrixAlgebra

open Module

theorem adjoin_eq_top_of_irreducible {K E : Type*} [Field K] [IsAlgClosed K]
    [AddCommGroup E] [Module K E] [FiniteDimensional K E] [Nontrivial E]
    (S : Set (End K E))
    (h : ∀ W : Submodule K E, (∀ b ∈ S, ∀ x ∈ W, b x ∈ W) → W = ⊥ ∨ W = ⊤) :
    Algebra.adjoin K S = ⊤ := by
  classical
  let A := Algebra.adjoin K S
  let action : Module A E := Module.compHom E A.val.toRingHom
  let tower : IsScalarTower K A E :=
    IsScalarTower.of_algebraMap_smul fun c x => by
      change ((algebraMap K (End K E) c) : End K E) x = c • x
      rfl
  let simple : IsSimpleModule A E := (isSimpleModule_iff A E).mpr
    ⟨fun W => by
      let W₀ : Submodule K E := @Submodule.restrictScalars K A E _ _ _ _ action _ tower W
      rcases h W₀ (fun b hb x hx =>
        W.smul_mem (⟨b, Algebra.subset_adjoin hb⟩ : A) hx) with hw | hw
      · exact Or.inl (SetLike.ext fun x => SetLike.ext_iff.mp hw x)
      · exact Or.inr (SetLike.ext fun x => SetLike.ext_iff.mp hw x)⟩
  have hs := (@IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed A E K _ _ _ _ _ action tower simple _ _).2
  apply top_unique
  intro f _
  let f' : End (End A E) E :=
    { f with
      map_smul' := fun b x => by
        obtain ⟨c, rfl⟩ := hs b
        change f (c • x) = c • f x
        exact f.map_smul c x }
  let basis := Module.finBasis K E
  obtain ⟨a, ha⟩ := jacobson_density f' (Finset.univ.image basis)
  have he : f = a.val := basis.ext fun i =>
    ha _ (Finset.mem_image_of_mem basis (Finset.mem_univ i))
  exact he ▸ a.property

end CycleQ2HiggsMatrixAlgebra

#print axioms CycleQ2HiggsMatrixAlgebra.adjoin_eq_top_of_irreducible

/-!
# Full matrix generation persists under specialization

If matrices generate the full algebra at one evaluation, lift the matrix
units to the original generated algebra. The determinant of their
coordinate columns cuts out a principal open where generation persists.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/


noncomputable section
namespace CycleQ2HiggsAlgebraOpen

open Matrix

variable {R K L n ι : Type*} [CommRing R] [Field K] [Field L]
  [Fintype n] [DecidableEq n]
  (B : ι → Matrix n n R)

private theorem map_scalar (f : R →+* K) (r : R) :
    (algebraMap R (Matrix n n R) r).map f = algebraMap K (Matrix n n K) (f r) := by
  ext i j
  simp only [Matrix.map_apply, Matrix.algebraMap_matrix_apply]
  split <;> simp

private theorem lift_of_mem (f : R →+* K) (hf : Function.Surjective f)
    {M : Matrix n n K} (hM : M ∈ Algebra.adjoin K (Set.range fun b => (B b).map f)) :
    ∃ N ∈ Algebra.adjoin R (Set.range B), N.map f = M := by
  induction hM using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨B i, Algebra.subset_adjoin (Set.mem_range_self i), rfl⟩
  | algebraMap c =>
    obtain ⟨r, rfl⟩ := hf c
    exact ⟨algebraMap R _ r, Subalgebra.algebraMap_mem _ r, map_scalar f r⟩
  | add x y _ _ hx hy =>
    obtain ⟨P, hP, rfl⟩ := hx
    obtain ⟨Q, hQ, rfl⟩ := hy
    exact ⟨P + Q, add_mem hP hQ, (f.mapMatrix).map_add P Q⟩
  | mul x y _ _ hx hy =>
    obtain ⟨P, hP, rfl⟩ := hx
    obtain ⟨Q, hQ, rfl⟩ := hy
    exact ⟨P * Q, mul_mem hP hQ, Matrix.map_mul (f := f)⟩

private theorem map_mem (g : R →+* L) {N : Matrix n n R}
    (hN : N ∈ Algebra.adjoin R (Set.range B)) :
    N.map g ∈ Algebra.adjoin L (Set.range fun b => (B b).map g) := by
  induction hN using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact Algebra.subset_adjoin (Set.mem_range_self i)
  | algebraMap r =>
    rw [map_scalar]
    exact Subalgebra.algebraMap_mem _ _
  | add x y _ _ hx hy =>
    change g.mapMatrix (x + y) ∈ _
    rw [map_add]
    exact add_mem hx hy
  | mul x y _ _ hx hy => rw [Matrix.map_mul (f := g)]; exact mul_mem hx hy

theorem exists_generation_parameter (f : R →+* K) (hf : Function.Surjective f)
    (h : Algebra.adjoin K (Set.range fun b => (B b).map f) = ⊤) :
    ∃ p : R, f p = 1 ∧ ∀ (L : Type*) [Field L] (g : R →+* L), g p ≠ 0 →
      Algebra.adjoin L (Set.range fun b => (B b).map g) = ⊤ := by
  classical
  have hunit (k : n × n) : single k.1 k.2 (1 : K) ∈
      Algebra.adjoin K (Set.range fun b => (B b).map f) := by rw [h]; trivial
  choose N hN he using fun k => lift_of_mem B f hf (hunit k)
  let C : Matrix (n × n) (n × n) R := fun ij k => N k ij.1 ij.2
  refine ⟨C.det, ?_, ?_⟩
  · have hc : C.map f = 1 := by
      ext ⟨i,j⟩ ⟨u,v⟩
      change (N (u,v)).map f i j = _
      rw [he]
      simp [Matrix.single, Matrix.one_apply, Prod.mk.injEq, eq_comm]
    rw [RingHom.map_det]
    change (C.map f).det = 1
    rw [hc, Matrix.det_one]
  intro L _ g hp
  apply top_unique
  intro M _
  have hdet : (C.map g).det ≠ 0 := (g.map_det C) ▸ hp
  have hsurj := Matrix.mulVec_surjective_iff_isUnit.mpr
    ((Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hdet))
  obtain ⟨a, ha⟩ := hsurj (fun ij : n × n => M ij.1 ij.2)
  have hsum : M = ∑ k : n × n, a k • (N k).map g := by
    ext i j
    rw [Matrix.sum_apply]
    have h : (∑ k, g (N k i j) * a k) = M i j := congrFun ha (i,j)
    simpa only [Matrix.smul_apply, Matrix.map_apply, smul_eq_mul, mul_comm] using h.symm
  rw [hsum]
  exact Submodule.sum_mem (Algebra.adjoin L _).toSubmodule
    (fun k _ => Submodule.smul_mem _ _ (map_mem B g (hN k)))

end CycleQ2HiggsAlgebraOpen

#print axioms CycleQ2HiggsAlgebraOpen.exists_generation_parameter

/-!
# Stable pairs and normalized Higgs matrices

An invertible linear combination identifies the two spaces in a stable
pair of equal dimensions. The adjugate clears the denominator in the
resulting endomorphisms.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/


noncomputable section
namespace CycleQ2HiggsNormalizedPair

open Matrix

variable {K n ι : Type*} [Field K] [Fintype n] [DecidableEq n]
  (M : ι → Matrix n n K) (A : Matrix n n K)

private def toEquiv (hA : A.det ≠ 0) : (n → K) ≃ₗ[K] n → K :=
  LinearEquiv.ofBijective A.mulVecLin
    ⟨Matrix.mulVec_injective_of_det_ne_zero hA,
      Matrix.mulVec_surjective_iff_isUnit.mpr
        (Matrix.isUnit_iff_isUnit_det _ |>.mpr (isUnit_iff_ne_zero.mpr hA))⟩

private theorem normalized_simple [IsAlgClosed K] [Nonempty n] (hA : A.det ≠ 0)
    (h : ∀ W V : Submodule K (n → K),
      (∀ m x, x ∈ W → M m *ᵥ x ∈ V) → Module.finrank K V ≤ Module.finrank K W →
        (W = ⊥ ∧ V = ⊥) ∨ (W = ⊤ ∧ V = ⊤)) :
    Algebra.adjoin K (Set.range fun m => toLinAlgEquiv' (A.adjugate * M m)) = ⊤ := by
  apply CycleQ2HiggsMatrixAlgebra.adjoin_eq_top_of_irreducible
  intro W hW
  let e := toEquiv A hA
  let V := W.map e.toLinearMap
  have hs (m : ι) (x : n → K) (hx : x ∈ W) : M m *ᵥ x ∈ V := by
    have hy : (A.adjugate * M m) *ᵥ x ∈ W :=
      hW _ (Set.mem_range_self m) _ hx
    refine Submodule.mem_map.mpr ⟨A.det⁻¹ • ((A.adjugate * M m) *ᵥ x),
      W.smul_mem _ hy, ?_⟩
    change A.mulVecLin (A.det⁻¹ • ((A.adjugate * M m) *ᵥ x)) = _
    rw [map_smul]
    change A.det⁻¹ • (A *ᵥ ((A.adjugate * M m) *ᵥ x)) = _
    rw [mulVec_mulVec, ← mul_assoc, mul_adjugate, Matrix.smul_mul, one_mul,
      smul_mulVec, smul_smul, inv_mul_cancel₀ hA, one_smul]
  exact (h W V hs (le_of_eq (e.finrank_map_eq W))).imp And.left And.left

theorem generated_eq_top [IsAlgClosed K] [Nonempty n] (hA : A.det ≠ 0)
    (h : ∀ W V : Submodule K (n → K),
      (∀ m x, x ∈ W → M m *ᵥ x ∈ V) → Module.finrank K V ≤ Module.finrank K W →
        (W = ⊥ ∧ V = ⊥) ∨ (W = ⊤ ∧ V = ⊤)) :
    Algebra.adjoin K (Set.range fun m => A.adjugate * M m) = ⊤ := by
  have he := normalized_simple M A hA h
  apply top_unique
  intro P _
  have hp : toLinAlgEquiv' P ∈
      Algebra.adjoin K (Set.range fun m => toLinAlgEquiv' (A.adjugate * M m)) := by
    rw [he]
    trivial
  have hs : (Set.range fun m => toLinAlgEquiv' (A.adjugate * M m)) =
      toLinAlgEquiv' '' (Set.range fun m => A.adjugate * M m) := by
    rw [← Set.range_comp]
    rfl
  rw [hs] at hp
  let e : Matrix n n K ≃ₐ[K] Module.End K (n → K) := toLinAlgEquiv'
  change e.toAlgHom P ∈ Algebra.adjoin K (e.toAlgHom '' _) at hp
  rw [← AlgHom.map_adjoin] at hp
  obtain ⟨Q, hQ, hPQ⟩ := hp
  exact (toLinAlgEquiv'.injective hPQ) ▸ hQ

theorem stable_pair_of_generated_eq_top (hA : A.det ≠ 0)
    (hgen : Algebra.adjoin K (Set.range fun m => A.adjugate * M m) = ⊤)
    (W V : Submodule K (n → K))
    (hmap : ∀ m x, x ∈ W → M m *ᵥ x ∈ V)
    (hAmap : ∀ x ∈ W, A *ᵥ x ∈ V)
    (hrank : Module.finrank K V ≤ Module.finrank K W) :
    (W = ⊥ ∧ V = ⊥) ∨ (W = ⊤ ∧ V = ⊤) := by
  let e := toEquiv A hA
  have hV : W.map e.toLinearMap = V := by
    apply Submodule.eq_of_le_of_finrank_le
    · exact Submodule.map_le_iff_le_comap.mpr hAmap
    · rw [LinearEquiv.finrank_map_eq]
      exact hrank
  have hnorm (m : ι) (x : n → K) (hx : x ∈ W) : (A.adjugate * M m) *ᵥ x ∈ W := by
    obtain ⟨y, hy, he⟩ := Submodule.mem_map.mp (hV ▸ hmap m x hx)
    change A *ᵥ y = M m *ᵥ x at he
    rw [← mulVec_mulVec, ← he, mulVec_mulVec, adjugate_mul, smul_mulVec, one_mulVec]
    exact W.smul_mem _ hy
  have hall (P : Matrix n n K) (x : n → K) (hx : x ∈ W) : P *ᵥ x ∈ W := by
    have hp : P ∈ Algebra.adjoin K (Set.range fun m => A.adjugate * M m) := by
      rw [hgen]
      trivial
    induction hp using Algebra.adjoin_induction generalizing x with
    | mem p hp =>
      obtain ⟨m, rfl⟩ := hp
      exact hnorm m x hx
    | algebraMap a =>
      rw [Algebra.algebraMap_eq_smul_one, smul_mulVec, one_mulVec]
      exact W.smul_mem _ hx
    | add p q _ _ hp hq => rw [add_mulVec]; exact W.add_mem (hp x hx) (hq x hx)
    | mul p q _ _ hp hq => rw [← mulVec_mulVec]; exact hp _ (hq x hx)
  by_cases hz : W = ⊥
  · exact Or.inl ⟨hz, by rw [← hV, hz, Submodule.map_bot]⟩
  · have hw : W = ⊤ := by
      obtain ⟨x, hx, hx0⟩ : ∃ x ∈ W, x ≠ 0 := by
        by_contra! h
        apply hz
        refine le_antisymm (fun x hx => ?_) bot_le
        change x = 0
        exact h x hx
      obtain ⟨i, hi⟩ : ∃ i, x i ≠ 0 := by
        by_contra! h
        exact hx0 (funext h)
      apply top_unique
      intro y _
      let P : Matrix n n K := fun j k => if k = i then y j * (x i)⁻¹ else 0
      have hy : P *ᵥ x = y := by
        funext j
        change ∑ k, P j k * x k = y j
        rw [Finset.sum_eq_single i]
        · simp [P, mul_assoc, inv_mul_cancel₀ hi]
        · intro k _ hk
          simp [P, hk]
        · simp
      exact hy ▸ hall P x hx
    exact Or.inr ⟨hw, by rw [← hV, hw, Submodule.map_top, LinearEquiv.range]⟩

end CycleQ2HiggsNormalizedPair

#print axioms CycleQ2HiggsNormalizedPair.generated_eq_top
#print axioms CycleQ2HiggsNormalizedPair.stable_pair_of_generated_eq_top

    (D k A).obj.map (homOfLE h).op (b.app (op ⊤) z) at hb
  rw [← ha,← hb,toTilde_restrict k A h,fromAffineAdd_restrict k A h ω]
  let I : Framed (p k A) := ⟨V,basisAffine A i.1,i.2⟩

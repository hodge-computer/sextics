  exact CycleQ2FiniteExactAffineAtlas.isBasis g 1

private abbrev F := (onImage j).obj (oneForms f)
private abbrev G := oneForms g

def component (V : Framed g) :
    (F f j).obj.obj (op V.1) ≃+ (G g).obj.obj (op V.1) :=

    (RingHom.Etale.of_bijective e.bijective).toAlgebra
  refine ⟨j ''ᵁ V.1,affine_image (j := j) V.2.1,?_⟩
  obtain ⟨u,b,hb⟩ := V.2.2
  exact ⟨fun i => e (u i),baseChangeFrame b,baseChangeFrame_apply b u hb⟩

end CycleQ2RelativeOpenKahler


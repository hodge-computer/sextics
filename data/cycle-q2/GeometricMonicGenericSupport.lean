theorem top_comparison (ω : Ω[A⁄k]) :
    (e k A).hom.hom.app (op ⊤)
      ((toSheaf (p k A)).app (op ⊤) (fromAffineAdd k A ⊤ ω)) = toTilde k A ⊤ ω := by
  let a := (e k A).hom.hom
  let b := toSheaf (p k A)

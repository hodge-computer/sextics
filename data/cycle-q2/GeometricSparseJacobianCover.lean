import Proposal.GeometricSparseCurveSmooth
import Proposal.GeometricAffineOverlap
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# Actual Jacobian covers of the sparse affine curve charts

The three signed minors are formed from the literal polynomial partial
derivatives and then mapped to the existing `ChartRing` quotient. A proper
ideal generated by these minors would be contained in a maximal ideal.
Its quotient field is a characteristic-zero complex algebra, contradicting
the proved field-valued nonsingularity criterion.

The resulting unit-ideal statements give covers of the actual prime spectra.
Explicit cyclic permutations identify each minor with the Jacobian of the
existing presentation, so the covered patches are the previously constructed
`JacobianPatch` rings. No smoothness or Jacobian-coverage premise is supplied.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2GeometricSparseJacobianCover

open MvPolynomial CycleQ2GeometricAffineCurveCharts CycleQ2GeometricAdjunctionOverlap
  CycleQ2GeometricAffineOverlap CycleQ2GeometricResidueFrames
  CycleQ2GeometricSparseCurveSmooth

def minorPolynomial (v : Fin 2 → AffinePoly) (j : Fin 3) : AffinePoly :=
  jacobianMinors (fun k => pderiv k (v 0)) (fun k => pderiv k (v 1)) j

def chartMinor (v : Fin 2 → AffinePoly) (j : Fin 3) : ChartRing v :=
  chartMap v (minorPolynomial v j)

def jacobianIdeal (v : Fin 2 → AffinePoly) : Ideal (ChartRing v) :=
  Ideal.span (Set.range (chartMinor v))

theorem chartMap_relation (v : Fin 2 → AffinePoly) (i : Fin 2) :
    chartMap v (v i) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)

theorem first_chart_jacobianIdeal_eq_top (r : ℂ) (hr : r ^ 3 = 2) :
    jacobianIdeal (firstEquations r 0) = ⊤ := by
  by_contra hproper
  obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hproper
  let : M.IsMaximal := hM
  let K := ChartRing (firstEquations r 0) ⧸ M
  let : Field K := Ideal.Quotient.field M
  let : CharZero K := Algebra.charZero_of_charZero ℂ K
  let f : AffinePoly →ₐ[ℂ] K :=
    (Ideal.Quotient.mkₐ ℂ M).comp (chartMap (firstEquations r 0))
  have hi : (algebraMap ℂ K Complex.I) ^ 2 = -1 := by
    rw [← map_pow, Complex.I_sq, map_neg, map_one]
  have hrK : (algebraMap ℂ K r) ^ 3 = 2 := by
    rw [← map_pow, hr]
    exact map_natCast (algebraMap ℂ K) 2
  have hf : quadricOne (algebraMap ℂ K r) (f (X 0)) (f (X 1)) (f (X 2)) = 0 := by
    rw [← map_firstQuadric f r]
    change Ideal.Quotient.mk M (chartMap (firstEquations r 0) (firstEquations r 0 0)) = 0
    rw [chartMap_relation, map_zero]
  have hh : cubicOne (algebraMap ℂ K Complex.I) 0 (f (X 0)) (f (X 1)) (f (X 2)) = 0 := by
    have hz : f (firstCubic 0) = 0 := by
      change Ideal.Quotient.mk M (chartMap (firstEquations r 0) (firstEquations r 0 1)) = 0
      rw [chartMap_relation, map_zero]
    rw [map_firstCubic] at hz
    simpa only [map_zero] using hz
  obtain ⟨j, hj⟩ := first_chart_jacobian_nonzero (algebraMap ℂ K Complex.I)
    (algebraMap ℂ K r) (f (X 0)) (f (X 1)) (f (X 2)) hi hrK hf hh
  apply hj
  have hz : Ideal.Quotient.mk M (chartMinor (firstEquations r 0) j) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (hle (Ideal.subset_span ⟨j, rfl⟩))
  change f (jacobianMinors (fun k => pderiv k (firstEquations r 0 0))
    (fun k => pderiv k (firstEquations r 0 1)) j) = 0 at hz
  rw [map_first_minors] at hz
  simpa only [map_zero, CycleQ2GeometricCofactorResidue.cofactor, jacobianMinors] using hz

theorem second_chart_jacobianIdeal_eq_top (r : ℂ) (hr : r ^ 3 = 2) :
    jacobianIdeal (secondEquations r 0) = ⊤ := by
  by_contra hproper
  obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hproper
  let : M.IsMaximal := hM
  let K := ChartRing (secondEquations r 0) ⧸ M
  let : Field K := Ideal.Quotient.field M
  let : CharZero K := Algebra.charZero_of_charZero ℂ K
  let f : AffinePoly →ₐ[ℂ] K :=
    (Ideal.Quotient.mkₐ ℂ M).comp (chartMap (secondEquations r 0))
  have hi : (algebraMap ℂ K Complex.I) ^ 2 = -1 := by
    rw [← map_pow, Complex.I_sq, map_neg, map_one]
  have hrK : (algebraMap ℂ K r) ^ 3 = 2 := by
    rw [← map_pow, hr]
    exact map_natCast (algebraMap ℂ K) 2
  have hf : quadricTwo (algebraMap ℂ K r) (f (X 0)) (f (X 1)) (f (X 2)) = 0 := by
    rw [← map_secondQuadric f r]
    change Ideal.Quotient.mk M (chartMap (secondEquations r 0) (secondEquations r 0 0)) = 0
    rw [chartMap_relation, map_zero]
  have hh : cubicTwo (algebraMap ℂ K Complex.I) 0 (f (X 0)) (f (X 1)) (f (X 2)) = 0 := by
    have hz : f (secondCubic 0) = 0 := by
      change Ideal.Quotient.mk M (chartMap (secondEquations r 0) (secondEquations r 0 1)) = 0
      rw [chartMap_relation, map_zero]
    rw [map_secondCubic] at hz
    simpa only [map_zero] using hz
  obtain ⟨j, hj⟩ := second_chart_jacobian_nonzero (algebraMap ℂ K Complex.I)
    (algebraMap ℂ K r) (f (X 0)) (f (X 1)) (f (X 2)) hi hrK hf hh
  apply hj
  have hz : Ideal.Quotient.mk M (chartMinor (secondEquations r 0) j) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (hle (Ideal.subset_span ⟨j, rfl⟩))
  change f (jacobianMinors (fun k => pderiv k (secondEquations r 0 0))
    (fun k => pderiv k (secondEquations r 0 1)) j) = 0 at hz
  rw [map_second_minors] at hz
  simpa only [map_zero, CycleQ2GeometricCofactorResidue.cofactor, jacobianMinors] using hz

/-- Every prime of the literal ring omits at least one actual minor. -/
theorem exists_minor_not_mem (v : Fin 2 → AffinePoly)
    (h : jacobianIdeal v = ⊤) (P : Ideal (ChartRing v)) (hP : P.IsPrime) :
    ∃ j : Fin 3, chartMinor v j ∉ P := by
  by_contra! hall
  have hle : jacobianIdeal v ≤ P := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact hall j
  rw [h] at hle
  exact hP.ne_top (top_le_iff.mp hle)

theorem first_chart_exists_minor_not_mem (r : ℂ) (hr : r ^ 3 = 2)
    (P : Ideal (ChartRing (firstEquations r 0))) (hP : P.IsPrime) :
    ∃ j : Fin 3, chartMinor (firstEquations r 0) j ∉ P :=
  exists_minor_not_mem _ (first_chart_jacobianIdeal_eq_top r hr) P hP

theorem first_chart_basicOpen_cover (r : ℂ) (hr : r ^ 3 = 2) :
    (⨆ j : Fin 3, PrimeSpectrum.basicOpen (chartMinor (firstEquations r 0) j)) = ⊤ :=
  PrimeSpectrum.iSup_basicOpen_eq_top_iff.mpr (first_chart_jacobianIdeal_eq_top r hr)

theorem second_chart_exists_minor_not_mem (r : ℂ) (hr : r ^ 3 = 2)
    (P : Ideal (ChartRing (secondEquations r 0))) (hP : P.IsPrime) :
    ∃ j : Fin 3, chartMinor (secondEquations r 0) j ∉ P :=
  exists_minor_not_mem _ (second_chart_jacobianIdeal_eq_top r hr) P hP

theorem second_chart_basicOpen_cover (r : ℂ) (hr : r ^ 3 = 2) :
    (⨆ j : Fin 3, PrimeSpectrum.basicOpen (chartMinor (secondEquations r 0) j)) = ⊤ :=
  PrimeSpectrum.iSup_basicOpen_eq_top_iff.mpr (second_chart_jacobianIdeal_eq_top r hr)

def cyclicPermutation : Equiv.Perm (Fin 3) where
  toFun := ![1, 2, 0]
  invFun := ![2, 0, 1]
  left_inv := by intro j; fin_cases j <;> rfl
  right_inv := by intro j; fin_cases j <;> rfl

/-- The free coordinate is j, and the other two are ordered cyclically. -/
def pivotPermutation (j : Fin 3) : Equiv.Perm (Fin 3) :=
  if j = 0 then Equiv.refl _ else if j = 1 then cyclicPermutation else cyclicPermutation.symm

theorem pivotPermutation_zero (j : Fin 3) : pivotPermutation j 0 = j := by
  fin_cases j <;> rfl

/-- These are exactly the Jacobians used by the existing localized smooth
presentations, including the signs of the three cyclic minors. -/
theorem pivot_jacobian (v : Fin 2 → AffinePoly) (j : Fin 3) :
    (chartPresentation v (pivotPermutation j)).jacobian = chartMinor v j := by
  have hentry (i k : Fin 2) :
      (chartPresentation v (pivotPermutation j)).jacobiMatrix i k =
        pderiv (pivotPermutation j i.succ) (v k) := by
    rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    rfl
  calc
    (chartPresentation v (pivotPermutation j)).jacobian =
        chartMap v (chartPresentation v (pivotPermutation j)).jacobiMatrix.det :=
      (chartPresentation v (pivotPermutation j)).jacobian_eq_jacobiMatrix_det
    _ = chartMinor v j := by
      apply congrArg (chartMap v)
      simp only [Matrix.det_fin_two, hentry]
      fin_cases j <;>
        simp [minorPolynomial, jacobianMinors, pivotPermutation, cyclicPermutation] <;> ring

theorem first_chart_exists_pivot (r : ℂ) (hr : r ^ 3 = 2)
    (P : Ideal (ChartRing (firstEquations r 0))) (hP : P.IsPrime) :
    ∃ e : Equiv.Perm (Fin 3), (chartPresentation (firstEquations r 0) e).jacobian ∉ P := by
  obtain ⟨j, hj⟩ := first_chart_exists_minor_not_mem r hr P hP
  exact ⟨pivotPermutation j, by rwa [pivot_jacobian]⟩

/-- The basic opens belonging to the actual `JacobianPatch` rings cover
the spectrum of the actual first-chart quotient. -/
theorem first_chart_jacobianPatch_cover (r : ℂ) (hr : r ^ 3 = 2) :
    (⨆ j : Fin 3,
      PrimeSpectrum.basicOpen (chartPresentation (firstEquations r 0) (pivotPermutation j)).jacobian)
      = ⊤ := by
  simp_rw [pivot_jacobian]
  exact first_chart_basicOpen_cover r hr

theorem second_chart_exists_pivot (r : ℂ) (hr : r ^ 3 = 2)
    (P : Ideal (ChartRing (secondEquations r 0))) (hP : P.IsPrime) :
    ∃ e : Equiv.Perm (Fin 3), (chartPresentation (secondEquations r 0) e).jacobian ∉ P := by
  obtain ⟨j, hj⟩ := second_chart_exists_minor_not_mem r hr P hP
  exact ⟨pivotPermutation j, by rwa [pivot_jacobian]⟩

theorem second_chart_jacobianPatch_cover (r : ℂ) (hr : r ^ 3 = 2) :
    (⨆ j : Fin 3,
      PrimeSpectrum.basicOpen (chartPresentation (secondEquations r 0) (pivotPermutation j)).jacobian)
      = ⊤ := by
  simp_rw [pivot_jacobian]
  exact second_chart_basicOpen_cover r hr

/-- Every point is the image of an actual prime of one of the existing
Jacobian localization rings, through its actual localization homomorphism. -/
theorem jacobianPatch_points_cover (v : Fin 2 → AffinePoly)
    (h : jacobianIdeal v = ⊤) (P : PrimeSpectrum (ChartRing v)) :
    ∃ (j : Fin 3) (Q : PrimeSpectrum (JacobianPatch v (pivotPermutation j))),
      PrimeSpectrum.comap (algebraMap (ChartRing v) (JacobianPatch v (pivotPermutation j))) Q = P := by
  obtain ⟨j, hj⟩ := exists_minor_not_mem v h P.asIdeal P.isPrime
  have hp : P ∈ PrimeSpectrum.basicOpen (chartPresentation v (pivotPermutation j)).jacobian := by
    rw [PrimeSpectrum.mem_basicOpen, pivot_jacobian]
    exact hj
  change P ∈ (PrimeSpectrum.basicOpen
    (chartPresentation v (pivotPermutation j)).jacobian : Set (PrimeSpectrum (ChartRing v))) at hp
  rw [← PrimeSpectrum.localization_away_comap_range (JacobianPatch v (pivotPermutation j))
    (chartPresentation v (pivotPermutation j)).jacobian] at hp
  obtain ⟨Q, hQ⟩ := hp
  exact ⟨j, Q, hQ⟩

theorem first_chart_points_cover (r : ℂ) (hr : r ^ 3 = 2)
    (P : PrimeSpectrum (ChartRing (firstEquations r 0))) :
    ∃ (j : Fin 3) (Q : PrimeSpectrum (FirstJacobianPatch r 0 (pivotPermutation j))),
      PrimeSpectrum.comap (algebraMap (ChartRing (firstEquations r 0))
        (FirstJacobianPatch r 0 (pivotPermutation j))) Q = P :=
  jacobianPatch_points_cover _ (first_chart_jacobianIdeal_eq_top r hr) P

theorem second_chart_points_cover (r : ℂ) (hr : r ^ 3 = 2)
    (P : PrimeSpectrum (ChartRing (secondEquations r 0))) :
    ∃ (j : Fin 3) (Q : PrimeSpectrum (SecondJacobianPatch r 0 (pivotPermutation j))),
      PrimeSpectrum.comap (algebraMap (ChartRing (secondEquations r 0))
        (SecondJacobianPatch r 0 (pivotPermutation j))) Q = P :=
  jacobianPatch_points_cover _ (second_chart_jacobianIdeal_eq_top r hr) P

#print axioms first_chart_jacobianIdeal_eq_top
#print axioms second_chart_jacobianIdeal_eq_top
#print axioms pivot_jacobian
#print axioms first_chart_jacobianPatch_cover
#print axioms second_chart_jacobianPatch_cover
#print axioms first_chart_points_cover
#print axioms second_chart_points_cover

end CycleQ2GeometricSparseJacobianCover

end

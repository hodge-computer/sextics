import Proposal.GeometricGradedCechDescent

/-!
# Contraction of degree-zero generated ideals

The existing degree-zero projection of an ordinary homogeneous
localization is linear over the genuine degree-zero ring. Therefore an
ideal generated by degree-zero elements contracts to the ideal generated
by the same elements. The proof allows any set of generators and permits
zero divisors in the original graded ring.

Source-only draft: no Lean elaboration or kernel replay has been run.
Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md for
attribution of the geometric route and the protected certificate gap.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section

namespace CycleQ2GradedIdealContraction

open HomogeneousLocalization CycleQ2GradedLocalizationProjection

variable {A σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
variable (𝒜 : ℕ → σ) [GradedRing 𝒜]
variable {f : A} {d : ℕ} (hf : f ∈ 𝒜 d)

/-- Projecting a linear combination of genuine degree-zero generators
retains membership in their degree-zero ideal. -/
theorem degreeZero_mem_span_image (s : Set (Away 𝒜 f))
    {z : Localization.Away f}
    (hz : z ∈ Ideal.span ((algebraMap (Away 𝒜 f) (Localization.Away f)) '' s)) :
    degreeZero 𝒜 hf z ∈ Ideal.span s := by
  have h : ∀ a : Localization.Away f, degreeZero 𝒜 hf (a * z) ∈ Ideal.span s := by
    induction hz using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨b, hb, rfl⟩ := hx
        intro a
        change degreeZero 𝒜 hf (a * b.val) ∈ Ideal.span s
        rw [degreeZero_homogeneous_mul]
        exact (Ideal.span s).mul_mem_left _ (Ideal.subset_span hb)
    | zero =>
        intro a
        rw [mul_zero, degreeZero_zero]
        exact (Ideal.span s).zero_mem
    | add x y hx hy ihx ihy =>
        intro a
        rw [mul_add, degreeZero_add]
        exact (Ideal.span s).add_mem (ihx a) (ihy a)
    | smul a x hx ih =>
        intro b
        simpa only [smul_eq_mul, mul_assoc] using ih (b * a)
  simpa only [one_mul] using h 1

/-- Extending and then contracting the ideal generated by actual
degree-zero elements introduces no new degree-zero elements. -/
theorem span_image_comap_val (s : Set (Away 𝒜 f)) :
    (Ideal.span ((algebraMap (Away 𝒜 f) (Localization.Away f)) '' s)).comap
      (algebraMap (Away 𝒜 f) (Localization.Away f)) = Ideal.span s := by
  apply le_antisymm
  · intro x hx
    change x.val ∈
      Ideal.span ((algebraMap (Away 𝒜 f) (Localization.Away f)) '' s) at hx
    have h := degreeZero_mem_span_image 𝒜 hf s hx
    simpa only [degreeZero_val] using h
  · intro x hx
    have h := Ideal.mem_map_of_mem
      (algebraMap (Away 𝒜 f) (Localization.Away f)) hx
    rw [Ideal.map_span] at h
    exact h

theorem ideal_map_comap_val (I : Ideal (Away 𝒜 f)) :
    (I.map (algebraMap (Away 𝒜 f) (Localization.Away f))).comap
      (algebraMap (Away 𝒜 f) (Localization.Away f)) = I := by
  conv_lhs => rw [← Ideal.span_eq I, Ideal.map_span]
  rw [span_image_comap_val 𝒜 hf, Ideal.span_eq]

#print axioms degreeZero_mem_span_image
#print axioms span_image_comap_val
#print axioms ideal_map_comap_val

end CycleQ2GradedIdealContraction
end

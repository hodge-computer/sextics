import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases

/-!
# Homogeneous witnesses for the Koszul boundary

A homogeneous element in an ideal generated by homogeneous elements has
homogeneous coefficient witnesses of the required complementary degrees.
The construction projects an arbitrary finite ideal witness to its single
required graded component, using Mathlib's multiplication rule for graded
decomposition. Generators above the required degree contribute zero.

For the quadratic, cubic, and two quartic equations of the seed, degree-nine
ideal membership therefore has coefficient degrees `7, 6, 5, 5`. The quintic
coefficients are precisely what is needed to turn the quartic-generator
terms into degree-one sections on the two principal charts. This module
proves the graded extraction; it does not assert a canonical-bundle or
Serre-duality identification.
-/

set_option autoImplicit false

noncomputable section

namespace CycleQ2GeometricGradedWitness

open scoped BigOperators

section GradedAlgebra

variable {K A ι : Type*} [CommRing K] [CommRing A] [Algebra K A] [Fintype ι]
variable (𝒜 : ℕ → Submodule K A) [GradedAlgebra 𝒜]

/-- Every finite ideal witness can be replaced by its required homogeneous
components. This also covers generators whose degrees exceed `N`. -/
theorem exists_graded_coefficients (d : ι → ℕ) (v : ι → A)
    (hv : ∀ i, v i ∈ 𝒜 (d i)) (N : ℕ) (p : A)
    (hp : p ∈ 𝒜 N) (hmem : p ∈ Ideal.span (Set.range v)) :
    ∃ c : ι → A,
      (∀ i, c i ∈ 𝒜 (N - d i)) ∧
      (∀ i, N < d i → c i = 0) ∧
      ∑ i, c i * v i = p := by
  classical
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  let c : ι → A := fun i =>
    if d i ≤ N then (DirectSum.decompose 𝒜 (a i) (N - d i) : A) else 0
  refine ⟨c, ?_, ?_, ?_⟩
  · intro i
    dsimp only [c]
    split_ifs
    · exact (DirectSum.decompose 𝒜 (a i) (N - d i)).property
    · exact (𝒜 (N - d i)).zero_mem
  · intro i hi
    simp only [c, if_neg (Nat.not_le.mpr hi)]
  · calc
      ∑ i, c i * v i = ∑ i, GradedRing.proj 𝒜 N (a i * v i) := by
        apply Finset.sum_congr rfl
        intro i _
        change c i * v i = (DirectSum.decompose 𝒜 (a i * v i) N : A)
        rw [DirectSum.coe_decompose_mul_of_right_mem 𝒜 N (hv i)]
        dsimp only [c]
        split_ifs <;> simp
      _ = GradedRing.proj 𝒜 N (∑ i, a i * v i) := (map_sum _ _ _).symm
      _ = p := by
        rw [ha]
        exact DirectSum.decompose_of_mem_same 𝒜 hp

end GradedAlgebra

section Polynomials

variable {K σ ι : Type*} [CommRing K] [Fintype ι]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The graded witness theorem for actual multivariate polynomials. -/
theorem exists_homogeneous_coefficients (d : ι → ℕ) (v : ι → MvPolynomial σ K)
    (hv : ∀ i, (v i).IsHomogeneous (d i)) (N : ℕ) (p : MvPolynomial σ K)
    (hp : p.IsHomogeneous N) (hmem : p ∈ Ideal.span (Set.range v)) :
    ∃ c : ι → MvPolynomial σ K,
      (∀ i, (c i).IsHomogeneous (N - d i)) ∧
      (∀ i, N < d i → c i = 0) ∧
      ∑ i, c i * v i = p :=
  exists_graded_coefficients (MvPolynomial.homogeneousSubmodule σ K)
    d v hv N p hp hmem

/-- The exact degrees needed for the seed Koszul boundary: after dividing
the two quartic terms by their product, their quintic coefficients give
degree-one single-chart sections. -/
theorem degreeNine_witness (f₁ h g₁ g₂ p : MvPolynomial σ K)
    (hf₁ : f₁.IsHomogeneous 2) (hh : h.IsHomogeneous 3)
    (hg₁ : g₁.IsHomogeneous 4) (hg₂ : g₂.IsHomogeneous 4)
    (hp : p.IsHomogeneous 9)
    (hmem : p ∈ Ideal.span ({f₁, h, g₁, g₂} : Set (MvPolynomial σ K))) :
    ∃ a b c d : MvPolynomial σ K,
      a.IsHomogeneous 7 ∧ b.IsHomogeneous 6 ∧
      c.IsHomogeneous 5 ∧ d.IsHomogeneous 5 ∧
      a * f₁ + b * h + c * g₁ + d * g₂ = p := by
  let v : Fin 4 → MvPolynomial σ K := ![f₁, h, g₁, g₂]
  let deg : Fin 4 → ℕ := ![2, 3, 4, 4]
  have hv : ∀ i, (v i).IsHomogeneous (deg i) := by
    intro i
    fin_cases i
    · exact hf₁
    · exact hh
    · exact hg₁
    · exact hg₂
  have hmem' : p ∈ Ideal.span (Set.range v) := by
    simpa only [v, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union] using hmem
  obtain ⟨q, hq, _, hsum⟩ := exists_homogeneous_coefficients deg v hv 9 p hp hmem'
  refine ⟨q 0, q 1, q 2, q 3, ?_, ?_, ?_, ?_, ?_⟩
  · exact hq 0
  · exact hq 1
  · exact hq 2
  · exact hq 3
  · simp only [Fin.sum_univ_succ, v,
      Matrix.cons_val_zero, Matrix.cons_val_succ, Fin.sum_univ_zero,
      add_zero] at hsum
    change q 0 * f₁ + (q 1 * h + (q 2 * g₁ + q 3 * g₂)) = p at hsum
    simpa only [add_assoc] using hsum

end Polynomials

end CycleQ2GeometricGradedWitness

end

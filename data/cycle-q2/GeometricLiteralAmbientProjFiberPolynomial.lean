import Proposal.GeometricIncidenceFamilyContainment
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! Coefficient specialization on a weighted homogeneous quotient. The kernel
of the specialization is generated by the kernel on coefficients, even when
the specialized equation differs from the original polynomial.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2LiteralAmbientProjFiberPolynomial

open MvPolynomial CycleQ2GeometricIncidenceProj CycleQ2IncidenceFamilyContainment
open CycleQ2GeometricProjectiveCurve.HomogeneousQuotient

variable {R S : Type} [CommRing R] [CommRing S]

private theorem ker_map (φ : R →+* S) : RingHom.ker (map (σ := Fin 5) φ) =
    (RingHom.ker φ).map C := by
  apply le_antisymm
  · intro p hp
    have hz : map φ p = 0 := hp
    rw [p.as_sum]
    apply Ideal.sum_mem
    intro d _
    have hc : coeff d p ∈ RingHom.ker φ := by
      change φ (coeff d p) = 0
      rw [← coeff_map, hz, coeff_zero]
    have hm := ((RingHom.ker φ).map (C : R →+* MvPolynomial (Fin 5) R)).mul_mem_right
      (monomial d 1) (Ideal.mem_map_of_mem C hc)
    simpa only [C_mul_monomial, mul_one] using hm
  · apply Ideal.map_le_iff_le_comap.mpr
    intro r hr
    change map φ (C r) = 0
    rw [map_C, show φ r = 0 from hr, map_zero]

variable (φ : R →+* S) (I : Ideal (MvPolynomial (Fin 5) R))
  (J : Ideal (MvPolynomial (Fin 5) S)) (hIJ : I.map (map φ) = J)

def specialize : (MvPolynomial (Fin 5) R ⧸ I) →+* (MvPolynomial (Fin 5) S ⧸ J) :=
  Ideal.quotientMap J (map φ) (Ideal.map_le_iff_le_comap.mp hIJ.le)

@[simp] theorem specialize_mk (p : MvPolynomial (Fin 5) R) :
    specialize φ I J hIJ (Ideal.Quotient.mk I p) = Ideal.Quotient.mk J (map φ p) := rfl

/-- With surjective coefficient evaluation, the kernel on the two polynomial
quotients is exactly the extended coefficient ideal. -/
theorem ker_specialize (hφ : Function.Surjective φ) :
    RingHom.ker (specialize φ I J hIJ) = (RingHom.ker φ).map (algebraMap R _) := by
  rw [specialize, Ideal.quotientMap, Ideal.ker_quotient_lift, ← RingHom.comap_ker, Ideal.mk_ker,
    ← hIJ, Ideal.comap_map_of_surjective _ (map_surjective φ hφ), Ideal.map_sup,
    Ideal.map_quotient_self, bot_sup_eq, ← RingHom.ker_eq_comap_bot, ker_map, Ideal.map_map]
  rfl

attribute [local instance] MvPolynomial.weightedGradedAlgebra

/-- The quotient specialization preserves the weight grading. -/
def graded : grade (PolynomialGrade R) I →+*ᵍ grade (PolynomialGrade S) J where
  toRingHom := specialize φ I J hIJ
  map_mem := by
    rintro n a ⟨p, hp, rfl⟩
    refine ⟨map φ p, ?_, rfl⟩
    intro d hd
    apply hp
    intro hz
    exact hd (by rw [coeff_map, hz, map_zero])

/-- Lift a homogeneous numerator coefficient by coefficient. -/
theorem homogeneous_surjective (s : S →+* R) (hs : φ.comp s = RingHom.id S)
    (n : ℕ) (b : MvPolynomial (Fin 5) S ⧸ J) (hb : b ∈ grade (PolynomialGrade S) J n) :
    ∃ a : MvPolynomial (Fin 5) R ⧸ I,
      a ∈ grade (PolynomialGrade R) I n ∧ graded φ I J hIJ a = b := by
  obtain ⟨p, hp, rfl⟩ := hb
  refine ⟨Ideal.Quotient.mk I (map s p), ⟨map s p, ?_, rfl⟩, ?_⟩
  · intro d hd
    apply hp
    intro hz
    exact hd (by rw [coeff_map, hz, map_zero])
  · change Ideal.Quotient.mk J (map φ (map s p)) = Ideal.Quotient.mk J p
    rw [map_map, hs, map_id]

end CycleQ2LiteralAmbientProjFiberPolynomial

#print axioms CycleQ2LiteralAmbientProjFiberPolynomial.ker_specialize
#print axioms CycleQ2LiteralAmbientProjFiberPolynomial.homogeneous_surjective

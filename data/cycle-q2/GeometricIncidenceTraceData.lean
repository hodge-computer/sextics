    (-1368) * i * x * (y ^ 2) * (z ^ 3) * (w ^ 2) +
    228 * i * (y ^ 7) * z +
    684 * i * (y ^ 6) * (w ^ 2) +
    228 * i * (y ^ 3) * (z ^ 3) * (w ^ 2) +
    456 * (x ^ 3) * (y ^ 4) * z +
    12 * (x ^ 3) * (y ^ 4) * w +

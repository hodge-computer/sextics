theorem annihilator3 (i x y z w : R) (hi : i ^ 2 + 1 = 0) :
    numerator i x y z w * ((-1) * i * (y ^ 3) +
    (-1) * i * (w ^ 3) +
    (x ^ 3) +
    x * (y ^ 2) +
    x * z * w +
    y * z * w +
    (z ^ 3) +
    (w ^ 3)) =
      x ^ 4 * cofactor30 i x y z w +
      y ^ 10 * cofactor31 i x y z w +
      z ^ 4 * cofactor32 i x y z w +
      w ^ 10 * cofactor33 i x y z w := by
  unfold numerator cofactor30 cofactor31 cofactor32 cofactor33
  linear_combination ((-2) * (x ^ 3) * (y ^ 12) * (z ^ 2) * w +
    (-114) * (x ^ 3) * (y ^ 12) * (w ^ 3) +
    (-2) * (x ^ 3) * (y ^ 11) * z * (w ^ 3) +

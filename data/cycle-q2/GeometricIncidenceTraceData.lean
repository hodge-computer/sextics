end CycleQ2IncidenceDualData

end DualIncidenceIdentities

section ActualIncidenceDual

/-! A checked nonzero functional on the actual literal-seed numerator
quotient. It is an algebraic coefficient functional; no identification
with a geometric Serre trace is asserted. -/

set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 4000000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section
namespace CycleQ2GeometricIncidenceDual

open MvPolynomial CycleQ2SeedTrace CycleQ2SeedCechTheta
  CycleQ2GeometricKoszulTrace

def traceNumerator : Poly :=
    C ((285 : ℂ) + (0 : ℂ) * Complex.I) * mon 3 9 3 0 +
    C ((6 : ℂ) + (2 : ℂ) * Complex.I) * mon 3 9 2 1 +
    C ((-228 : ℂ) + (114 : ℂ) * Complex.I) * mon 3 9 0 3 +
    C ((-4 : ℂ) + (2 : ℂ) * Complex.I) * mon 3 8 1 3 +
    C ((4 : ℂ) + (8 : ℂ) * Complex.I) * mon 3 4 0 8 +
    C ((20 : ℂ) + (0 : ℂ) * Complex.I) * mon 3 2 1 9 +
    C ((16 : ℂ) + (-8 : ℂ) * Complex.I) * mon 3 1 3 8 +
    C ((-912 : ℂ) + (456 : ℂ) * Complex.I) * mon 3 0 3 9 +
    C ((171 : ℂ) + (57 : ℂ) * Complex.I) * mon 2 9 2 2 +
    C ((-4 : ℂ) + (2 : ℂ) * Complex.I) * mon 2 9 1 3 +
    C ((-4 : ℂ) + (2 : ℂ) * Complex.I) * mon 2 8 3 2 +
    C ((2 : ℂ) + (-6 : ℂ) * Complex.I) * mon 2 8 0 5 +
    C ((-8 : ℂ) + (4 : ℂ) * Complex.I) * mon 2 5 0 8 +
    C ((456 : ℂ) + (-228 : ℂ) * Complex.I) * mon 2 4 0 9 +
    C ((4 : ℂ) + (8 : ℂ) * Complex.I) * mon 2 3 1 9 +
    C ((4 : ℂ) + (8 : ℂ) * Complex.I) * mon 2 2 3 8 +
    C ((-684 : ℂ) + (-1368 : ℂ) * Complex.I) * mon 2 1 3 9 +
    C ((-228 : ℂ) + (114 : ℂ) * Complex.I) * mon 1 9 1 4 +
    C ((228 : ℂ) + (456 : ℂ) * Complex.I) * mon 1 5 0 9 +
    C ((912 : ℂ) + (-456 : ℂ) * Complex.I) * mon 1 2 3 9 +
    C ((-228 : ℂ) + (114 : ℂ) * Complex.I) * mon 0 9 3 3 +
    C ((114 : ℂ) + (-342 : ℂ) * Complex.I) * mon 0 9 0 6 +
    C ((-456 : ℂ) + (228 : ℂ) * Complex.I) * mon 0 6 0 9 +
    C ((228 : ℂ) + (456 : ℂ) * Complex.I) * mon 0 3 3 9

theorem traceNumerator_eq_data : traceNumerator =
    CycleQ2IncidenceDualData.numerator (C Complex.I) (X 0) (X 1) (X 2) (X 3) := by
  simp only [traceNumerator, CycleQ2IncidenceDualData.numerator, mon,
    map_add, map_mul, map_neg, map_ofNat, map_zero, map_one]
  ring

private theorem imaginary_relation : (C Complex.I : Poly) ^ 2 + 1 = 0 := by
  rw [← map_pow, Complex.I_sq, map_neg, map_one, neg_add_cancel]

theorem generator0_mul_mem :
    traceNumerator * (relation 57 0) ∈ truncationIdeal := by
  have hm := fourTerm_mem_truncation
    (CycleQ2IncidenceDualData.cofactor00 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor01 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor02 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor03 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
  have ha := CycleQ2IncidenceDualData.annihilator0 (C Complex.I) (X 0) (X 1) (X 2) (X 3) imaginary_relation
  rw [← ha] at hm
  have hg : relation 57 0 = (X 0 : Poly) ^ 2 + (-57) * X 1 * X 3 := by
    change X 0 ^ 2 - C (57 : ℂ) * X 1 * X 3 = _
    rw [map_ofNat]
    ring
  rw [traceNumerator_eq_data, hg]
  convert hm using 1 <;> ring

theorem generator1_mul_mem :
    traceNumerator * (relation 57 1) ∈ truncationIdeal := by
  have hm := fourTerm_mem_truncation
    (CycleQ2IncidenceDualData.cofactor10 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor11 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor12 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor13 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
  have ha := CycleQ2IncidenceDualData.annihilator1 (C Complex.I) (X 0) (X 1) (X 2) (X 3) imaginary_relation
  rw [← ha] at hm
  have hg : relation 57 1 = (X 1 : Poly) ^ 2 * X 3 ^ 2 := rfl
  rw [traceNumerator_eq_data, hg]
  convert hm using 1 <;> ring

theorem generator2_mul_mem :
    traceNumerator * (relation 57 2) ∈ truncationIdeal := by
  have hm := fourTerm_mem_truncation
    (CycleQ2IncidenceDualData.cofactor20 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor21 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor22 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor23 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
  have ha := CycleQ2IncidenceDualData.annihilator2 (C Complex.I) (X 0) (X 1) (X 2) (X 3) imaginary_relation
  rw [← ha] at hm
  have hg : relation 57 2 = (X 2 : Poly) ^ 4 := rfl
  rw [traceNumerator_eq_data, hg]
  convert hm using 1 <;> ring

theorem generator3_mul_mem :
    traceNumerator * (curveH 1) ∈ truncationIdeal := by
  have hm := fourTerm_mem_truncation
    (CycleQ2IncidenceDualData.cofactor30 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor31 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor32 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
    (CycleQ2IncidenceDualData.cofactor33 (C Complex.I) (X 0) (X 1) (X 2) (X 3))
  have ha := CycleQ2IncidenceDualData.annihilator3 (C Complex.I) (X 0) (X 1) (X 2) (X 3) imaginary_relation
  rw [← ha] at hm
  have hg : (curveH 1) = (X 0 : Poly) ^ 3 + X 0 * X 1 ^ 2 + X 0 * X 2 * X 3 + X 1 * X 2 * X 3 + X 2 ^ 3 + X 3 ^ 3 - C Complex.I * X 1 ^ 3 - C Complex.I * X 3 ^ 3 := by
    norm_num [relation, curveH, CycleQ2SeedTrace.h, b]
    <;> ring
  rw [traceNumerator_eq_data, hg]
  convert hm using 1 <;> ring

theorem firstQuartic_mul_mem :
    traceNumerator * firstQuartic 57 ∈ truncationIdeal := by
  have hg : firstQuartic 57 = C (3 * (57 : ℂ) ^ 2) * relation 57 1 := by
    change C (3 * (57 : ℂ) ^ 2) * (X 1 * X 3) ^ 2 =
      C (3 * (57 : ℂ) ^ 2) * (X 1 ^ 2 * X 3 ^ 2)
    ring
  rw [hg]
  simpa only [mul_assoc, mul_left_comm] using
    Ideal.mul_mem_left truncationIdeal (C (3 * (57 : ℂ) ^ 2)) generator1_mul_mem

theorem secondQuartic_mul_mem :
    traceNumerator * secondQuartic ∈ truncationIdeal := by
  have hg : secondQuartic = C (3 : ℂ) * relation 57 2 := by
    rfl
  rw [hg]
  simpa only [mul_assoc, mul_left_comm] using
    Ideal.mul_mem_left truncationIdeal (C (3 : ℂ)) generator2_mul_mem

/-- This annihilator identity holds for arbitrary ideal elements and
therefore for arbitrary polynomial multiples of all four generators. -/
theorem traceNumerator_mul_mem {p : Poly}
    (hp : p ∈ fourGeneratorIdeal 57 1) :
    traceNumerator * p ∈ truncationIdeal := by
  change p ∈ Ideal.span ({relation 57 0, curveH 1, firstQuartic 57, secondQuartic} : Set Poly) at hp
  induction hp using Submodule.span_induction with
  | mem p hp =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rcases hp with rfl | rfl | rfl | rfl
      · exact generator0_mul_mem
      · exact generator3_mul_mem
      · exact firstQuartic_mul_mem
      · exact secondQuartic_mul_mem
  | zero => simp
  | add p q _ _ hp hq =>
      simpa only [mul_add] using Ideal.add_mem truncationIdeal hp hq
  | smul a p _ hp =>
      simpa only [smul_eq_mul, mul_left_comm] using
        Ideal.mul_mem_left truncationIdeal a hp

/-- A concrete normalized linear functional on actual polynomial numerators. -/
def traceLinear : Poly →ₗ[ℂ] ℂ :=
  ((1 / 285 : ℂ) • lcoeff ℂ topExponent).comp
    (LinearMap.mul ℂ Poly traceNumerator)

@[simp] theorem traceLinear_apply (p : Poly) :
    traceLinear p = (1 / 285 : ℂ) * coeff topExponent (traceNumerator * p) := rfl

theorem traceLinear_zero_of_mem {p : Poly}
    (hp : p ∈ fourGeneratorIdeal 57 1) : traceLinear p = 0 := by
  rw [traceLinear_apply, top_coeff_zero_of_mem (traceNumerator_mul_mem hp), mul_zero]

theorem traceLinear_normalization : traceLinear (mon 0 0 0 9) = 1 := by
  rw [traceLinear_apply]
  simp only [traceNumerator, add_mul, mul_assoc, mon_mul, coeff_add, coeff_C_mul,
    coeff_top_mon]
  norm_num

/-- Nonmembership is detected by a certified functional on the actual
ideal, not inferred merely from a spanning calculation. -/
theorem normalization_not_mem_fourGeneratorIdeal :
    mon 0 0 0 9 ∉ fourGeneratorIdeal 57 1 := by
  intro h
  have hz := traceLinear_zero_of_mem h
  rw [traceLinear_normalization] at hz
  exact one_ne_zero hz

#print axioms traceNumerator_mul_mem
#print axioms traceLinear_normalization
#print axioms normalization_not_mem_fourGeneratorIdeal


    (-456) * (x ^ 3) * (z ^ 3) * (w ^ 12) +
    (-57) * (x ^ 2) * (y ^ 12) * (z ^ 2) * (w ^ 2) +
    (-2) * (x ^ 2) * (y ^ 12) * z * (w ^ 3) +
    (-2) * (x ^ 2) * (y ^ 11) * (z ^ 3) * (w ^ 2) +
    6 * (x ^ 2) * (y ^ 11) * (w ^ 5) +
    (-57) * (x ^ 2) * (y ^ 9) * (z ^ 2) * (w ^ 5) +
    (-2) * (x ^ 2) * (y ^ 9) * z * (w ^ 6) +

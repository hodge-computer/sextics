    1368 * (x ^ 2) * (y ^ 4) * (z ^ 3) * (w ^ 9) +
    228 * (x ^ 2) * (y ^ 4) * (w ^ 12) +
    (-8) * (x ^ 2) * (y ^ 3) * z * (w ^ 12) +

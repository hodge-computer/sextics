    (U W : Submodule ℂ InvariantHodgeModel) (hUW : IsCompl U W)
    (horth : ∀ (t : InvariantTangentModel) (u : U) (w : W),
      actualTracePairing t (u : InvariantHodgeModel)
        (w : InvariantHodgeModel) = 0) :
    U = ⊥ ∨ U = ⊤ := by

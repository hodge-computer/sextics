    CycleQ2AffineFiniteDescent.tangent L j (c • z) =
      c • CycleQ2AffineFiniteDescent.tangent L j z := by
  simp only [Algebra.smul_def, Derivation.leibniz, smul_eq_mul,
    tangent_complex_constant, mul_zero, add_zero]
  simp


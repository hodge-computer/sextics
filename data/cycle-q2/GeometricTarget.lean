theorem actualProjectorPolynomial_coeff_zero
    (M : Module.End ℂ InvariantHodgeModel) (hM : Function.Injective M) :
    (actualProjectorPolynomial M).coeff 0 = 0 := by
  letI : Module.Free ℂ InvariantHodgeModel :=

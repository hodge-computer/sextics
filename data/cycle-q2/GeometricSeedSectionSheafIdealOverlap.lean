/-!
# The original ideal sheaves have the same image on every overlap

The original linkage pairing supplies a finite dual frame for each
original chart ideal. Applying its reconstruction identity to the actual
associated sheaf shows that the image on any open is generated by the
three original left sections. This works on arbitrary opens: no assertion
that an unspecified sheaf epimorphism is surjective on sections is used.

The degree-ten change of those generators is by an actual coordinate
unit. Consequently the two literal ideal inclusions have the same range
on every common projective subopen. Together with their injectivity this
provides the unique overlap transport needed for the fixed twisted source.

Source-only draft: no Lean elaboration or kernel replay was run.
Prepared for fqlx with OpenAI ChatGPT assistance; see solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2SeedSectionSheafIdealOverlap

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry
open CycleQ2SegreFactorSequence CycleQ2SegreLinkageDuality
  CycleQ2SeedProjectiveImageChart CycleQ2SeedProjectiveImageCocycle
  CycleQ2GeometricSurfaceDehomogenizedCharts CycleQ2SeedSectionBalance
  CycleQ2SeedSectionSheaf CycleQ2SeedSectionSheafSections
  CycleQ2SeedSectionSheafEvaluation CycleQ2SeedSectionSheafMono

section Frame

variable {R : Type} [CommRing R]

/-- The actual coefficients in the linkage dual-frame reconstruction. -/
def frameMap (F : FactorData R) (q : Fin 3 × Fin 3) :
    ModuleCat.of R F.leftIdeal ⟶ ModuleCat.of R R :=
  ModuleCat.ofHom (weights F q • pairing F (rightElement F q.2))

/-- A chosen original ideal generator defines an actual module morphism. -/
def leftGeneratorMap (F : FactorData R) (a : Fin 3) :
    ModuleCat.of R R ⟶ ModuleCat.of R F.leftIdeal :=
  ModuleCat.ofHom
    { toFun := fun r => r • leftElement F a
      map_add' := fun r s => add_smul r s (leftElement F a)
      map_smul' := fun r s => mul_smul r s (leftElement F a) }

theorem leftGeneratorMap_inclusion (F : FactorData R) (a : Fin 3) :
    leftGeneratorMap F a ≫ idealInclusion F = scalarMap (F.left a) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro r
  change r * F.left a = F.left a * r
  exact mul_comm _ _

/-- Reconstruction is an equality of the original inclusion morphisms. -/
theorem idealInclusion_frame (F : FactorData R) :
    idealInclusion F =
      ∑ q : Fin 3 × Fin 3, frameMap F q ≫ scalarMap (F.left q.1) := by
  apply ModuleCat.hom_ext
  rw [ModuleCat.hom_sum]
  apply LinearMap.ext
  intro x
  simp only [LinearMap.sum_apply, ModuleCat.hom_comp, LinearMap.comp_apply]
  change (x : R) = ∑ q : Fin 3 × Fin 3,
    F.left q.1 * (weights F q * pairing F (rightElement F q.2) x)
  rw [left_reconstruction F x]
  apply Finset.sum_congr rfl
  intro q _
  exact mul_comm _ _

theorem tilde_idealInclusion_frame (F : FactorData R) :
    tilde.map (idealInclusion F) =
      ∑ q : Fin 3 × Fin 3,
        tilde.map (frameMap F q) ≫ tilde.map (scalarMap (F.left q.1)) := by
  have h := congrArg (tilde.functor (CommRingCat.of R)).map (idealInclusion_frame F)
  rw [Functor.map_sum] at h
  simpa only [tilde.functor, tilde.map_comp] using h

end Frame

private theorem restrict_additive {X Y : Scheme.{0}} (f : X ⟶ Y)
    [IsOpenImmersion f] : (Scheme.Modules.restrictFunctor f).Additive where
  map_add := by
    intro M N a b
    apply Scheme.Modules.hom_ext
    intro U
    rfl

/-- Each coefficient retains the original affine chart transport. -/
def chartFrameCoefficient (i : Fin 3) (q : Fin 3 × Fin 3) :
    chartIdeal i ⟶ structureModule (Patch i).toScheme :=
  (Scheme.Modules.restrictFunctor (coordinateAffineChart 57 1 i.succ).hom).map
      (tilde.map (frameMap (chartFactorData i) q)) ≫
    (Scheme.Modules.restrictUnitIso (coordinateAffineChart 57 1 i.succ).hom).hom

def patchFrameCoefficient (i : Fin 3) (q : Fin 3 × Fin 3) :
    idealPatch i ⟶ patchStructure (Patch i) :=
  (Scheme.Modules.pushforward (Patch i).ι).map (chartFrameCoefficient i q)

/-- The finite reconstruction survives the actual affine chart isomorphism. -/
theorem chartInclusion_frame (i : Fin 3) :
    chartInclusion i = ∑ q : Fin 3 × Fin 3,
      chartFrameCoefficient i q ≫ chartScalar i ((chartFactorData i).left q.1) := by
  let T := Scheme.Modules.restrictFunctor (coordinateAffineChart 57 1 i.succ).hom
  let e := Scheme.Modules.restrictUnitIso (coordinateAffineChart 57 1 i.succ).hom
  letI : T.Additive := restrict_additive _
  change T.map (tilde.map (idealInclusion (chartFactorData i))) ≫ e.hom =
    ∑ q : Fin 3 × Fin 3,
      (T.map (tilde.map (frameMap (chartFactorData i) q)) ≫ e.hom) ≫
        chartScalar i ((chartFactorData i).left q.1)
  rw [tilde_idealInclusion_frame, Functor.map_sum, Preadditive.sum_comp]
  apply Finset.sum_congr rfl
  intro q _
  rw [Functor.map_comp, Category.assoc, chartScalar_square, ← Category.assoc]

theorem idealPatchInclusion_frame (i : Fin 3) :
    idealPatchInclusion i = ∑ q : Fin 3 × Fin 3,
      patchFrameCoefficient i q ≫ patchScalar i ((chartFactorData i).left q.1) := by
  simp only [idealPatchInclusion, chartInclusion_frame, Functor.map_sum,
    Functor.map_comp, patchFrameCoefficient, patchScalar]

/-- The original generator as a morphism from the actual chart structure sheaf. -/
def chartLeftGenerator (i : Fin 3) (a : Fin 3) :
    structureModule (Patch i).toScheme ⟶ chartIdeal i :=
  (Scheme.Modules.restrictUnitIso (coordinateAffineChart 57 1 i.succ).hom).inv ≫
    (Scheme.Modules.restrictFunctor (coordinateAffineChart 57 1 i.succ).hom).map
      (tilde.map (leftGeneratorMap (chartFactorData i) a))

theorem chartLeftGenerator_inclusion (i : Fin 3) (a : Fin 3) :
    chartLeftGenerator i a ≫ chartInclusion i =
      chartScalar i ((chartFactorData i).left a) := by
  let T := Scheme.Modules.restrictFunctor (coordinateAffineChart 57 1 i.succ).hom
  let e := Scheme.Modules.restrictUnitIso (coordinateAffineChart 57 1 i.succ).hom
  change (e.inv ≫ T.map (tilde.map (leftGeneratorMap (chartFactorData i) a))) ≫
      (T.map (tilde.map (idealInclusion (chartFactorData i))) ≫ e.hom) = _
  calc
    _ = e.inv ≫ T.map (tilde.map
        (leftGeneratorMap (chartFactorData i) a ≫ idealInclusion (chartFactorData i))) ≫
          e.hom := by
      rw [tilde.map_comp, Functor.map_comp]
      simp only [Category.assoc]
    _ = e.inv ≫ T.map (tilde.map (scalarMap ((chartFactorData i).left a))) ≫
        e.hom := by rw [leftGeneratorMap_inclusion]
    _ = e.inv ≫ (e.hom ≫ chartScalar i ((chartFactorData i).left a)) := by
      rw [chartScalar_square]
    _ = _ := by rw [← Category.assoc, e.inv_hom_id, Category.id_comp]

def patchLeftGenerator (i : Fin 3) (a : Fin 3) :
    patchStructure (Patch i) ⟶ idealPatch i :=
  (Scheme.Modules.pushforward (Patch i).ι).map (chartLeftGenerator i a)

theorem patchLeftGenerator_inclusion (i : Fin 3) (a : Fin 3) :
    patchLeftGenerator i a ≫ idealPatchInclusion i =
      patchScalar i ((chartFactorData i).left a) := by
  rw [patchLeftGenerator, idealPatchInclusion, ← Functor.map_comp,
    chartLeftGenerator_inclusion] <;> rfl

/-- A finite reconstruction in the original projective section ring,
valid for every section on any open contained in the chart. -/
theorem idealCoordinate_reconstruction (i : Fin 3) (V : Surface.Opens)
    (hi : V ≤ Patch i) (s : Γ(idealPatch i, V)) :
    idealCoordinate i V hi s = ∑ q : Fin 3 × Fin 3,
      sectionLeft i V hi q.1 * patchMap (patchFrameCoefficient i q) V hi s := by
  let ev : (idealPatch i ⟶ patchStructure (Patch i)) →+
      Γ(patchStructure (Patch i), V) :=
    { toFun := fun f => f.app V s
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  calc
    _ = patchSectionsEquiv (Patch i) V hi
        (ev (∑ q : Fin 3 × Fin 3,
          patchFrameCoefficient i q ≫ patchScalar i ((chartFactorData i).left q.1))) :=
      congrArg (patchSectionsEquiv (Patch i) V hi)
        (congrArg ev (idealPatchInclusion_frame i))
    _ = ∑ q : Fin 3 × Fin 3, patchSectionsEquiv (Patch i) V hi
        ((patchScalar i ((chartFactorData i).left q.1)).app V
          ((patchFrameCoefficient i q).app V s)) := by
      rw [map_sum, map_sum] <;> rfl
    _ = _ := by
      apply Finset.sum_congr rfl
      intro q _
      exact patchScalar_coordinate i V hi ((chartFactorData i).left q.1) _

def generatorSection (i : Fin 3) (V : Surface.Opens) (hi : V ≤ Patch i)
    (a : Fin 3) : Γ(idealPatch i, V) :=
  (patchLeftGenerator i a).app V ((patchSectionsEquiv (Patch i) V hi).symm 1)

theorem generatorSection_coordinate (i : Fin 3) (V : Surface.Opens)
    (hi : V ≤ Patch i) (a : Fin 3) :
    idealCoordinate i V hi (generatorSection i V hi a) = sectionLeft i V hi a := by
  have h := congrArg
    (fun f : patchStructure (Patch i) ⟶ patchStructure (Patch i) =>
      patchSectionsEquiv (Patch i) V hi
        (f.app V ((patchSectionsEquiv (Patch i) V hi).symm 1)))
    (patchLeftGenerator_inclusion i a)
  change idealCoordinate i V hi (generatorSection i V hi a) =
    patchSectionsEquiv (Patch i) V hi
      ((patchScalar i ((chartFactorData i).left a)).app V
        ((patchSectionsEquiv (Patch i) V hi).symm 1)) at h
  rw [patchScalar_coordinate, RingEquiv.apply_symm_apply, mul_one] at h
  exact h

/-- The section image is generated by the three actual left sections.
The dual-frame proof gives this on arbitrary, possibly nonaffine opens. -/
theorem idealCoordinate_range_span (i : Fin 3) (V : Surface.Opens)
    (hi : V ≤ Patch i) :
    LinearMap.range (idealCoordinate i V hi) =
      Ideal.span (Set.range (sectionLeft i V hi)) := by
  apply le_antisymm
  · rintro _ ⟨s, rfl⟩
    rw [idealCoordinate_reconstruction]
    apply Ideal.sum_mem
    intro q _
    rw [mul_comm]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨q.1, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact ⟨generatorSection i V hi a, generatorSection_coordinate i V hi a⟩

theorem sectionLeft_span_eq (i j : Fin 3) (V : Surface.Opens)
    (hi : V ≤ Patch i) (hj : V ≤ Patch j) :
    Ideal.span (Set.range (sectionLeft i V hi)) =
      Ideal.span (Set.range (sectionLeft j V hj)) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    have h := congrFun (sectionLeft_change j i V hj hi) a
    change sectionLeft i V hi a =
      (transitionUnit j i V hj hi : Γ(Surface, V)) ^ 10 * sectionLeft j V hj a at h
    rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    have h := congrFun (sectionLeft_change i j V hi hj) a
    change sectionLeft j V hj a =
      (transitionUnit i j V hi hj : Γ(Surface, V)) ^ 10 * sectionLeft i V hi a at h
    rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a, rfl⟩)

/-- CLOSED SOURCE-LEVEL ENDPOINT: the literal original ideal inclusions
have the same range on every common original projective subopen. -/
theorem idealCoordinate_range_eq (i j : Fin 3) (V : Surface.Opens)
    (hi : V ≤ Patch i) (hj : V ≤ Patch j) :
    LinearMap.range (idealCoordinate i V hi) =
      LinearMap.range (idealCoordinate j V hj) := by
  rw [idealCoordinate_range_span, idealCoordinate_range_span]
  exact sectionLeft_span_eq i j V hi hj

end CycleQ2SeedSectionSheafIdealOverlap


import Proposal.GeometricLiteralProjectiveIntersections

/-!
# Faithful epsilon coefficients on the actual finite chart intersections

The native reduction is the original graded reduction on the literal
product denominator. Its kernel and epsilon annihilator are computed
with all localization torsion retained. The faithful coefficient module
is the genuine reduced intersection ring with its genuine reduced action.

Prepared for fqlx with OpenAI ChatGPT assistance; see solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2LiteralProjectiveIntersectionKernel

open HomogeneousLocalization CycleQ2CartierSurfaceGrading CycleQ2ProjectiveCartierIdeal
  CycleQ2GeometricSeedNormalIdeals CycleQ2LiteralGradedDeformation
  CycleQ2LiteralGradedReduction CycleQ2LiteralProjectiveDeformation CycleQ2LiteralProjectiveIntersections

/-- The original epsilon is already homogeneous of degree zero. -/
def nativeEpsilon (s : Finset Vertex) : ThickRing s :=
  fromZeroRingHom deformationGrade (Submonoid.powers (thickProduct s))
    ⟨epsilonElement, epsilonElement_mem_grade⟩

theorem nativeEpsilon_val (s : Finset Vertex) :
    (nativeEpsilon s).val =
      algebraMap GradedDeformation (Localization.Away (thickProduct s)) epsilonElement := rfl

theorem nativeReduction_mk_eq_zero_iff (s : Finset Vertex) (n : ℕ)
    (p : GradedDeformation) (hp : p ∈ deformationGrade (n • (productDegree s))) :
    nativeReduction s (Away.mk deformationGrade (thickProduct_homogeneous s) n p hp) = 0 ↔
      ∃ k : ℕ, reduction (thickProduct s ^ k * p) = 0 := by
  rw [nativeReduction_mk, HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_zero,
    Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
  constructor
  · rintro ⟨⟨b,hb⟩,hz⟩
    obtain ⟨k,rfl⟩ := hb
    refine ⟨k, ?_⟩
    rw [map_mul, map_pow]
    change reductionGraded (thickProduct s) ^ k * reduction p = 0
    rw [reduction_thickProduct]
    exact hz
  · rintro ⟨k,hk⟩
    refine ⟨⟨closedProduct s ^ k,
      Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩, ?_⟩
    rw [map_mul, map_pow] at hk
    change reductionGraded (thickProduct s) ^ k * reduction p = 0 at hk
    rwa [reduction_thickProduct] at hk

theorem nativeKernel_eq_comap (s : Finset Vertex) :
    RingHom.ker (nativeReduction s) =
      ((RingHom.ker reduction.toRingHom).map
        (algebraMap GradedDeformation (Localization.Away (thickProduct s)))).comap
        (algebraMap (ThickRing s) (Localization.Away (thickProduct s))) := by
  ext x
  obtain ⟨n,p,hp,rfl⟩ := Away.mk_surjective deformationGrade (thickProduct_homogeneous s) x
  change nativeReduction s (Away.mk deformationGrade (thickProduct_homogeneous s) n p hp) = 0 ↔ _
  rw [nativeReduction_mk_eq_zero_iff]
  change (∃ k : ℕ, reduction (thickProduct s ^ k * p) = 0) ↔
    (Away.mk deformationGrade (thickProduct_homogeneous s) n p hp).val ∈
      (RingHom.ker reduction.toRingHom).map
        (algebraMap GradedDeformation (Localization.Away (thickProduct s)))
  rw [Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_mem_map_algebraMap_iff]
  constructor
  · rintro ⟨k,hk⟩
    exact ⟨thickProduct s ^ k, ⟨k,rfl⟩, hk⟩
  · rintro ⟨t,⟨k,rfl⟩,hk⟩
    exact ⟨k,hk⟩

/-- The actual native kernel is generated by the original epsilon. -/
theorem nativeKernel_principal (s : Finset Vertex) :
    RingHom.ker (nativeReduction s) = Ideal.span ({nativeEpsilon s} : Set (ThickRing s)) := by
  rw [nativeKernel_eq_comap, reduction_kernel_principal, Ideal.map_span, Set.image_singleton,
    ← nativeEpsilon_val]
  exact CycleQ2GradedLocalizationProjection.principalIdeal_comap_val deformationGrade
    (thickProduct_homogeneous s) (nativeEpsilon s)

/-- No cancellation of chart denominators is assumed: the two sides use
exactly the same surviving localization torsion. -/
theorem nativeEpsilon_mul_eq_zero_iff (s : Finset Vertex) (x : ThickRing s) :
    nativeEpsilon s * x = 0 ↔ nativeReduction s x = 0 := by
  obtain ⟨n,p,hp,rfl⟩ := Away.mk_surjective deformationGrade (thickProduct_homogeneous s) x
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.val_zero, nativeEpsilon_val, Away.val_mk, Localization.mk_eq_mk',
    IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_zero_iff,
    nativeReduction_mk_eq_zero_iff]
  constructor
  · rintro ⟨⟨b,hb⟩,hz⟩
    obtain ⟨k,rfl⟩ := hb
    refine ⟨k, (epsilon_mul_eq_zero_iff _).mp ?_⟩
    simpa only [mul_assoc, mul_comm, mul_left_comm] using hz
  · rintro ⟨k,hk⟩
    refine ⟨⟨thickProduct s ^ k,
      Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩, ?_⟩
    have hz := (epsilon_mul_eq_zero_iff _).mpr hk
    simpa only [mul_assoc, mul_comm, mul_left_comm] using hz

theorem nativeReduction_epsilon (s : Finset Vertex) :
    nativeReduction s (nativeEpsilon s) = 0 := by
  apply (nativeEpsilon_mul_eq_zero_iff s _).mp
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_zero, nativeEpsilon_val,
    ← map_mul, epsilonElement_square, map_zero]

theorem nativeKernel_mul_zero (s : Finset Vertex) (x y : ThickRing s)
    (hx : nativeReduction s x = 0) (hy : nativeReduction s y = 0) : x * y = 0 := by
  have hx' : x ∈ Ideal.span ({nativeEpsilon s} : Set (ThickRing s)) := by
    rw [← nativeKernel_principal]
    exact hx
  obtain ⟨z,rfl⟩ := Ideal.mem_span_singleton'.mp hx'
  rw [mul_assoc, (nativeEpsilon_mul_eq_zero_iff s y).mpr hy, mul_zero]

/-- A lift is used only to define the coefficient map. Its independence
is proved from the actual annihilator identity below. -/
def nativeLift (s : Finset Vertex) (x : ClosedRing s) : ThickRing s :=
  (nativeReduction_surjective s x).choose

theorem nativeLift_reduction (s : Finset Vertex) (x : ClosedRing s) :
    nativeReduction s (nativeLift s x) = x := (nativeReduction_surjective s x).choose_spec

def epsilonCoefficient (s : Finset Vertex) (x : ClosedRing s) : ThickRing s :=
  nativeEpsilon s * nativeLift s x

theorem epsilonCoefficient_of_reduction (s : Finset Vertex) (x : ThickRing s) :
    epsilonCoefficient s (nativeReduction s x) = nativeEpsilon s * x := by
  apply sub_eq_zero.mp
  rw [epsilonCoefficient, ← mul_sub, nativeEpsilon_mul_eq_zero_iff,
    map_sub, nativeLift_reduction, sub_self]

theorem reduction_epsilonCoefficient (s : Finset Vertex) (x : ClosedRing s) :
    nativeReduction s (epsilonCoefficient s x) = 0 := by
  rw [epsilonCoefficient, map_mul, nativeReduction_epsilon, zero_mul]

local instance nativeReductionAlgebra (s : Finset Vertex) :
    Algebra (ThickRing s) (ClosedRing s) := (nativeReduction s).toAlgebra

def epsilonLinear (s : Finset Vertex) : ClosedRing s →ₗ[ThickRing s] ThickRing s where
  toFun := epsilonCoefficient s
  map_add' x y := by
    obtain ⟨u,rfl⟩ := nativeReduction_surjective s x
    obtain ⟨v,rfl⟩ := nativeReduction_surjective s y
    rw [← map_add, epsilonCoefficient_of_reduction, epsilonCoefficient_of_reduction,
      epsilonCoefficient_of_reduction, mul_add]
  map_smul' z x := by
    obtain ⟨u,rfl⟩ := nativeReduction_surjective s x
    change epsilonCoefficient s (nativeReduction s z * nativeReduction s u) =
      z * epsilonCoefficient s (nativeReduction s u)
    rw [← map_mul, epsilonCoefficient_of_reduction, epsilonCoefficient_of_reduction]
    ring

theorem epsilonCoefficient_injective (s : Finset Vertex) :
    Function.Injective (epsilonCoefficient s) := by
  intro x y hxy
  apply sub_eq_zero.mp
  obtain ⟨u,hu⟩ := nativeReduction_surjective s (x - y)
  rw [← hu]
  apply (nativeEpsilon_mul_eq_zero_iff s u).mp
  rw [← epsilonCoefficient_of_reduction, hu]
  change epsilonLinear s (x - y) = 0
  rw [map_sub]
  exact sub_eq_zero.mpr hxy

/-- The faithful coefficient module is the original reduced chart ring,
with exactly the scalar action induced by the original reduction. -/
def epsilonKernelEquiv (s : Finset Vertex) :
    ClosedRing s ≃ₗ[ThickRing s] RingHom.ker (nativeReduction s) :=
  LinearEquiv.ofBijective
    ((epsilonLinear s).codRestrict _ (reduction_epsilonCoefficient s)) (by
      constructor
      · intro x y hxy
        exact epsilonCoefficient_injective s (congrArg Subtype.val hxy)
      · rintro ⟨z,hz⟩
        have hm : z ∈ Ideal.span ({nativeEpsilon s} : Set (ThickRing s)) := by
          rw [← nativeKernel_principal]
          exact hz
        obtain ⟨u,hu⟩ := Ideal.mem_span_singleton'.mp hm
        refine ⟨nativeReduction s u, Subtype.ext ?_⟩
        change epsilonCoefficient s (nativeReduction s u) = z
        rw [epsilonCoefficient_of_reduction, mul_comm, hu])

end CycleQ2LiteralProjectiveIntersectionKernel

end

#print axioms CycleQ2LiteralProjectiveIntersectionKernel.nativeKernel_principal
#print axioms CycleQ2LiteralProjectiveIntersectionKernel.nativeEpsilon_mul_eq_zero_iff
#print axioms CycleQ2LiteralProjectiveIntersectionKernel.epsilonKernelEquiv

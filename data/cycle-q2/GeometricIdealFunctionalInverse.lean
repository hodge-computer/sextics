import Mathlib.RingTheory.Ideal.Operations
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Inverting an ideal functional with a unit-value witness

For an ideal I in a commutative ring, an R-linear functional from I to R
that takes some q to one is already an isomorphism. Linearity and
commutativity force x = q * phi(x) for every x in I. This also makes the
unit-value witness unique, and identifies the ideal with the principal
ideal generated by q.

This elementary result is intended for the actual image/dual-orbit-ideal
comparison. It does not assert that the original section's functional is
surjective: obtaining that witness from emptiness and binding its degree
and transition still require the separate geometric constructions.

Source-only draft: no Lean elaboration or kernel replay has been run.
Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md for
attribution of the geometric strategy and the protected certificate gap.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section

namespace CycleQ2IdealFunctionalInverse

variable {R : Type*} [CommRing R] {I : Ideal R} (phi : I →ₗ[R] R)

theorem mul_apply_comm (x y : I) :
    (x : R) * phi y = (y : R) * phi x := by
  have h : (x : R) • y = (y : R) • x := by
    apply Subtype.ext
    change (x : R) * (y : R) = (y : R) * (x : R)
    exact mul_comm _ _
  simpa only [map_smul, smul_eq_mul] using congrArg phi h

variable (q : I) (hq : phi q = 1)

include phi q hq

theorem val_eq_generator_mul (x : I) : (x : R) = (q : R) * phi x := by
  simpa only [hq, mul_one] using mul_apply_comm phi x q

theorem generator_smul_apply (x : I) : phi x • q = x := by
  apply Subtype.ext
  change phi x * (q : R) = (x : R)
  rw [mul_comm]
  exact (val_eq_generator_mul phi q hq x).symm

theorem apply_injective : Function.Injective phi := by
  intro x y h
  rw [← generator_smul_apply phi q hq x, ← generator_smul_apply phi q hq y, h]

theorem apply_surjective : Function.Surjective phi := by
  intro r
  exact ⟨r • q, by simp only [map_smul, hq, smul_eq_mul, mul_one]⟩

theorem unitValue_unique (q' : I) (hq' : phi q' = 1) : q' = q :=
  apply_injective phi q hq (hq'.trans hq.symm)

def functionalEquiv : I ≃ₗ[R] R :=
  LinearEquiv.ofBijective phi ⟨apply_injective phi q hq, apply_surjective phi q hq⟩

@[simp] theorem functionalEquiv_apply (x : I) : functionalEquiv phi q hq x = phi x := rfl

theorem functionalEquiv_symm_apply (r : R) :
    (functionalEquiv phi q hq).symm r = r • q := by
  apply (functionalEquiv phi q hq).injective
  simp only [LinearEquiv.apply_symm_apply, functionalEquiv_apply,
    map_smul, hq, smul_eq_mul, mul_one]

theorem ideal_eq_span_generator : I = Ideal.span {(q : R)} := by
  apply le_antisymm
  · intro x hx
    exact Ideal.mem_span_singleton.mpr
      ⟨phi ⟨x, hx⟩, val_eq_generator_mul phi q hq ⟨x, hx⟩⟩
  · exact (Ideal.span_singleton_le_iff_mem I).mpr q.property

#print axioms functionalEquiv
#print axioms unitValue_unique
#print axioms ideal_eq_span_generator

end CycleQ2IdealFunctionalInverse
end

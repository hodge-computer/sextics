/- Component: continuation_20261112/SeedNormalRestriction.lean -/
section
/-!
# Restriction and exactness for the genuine seed normal map

Restriction of normal homomorphisms is scalar extension of Hom, defined
through the tensor-Hom adjunction. It commutes with the dual of the actual
natural cotangent map. On either denominator chart, the actual kernel is
freely generated by the equation vector (g2,-g1,0), and this generator is
compatible with every algebra restriction. No independent normal matrix
or connecting-class comparison is assumed.
-/

noncomputable section
open scoped TensorProduct
set_option autoImplicit false
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false

namespace CycleQ2NormalRestriction

open CycleQ2ConormalJacobian CycleQ2NaturalNormalMap
  CycleQ2NormalConnecting CycleQ2SeedTrace CycleQ2GenuineNormalConnecting

section Restriction

variable {S T : Type*} [CommRing S] [CommRing T]
  [Algebra P S] [Algebra P T]

/-- Canonical restriction of genuine normal homomorphisms. -/
def normalRestriction (I : Ideal P) (f : S →ₐ[P] T) :
    (S ⊗[P] I.Cotangent →ₗ[S] S) →ₗ[P]
      (T ⊗[P] I.Cotangent →ₗ[T] T) :=
  (((LinearMap.liftBaseChangeEquiv T).restrictScalars P).toLinearMap).comp
    ((LinearMap.compRight P f.toLinearMap).comp
      (((LinearMap.liftBaseChangeEquiv S).symm.restrictScalars P).toLinearMap))

@[simp] theorem normalRestriction_tmul (I : Ideal P) (f : S →ₐ[P] T)
    (φ : S ⊗[P] I.Cotangent →ₗ[S] S) (t : T) (x : I.Cotangent) :
    normalRestriction I f φ (t ⊗ₜ[P] x) = t * f (φ ((1 : S) ⊗ₜ[P] x)) := by
  simp [normalRestriction, LinearMap.comp_apply, smul_eq_mul]

abbrev curveRestriction (r θ : ℂ) (f : S →ₐ[P] T) :
    CurveNormal (S := S) r θ →ₗ[P] CurveNormal (S := T) r θ :=
  normalRestriction (ambientCurveIdeal r θ) f

abbrev surfaceRestriction (r θ : ℂ) (f : S →ₐ[P] T) :
    SurfaceNormal (S := S) r θ →ₗ[P] SurfaceNormal (S := T) r θ :=
  normalRestriction (surfaceIdeal r θ) f

@[simp] theorem curveRestriction_class (r θ : ℂ) (f : S →ₐ[P] T)
    (φ : CurveNormal (S := S) r θ) (i : Fin 3) :
    curveRestriction r θ f φ (curveClass r θ i) = f (φ (curveClass r θ i)) := by
  simp [curveClass]

@[simp] theorem surfaceRestriction_class (r θ : ℂ) (f : S →ₐ[P] T)
    (φ : SurfaceNormal (S := S) r θ) (i : Fin 2) :
    surfaceRestriction r θ f φ (surfaceClass r θ i) = f (φ (surfaceClass r θ i)) := by
  simp [surfaceClass, generator]

/-- The square of actual natural dual maps and canonical Hom restrictions
commutes before any equation coordinates are chosen. -/
theorem naturalNormalMap_restriction (r θ : ℂ) (f : S →ₐ[P] T)
    (φ : CurveNormal (S := S) r θ) :
    naturalNormalMap r θ (curveRestriction r θ f φ) =
      surfaceRestriction r θ f (naturalNormalMap r θ φ) := by
  apply TensorProduct.AlgebraTensorModule.ext
  intro t x
  simp only [naturalNormalMap, LinearMap.dualMap_apply,
    baseChangedNaturalCotangentMap, LinearMap.baseChange_tmul,
    curveRestriction, surfaceRestriction, normalRestriction_tmul]

end Restriction

section Kernel

variable {S : Type*} [CommRing S] [Algebra P S] [Algebra ℂ S]
  [IsScalarTower ℂ P S]

abbrev NormalKernel (r θ : ℂ) :=
  LinearMap.ker (naturalNormalMap (S := S) r θ)

variable (r θ : ℂ)
variable (b : Module.Basis (Fin 3) S (CurveConormal (S := S) r θ))
variable (hb : ∀ i, b i = curveClass r θ i)

include hb in
/-- Vanishing under the genuine normal map is exactly vanishing of the
checked equation matrix in the genuine equation-class basis. -/
theorem naturalNormalMap_eq_zero_iff (φ : CurveNormal (S := S) r θ) :
    naturalNormalMap r θ φ = 0 ↔
      equationMap (algebraMap P S (originalG1 r)) (algebraMap P S originalG2)
        (algebraMap P S (thetaK θ)) ((fromCoordinates r θ b).symm φ) = 0 := by
  have h := naturalNormalMap_fromCoordinates r θ b hb ((fromCoordinates r θ b).symm φ)
  simp only [LinearEquiv.apply_symm_apply] at h
  constructor
  · intro hz
    rw [hz] at h
    funext j
    simpa only [LinearMap.zero_apply, Pi.zero_apply] using congrFun h.symm j
  · intro hz
    apply surfaceNormal_ext r θ
    intro j
    rw [hz] at h
    exact congrFun h j

include hb in
theorem genuine_kernel_first (u : Sˣ)
    (hu : (u : S) = algebraMap P S (originalG1 r)) (φ : CurveNormal (S := S) r θ) :
    naturalNormalMap r θ φ = 0 ↔
      ∃ c : S, φ = c • genuineKernelGenerator r θ b := by
  rw [naturalNormalMap_eq_zero_iff r θ b hb, ← hu, equationMap_kernel_first]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    have hh := congrArg (fromCoordinates r θ b) hc
    simpa [genuineKernelGenerator, hu] using hh
  · rintro ⟨c, rfl⟩
    refine ⟨c, ?_⟩
    simp [genuineKernelGenerator, hu]

/-- The complementary local matrix calculation needed on the g2 chart. -/
theorem equationMap_kernel_second (u : Sˣ) (g1 k : S) (v : Fin 3 → S) :
    equationMap g1 (u : S) k v = 0 ↔
      ∃ c : S, v = c • kernelVector g1 (u : S) := by
  constructor
  · intro hv
    have h0 := congrFun hv 0
    have h2 := congrFun hv 1
    change g1 * v 0 + (u : S) * v 1 + k * v 2 = 0 at h0
    change v 2 = 0 at h2
    refine ⟨v 0 * (↑(u⁻¹) : S), ?_⟩
    funext i
    fin_cases i
    · simp [kernelVector, smul_eq_mul, mul_assoc]
    · change v 1 = v 0 * (↑(u⁻¹) : S) * (-g1)
      rw [h2] at h0
      linear_combination (↑(u⁻¹) : S) * h0 - v 1 * u.inv_mul
    · simpa [kernelVector] using h2
  · rintro ⟨c, rfl⟩
    rw [map_smul, equationMap_kernelVector, smul_zero]

include hb in
theorem genuine_kernel_second (u : Sˣ)
    (hu : (u : S) = algebraMap P S originalG2) (φ : CurveNormal (S := S) r θ) :
    naturalNormalMap r θ φ = 0 ↔
      ∃ c : S, φ = c • genuineKernelGenerator r θ b := by
  rw [naturalNormalMap_eq_zero_iff r θ b hb, ← hu, equationMap_kernel_second]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    have hh := congrArg (fromCoordinates r θ b) hc
    simpa [genuineKernelGenerator, hu] using hh
  · rintro ⟨c, rfl⟩
    refine ⟨c, ?_⟩
    simp [genuineKernelGenerator, hu]

/-- The same intrinsic kernel generator is used on both opens. -/
def kernelParam : S →ₗ[S] NormalKernel (S := S) r θ where
  toFun c := ⟨c • genuineKernelGenerator r θ b, by
    change naturalNormalMap r θ (c • genuineKernelGenerator r θ b) = 0
    rw [map_smul, genuineKernelGenerator_mem r θ b hb, smul_zero]⟩
  map_add' c d := by apply Subtype.ext; simp [add_smul]
  map_smul' c d := by apply Subtype.ext; simp [smul_smul]

@[simp] theorem kernelParam_val (c : S) :
    (kernelParam r θ b hb c).val = c • genuineKernelGenerator r θ b := rfl

include hb in
theorem kernelParam_bijective_first (u : Sˣ)
    (hu : (u : S) = algebraMap P S (originalG1 r)) :
    Function.Bijective (kernelParam r θ b hb) := by
  constructor
  · intro c d h
    have hh := congrArg (fun z : NormalKernel (S := S) r θ =>
      kernelCoefficient r θ u z.val) h
    simpa only [kernelParam_val, kernelCoefficient_generator r θ b hb u hu] using hh
  · intro φ
    obtain ⟨c, hc⟩ := (genuine_kernel_first r θ b hb u hu φ.val).mp φ.property
    exact ⟨c, Subtype.ext hc.symm⟩

include hb in
theorem kernelParam_bijective_second (u : Sˣ)
    (hu : (u : S) = algebraMap P S originalG2) :
    Function.Bijective (kernelParam r θ b hb) := by
  constructor
  · intro c d h
    have hh := congrArg (fun z : NormalKernel (S := S) r θ =>
      z.val (curveClass r θ 0) * (↑(u⁻¹) : S)) h
    simp only [kernelParam_val, LinearMap.smul_apply, smul_eq_mul,
      genuineKernelGenerator, fromCoordinates_class r θ b hb] at hh
    change c * algebraMap P S originalG2 * (↑(u⁻¹) : S) =
      d * algebraMap P S originalG2 * (↑(u⁻¹) : S) at hh
    simpa [← hu, mul_assoc] using hh
  · intro φ
    obtain ⟨c, hc⟩ := (genuine_kernel_second r θ b hb u hu φ.val).mp φ.property
    exact ⟨c, Subtype.ext hc.symm⟩

/-- Genuine rank-one trivialization on the first denominator chart. -/
def firstKernelEquiv (u : Sˣ)
    (hu : (u : S) = algebraMap P S (originalG1 r)) :
    S ≃ₗ[S] NormalKernel (S := S) r θ :=
  LinearEquiv.ofBijective (kernelParam r θ b hb)
    (kernelParam_bijective_first r θ b hb u hu)

/-- The same generator gives the complementary chart trivialization. -/
def secondKernelEquiv (u : Sˣ)
    (hu : (u : S) = algebraMap P S originalG2) :
    S ≃ₗ[S] NormalKernel (S := S) r θ :=
  LinearEquiv.ofBijective (kernelParam r θ b hb)
    (kernelParam_bijective_second r θ b hb u hu)

@[simp] theorem firstKernelEquiv_apply (u : Sˣ)
    (hu : (u : S) = algebraMap P S (originalG1 r)) (c : S) :
    firstKernelEquiv r θ b hb u hu c = kernelParam r θ b hb c := rfl

@[simp] theorem secondKernelEquiv_apply (u : Sˣ)
    (hu : (u : S) = algebraMap P S originalG2) (c : S) :
    secondKernelEquiv r θ b hb u hu c = kernelParam r θ b hb c := rfl

end Kernel

section KernelRestriction

variable {S T : Type*} [CommRing S] [CommRing T]
  [Algebra P S] [Algebra P T]
  [Algebra ℂ S] [Algebra ℂ T] [IsScalarTower ℂ P S] [IsScalarTower ℂ P T]

/-- Canonical restriction on the kernel of the actual natural normal map. -/
def kernelRestriction (r θ : ℂ) (f : S →ₐ[P] T) :
    NormalKernel (S := S) r θ →ₗ[P] NormalKernel (S := T) r θ where
  toFun φ := ⟨curveRestriction r θ f φ.val, by
    change naturalNormalMap r θ (curveRestriction r θ f φ.val) = 0
    rw [naturalNormalMap_restriction, φ.property, map_zero]⟩
  map_add' φ ψ := by apply Subtype.ext; exact map_add _ _ _
  map_smul' c φ := by apply Subtype.ext; exact map_smul _ _ _

@[simp] theorem kernelRestriction_val (r θ : ℂ) (f : S →ₐ[P] T)
    (φ : NormalKernel (S := S) r θ) :
    (kernelRestriction r θ f φ).val = curveRestriction r θ f φ.val := rfl

/-- The coordinate constructor respects the canonical tensor-Hom restriction. -/
theorem fromCoordinates_restriction (r θ : ℂ) (f : S →ₐ[P] T)
    (bS : Module.Basis (Fin 3) S (CurveConormal (S := S) r θ))
    (hS : ∀ i, bS i = curveClass r θ i)
    (bT : Module.Basis (Fin 3) T (CurveConormal (S := T) r θ))
    (hT : ∀ i, bT i = curveClass r θ i) (v : Fin 3 → S) :
    curveRestriction r θ f (fromCoordinates r θ bS v) =
      fromCoordinates r θ bT (fun i => f (v i)) := by
  apply curveNormal_ext r θ
  intro i
  rw [curveRestriction_class, fromCoordinates_class r θ bS hS,
    fromCoordinates_class r θ bT hT]

/-- The scalar kernel trivializations commute with every actual algebra
restriction. This is the compatibility needed for the two-open Cech quotient. -/
theorem kernelParam_restriction (r θ : ℂ) (f : S →ₐ[P] T)
    (bS : Module.Basis (Fin 3) S (CurveConormal (S := S) r θ))
    (hS : ∀ i, bS i = curveClass r θ i)
    (bT : Module.Basis (Fin 3) T (CurveConormal (S := T) r θ))
    (hT : ∀ i, bT i = curveClass r θ i) (c : S) :
    kernelRestriction r θ f (kernelParam r θ bS hS c) =
      kernelParam r θ bT hT (f c) := by
  apply Subtype.ext
  apply curveNormal_ext r θ
  intro i
  simp only [kernelRestriction_val, kernelParam_val, curveRestriction_class,
    LinearMap.smul_apply, genuineKernelGenerator, fromCoordinates_class r θ bS hS,
    fromCoordinates_class r θ bT hT, smul_eq_mul]
  fin_cases i <;>
    simp [kernelVector, map_mul, AlgHom.commutes]

end KernelRestriction
end CycleQ2NormalRestriction

#print axioms CycleQ2NormalRestriction.naturalNormalMap_restriction
#print axioms CycleQ2NormalRestriction.firstKernelEquiv
#print axioms CycleQ2NormalRestriction.secondKernelEquiv
#print axioms CycleQ2NormalRestriction.kernelParam_restriction
end
end


/- Component: continuation_20261112/UniversalSurfaceLocalizedBasis.lean -/
section
/-! # The actual localized universal surface quotient in the nine Laurent coordinates -/

noncomputable section
set_option maxHeartbeats 2000000
set_option maxRecDepth 20000
set_option backward.isDefEq.respectTransparency false

namespace CycleQ2UniversalSurfaceLocalizedBasis

open MvPolynomial CycleQ2IncidenceNormalForm CycleQ2UniversalSurface
  CycleQ2SeedQuotientFiniteFree
  CycleQ2SeedCechThreeOpen CycleQ2SeedCechLocalization

variable (R : Type*) [CommRing R]

abbrev SurfaceLocal (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3)) :=
  Localization (Algebra.algebraMapSubmonoid (SurfaceRing R hcoeff Fcoeff)
    (Submonoid.powers (baseProduct R s)))

instance surfaceLocalBaseAlgebra (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3)) :
    Algebra (coordinateLocalization R s) (SurfaceLocal R hcoeff Fcoeff s) :=
  localizationAlgebra (Rₘ := coordinateLocalization R s) (Sₘ := SurfaceLocal R hcoeff Fcoeff s)
    (Submonoid.powers (baseProduct R s)) (SurfaceRing R hcoeff Fcoeff)

instance surfaceLocalBaseTower (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3)) :
    IsScalarTower (Base R) (coordinateLocalization R s) (SurfaceLocal R hcoeff Fcoeff s) :=
  isScalarTower_localizationAlgebra (Rₘ := coordinateLocalization R s)
    (Sₘ := SurfaceLocal R hcoeff Fcoeff s) (Submonoid.powers (baseProduct R s)) (SurfaceRing R hcoeff Fcoeff)

def localizedBasis [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3)) :
    Module.Basis ShiftIndex (coordinateLocalization R s) (SurfaceLocal R hcoeff Fcoeff s) :=
  (surfaceBasis R hcoeff Fcoeff).localizationLocalization (coordinateLocalization R s)
    (Submonoid.powers (baseProduct R s)) (SurfaceLocal R hcoeff Fcoeff s)

@[simp] theorem localizedBasis_apply [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (s : Finset (Fin 3)) (ab : ShiftIndex) :
    localizedBasis R hcoeff Fcoeff s ab = algebraMap (SurfaceRing R hcoeff Fcoeff) (SurfaceLocal R hcoeff Fcoeff s)
      (surfaceBasis R hcoeff Fcoeff ab) := by
  exact Module.Basis.localizationLocalization_apply _ _ _ _ _

@[simp] theorem localizedBasis_repr_algebraMap [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (s : Finset (Fin 3)) (p : SurfaceRing R hcoeff Fcoeff) (ab : ShiftIndex) :
    (localizedBasis R hcoeff Fcoeff s).repr (algebraMap (SurfaceRing R hcoeff Fcoeff) (SurfaceLocal R hcoeff Fcoeff s) p) ab =
      algebraMap (Base R) (coordinateLocalization R s) ((surfaceBasis R hcoeff Fcoeff).repr p ab) := by
  exact Module.Basis.localizationLocalization_repr_algebraMap _ _ _ _ _ _

def localizedCoordinates [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3)) :
    SurfaceLocal R hcoeff Fcoeff s →+ (ShiftIndex → Laurent (R := R)) where
  toFun p ab := localizationToLaurent R s ((localizedBasis R hcoeff Fcoeff s).repr p ab)
  map_zero' := by ext ab; simp
  map_add' p q := by ext ab; simp

theorem localizedCoordinates_injective [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3)) :
    Function.Injective (localizedCoordinates R hcoeff Fcoeff s) := by
  intro p q hpq
  apply (localizedBasis R hcoeff Fcoeff s).repr.injective
  ext ab
  exact localizationToLaurent_injective R s (congrFun hpq ab)

theorem localizedCoordinates_hasPoles [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3))
    (p : SurfaceLocal R hcoeff Fcoeff s) (ab : ShiftIndex) :
    HasPoles s (localizedCoordinates R hcoeff Fcoeff s p ab) :=
  localizationToLaurent_hasPoles R s _

theorem mem_range_localizedCoordinates [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (s : Finset (Fin 3))
    (p : ShiftIndex → Laurent (R := R)) :
    p ∈ Set.range (localizedCoordinates R hcoeff Fcoeff s) ↔ ∀ ab, HasPoles s (p ab) := by
  constructor
  · rintro ⟨p, rfl⟩ ab
    exact localizedCoordinates_hasPoles R hcoeff Fcoeff s p ab
  · intro hp
    choose a ha using fun ab ↦ (mem_range_localizationToLaurent R s (p ab)).mpr (hp ab)
    refine ⟨(localizedBasis R hcoeff Fcoeff s).repr.symm (Finsupp.equivFunOnFinite.symm a), ?_⟩
    funext ab
    change localizationToLaurent R s
      ((localizedBasis R hcoeff Fcoeff s).repr ((localizedBasis R hcoeff Fcoeff s).repr.symm
        (Finsupp.equivFunOnFinite.symm a)) ab) = p ab
    simpa using ha ab

@[simp] theorem localizedCoordinates_algebraMap [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (s : Finset (Fin 3)) (p : SurfaceRing R hcoeff Fcoeff) (ab : ShiftIndex) :
    localizedCoordinates R hcoeff Fcoeff s (algebraMap (SurfaceRing R hcoeff Fcoeff) (SurfaceLocal R hcoeff Fcoeff s) p) ab =
      baseToLaurent R ((surfaceBasis R hcoeff Fcoeff).repr p ab) := by
  simp [localizedCoordinates]

@[simp] theorem localizedCoordinates_smul [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (s : Finset (Fin 3)) (a : coordinateLocalization R s) (p : SurfaceLocal R hcoeff Fcoeff s)
    (ab : ShiftIndex) :
    localizedCoordinates R hcoeff Fcoeff s (a • p) ab =
      localizationToLaurent R s a * localizedCoordinates R hcoeff Fcoeff s p ab := by
  simp [localizedCoordinates, Finsupp.smul_apply, smul_eq_mul]

/-- Exactness of the three-open complex on actual localized universal surface rings,
expressed through their injective common Laurent coordinates. -/
theorem localized_nineSummand_kernel [Nontrivial R] (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R) (g : LaurentGrade)
    (p01 : SurfaceLocal R hcoeff Fcoeff {0, 1}) (p02 : SurfaceLocal R hcoeff Fcoeff {0, 2})
    (p12 : SurfaceLocal R hcoeff Fcoeff {1, 2})
    (hg01 : ∀ ab, HasGrade ab g (localizedCoordinates R hcoeff Fcoeff {0, 1} p01 ab))
    (hg02 : ∀ ab, HasGrade ab g (localizedCoordinates R hcoeff Fcoeff {0, 2} p02 ab))
    (hg12 : ∀ ab, HasGrade ab g (localizedCoordinates R hcoeff Fcoeff {1, 2} p12 ab))
    (hc : ∀ ab, localizedCoordinates R hcoeff Fcoeff {0, 1} p01 ab -
      localizedCoordinates R hcoeff Fcoeff {0, 2} p02 ab +
      localizedCoordinates R hcoeff Fcoeff {1, 2} p12 ab = 0) :
    ∃ (q0 : SurfaceLocal R hcoeff Fcoeff {0}) (q1 : SurfaceLocal R hcoeff Fcoeff {1})
      (q2 : SurfaceLocal R hcoeff Fcoeff {2}),
      (∀ ab, HasGrade ab g (localizedCoordinates R hcoeff Fcoeff {0} q0 ab)) ∧
      (∀ ab, HasGrade ab g (localizedCoordinates R hcoeff Fcoeff {1} q1 ab)) ∧
      (∀ ab, HasGrade ab g (localizedCoordinates R hcoeff Fcoeff {2} q2 ab)) ∧
      (∀ ab, localizedCoordinates R hcoeff Fcoeff {0, 1} p01 ab =
        localizedCoordinates R hcoeff Fcoeff {1} q1 ab - localizedCoordinates R hcoeff Fcoeff {0} q0 ab) ∧
      (∀ ab, localizedCoordinates R hcoeff Fcoeff {0, 2} p02 ab =
        localizedCoordinates R hcoeff Fcoeff {2} q2 ab - localizedCoordinates R hcoeff Fcoeff {0} q0 ab) ∧
      (∀ ab, localizedCoordinates R hcoeff Fcoeff {1, 2} p12 ab =
        localizedCoordinates R hcoeff Fcoeff {2} q2 ab - localizedCoordinates R hcoeff Fcoeff {1} q1 ab) := by
  obtain ⟨q0, q1, q2, h0, h1, h2, hg0, hg1, hg2, he01, he02, he12⟩ :=
    nineSummand_kernel g
      (localizedCoordinates R hcoeff Fcoeff {0, 1} p01)
      (localizedCoordinates R hcoeff Fcoeff {0, 2} p02)
      (localizedCoordinates R hcoeff Fcoeff {1, 2} p12)
      (localizedCoordinates_hasPoles R hcoeff Fcoeff {0, 1} p01)
      (localizedCoordinates_hasPoles R hcoeff Fcoeff {0, 2} p02)
      (localizedCoordinates_hasPoles R hcoeff Fcoeff {1, 2} p12)
      hg01 hg02 hg12 hc
  obtain ⟨q0', hq0⟩ := (mem_range_localizedCoordinates R hcoeff Fcoeff {0} q0).mpr h0
  obtain ⟨q1', hq1⟩ := (mem_range_localizedCoordinates R hcoeff Fcoeff {1} q1).mpr h1
  obtain ⟨q2', hq2⟩ := (mem_range_localizedCoordinates R hcoeff Fcoeff {2} q2).mpr h2
  refine ⟨q0', q1', q2', ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [hq0, hq1, hq2] <;> assumption

end CycleQ2UniversalSurfaceLocalizedBasis

#print axioms CycleQ2UniversalSurfaceLocalizedBasis.mem_range_localizedCoordinates

#print axioms CycleQ2UniversalSurfaceLocalizedBasis.localized_nineSummand_kernel
end
end


/- Component: continuation_20261112/UniversalSurfaceCoordinateCover.lean -/
section
/-!
# The three coordinate charts cover the entire relative projective surface

The three actual opens used by the Cech computation are x1, x2, x3.
They cover every relevant prime of every normalized universal surface,
over any commutative coefficient ring.  No smoothness is required.
This is a statement about the original polynomial quotient and its primes;
it is not yet a comparison with derived sheaf cohomology.
-/

noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false

namespace CycleQ2UniversalSurfaceCoordinateCover

open MvPolynomial CycleQ2IncidenceNormalForm CycleQ2IncidenceEquations
  CycleQ2SeedQuotientFiniteFree CycleQ2UniversalSurface

theorem cubic_tail_has_base_coordinate (e : FullCubicTailIndex) :
    ∃ j : Fin 3, fullExponentOf e.val.val (remainingIndex j) ≠ 0 := by
  by_contra hn
  have hz (j : Fin 3) : fullExponentOf e.val.val (remainingIndex j) = 0 := by
    by_contra hj
    exact hn ⟨j,hj⟩
  have h1 : (e.val.val 1).val = 0 := by simpa [remainingIndex] using hz 0
  have h2 : (e.val.val 2).val = 0 := by simpa [remainingIndex] using hz 1
  have h3 : (e.val.val 3).val = 0 := by simpa [remainingIndex] using hz 2
  have hd := e.val.property.1
  have hc := e.val.property.2
  have ht := e.property
  simp only [fullDegree, fullCharacter] at hd hc
  omega

theorem sextic_tail_has_non_w_coordinate (e : FullSexticTailIndex) :
    ∃ j : Fin 4, fullExponentOf e.val.val j.castSucc ≠ 0 := by
  by_contra hn
  have hz (j : Fin 4) : fullExponentOf e.val.val j.castSucc = 0 := by
    by_contra hj
    exact hn ⟨j,hj⟩
  have h0 : (e.val.val 0).val = 0 := by simpa using hz 0
  have h1 : (e.val.val 1).val = 0 := by simpa using hz 1
  have h2 : (e.val.val 2).val = 0 := by simpa using hz 2
  have h3 : (e.val.val 3).val = 0 := by simpa using hz 3
  have hd := e.val.property.1
  have ht := e.property
  simp only [fullDegree] at hd
  omega

variable {R : Type*} [CommRing R]

theorem all_coordinates_mem_of_base_coordinates
    (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (p : Ideal (Poly R)) [p.IsPrime]
    (hh : normalizedFullCubic hcoeff ∈ p) (hF : normalizedFullSextic Fcoeff ∈ p)
    (hx : ∀ j : Fin 3, X (remainingIndex j) ∈ p) :
    ∀ j : Fin 5, X j ∈ p := by
  classical
  have hctail : (∑ e : FullCubicTailIndex,
      monomial (fullExponentOf e.val.val) (hcoeff e)) ∈ p := by
    apply Ideal.sum_mem
    intro e _
    obtain ⟨j,hj⟩ := cubic_tail_has_base_coordinate e
    exact p.mem_of_dvd (X_dvd_monomial.mpr (Or.inr hj)) (hx j)
  have h0pow : (X 0 : Poly R) ^ 3 ∈ p := by
    simpa only [normalizedFullCubic, add_sub_cancel_right, X_pow_eq_monomial] using
      p.sub_mem hh hctail
  have h0 : (X 0 : Poly R) ∈ p := (inferInstance : p.IsPrime).mem_of_pow_mem 3 h0pow
  have hnonw (j : Fin 4) : (X j.castSucc : Poly R) ∈ p := by
    fin_cases j
    · exact h0
    · exact hx 0
    · exact hx 1
    · exact hx 2
  have hFtail : (∑ e : FullSexticTailIndex,
      monomial (fullExponentOf e.val.val) (Fcoeff e)) ∈ p := by
    apply Ideal.sum_mem
    intro e _
    obtain ⟨j,hj⟩ := sextic_tail_has_non_w_coordinate e
    exact p.mem_of_dvd (X_dvd_monomial.mpr (Or.inr hj)) (hnonw j)
  have h4pow : (X 4 : Poly R) ^ 3 ∈ p := by
    simpa only [normalizedFullSextic, add_sub_cancel_right, X_pow_eq_monomial] using
      p.sub_mem hF hFtail
  have h4 : (X 4 : Poly R) ∈ p := (inferInstance : p.IsPrime).mem_of_pow_mem 3 h4pow
  intro j
  fin_cases j
  · exact h0
  · exact hx 0
  · exact hx 1
  · exact hx 2
  · exact h4

theorem polynomial_prime_coordinate_cover
    (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (p : Ideal (Poly R)) [p.IsPrime]
    (hI : surfaceIdeal R hcoeff Fcoeff ≤ p)
    (hrelevant : ∃ j : Fin 5, X j ∉ p) :
    ∃ j : Fin 3, X (remainingIndex j) ∉ p := by
  by_contra hn
  have hx (j : Fin 3) : (X (remainingIndex j) : Poly R) ∈ p := by
    by_contra hj
    exact hn ⟨j,hj⟩
  have hh := hI (Ideal.subset_span (show normalizedFullCubic hcoeff ∈
    ({normalizedFullCubic hcoeff, normalizedFullSextic Fcoeff} : Set (Poly R)) from
      by simp))
  have hF := hI (Ideal.subset_span (show normalizedFullSextic Fcoeff ∈
    ({normalizedFullCubic hcoeff, normalizedFullSextic Fcoeff} : Set (Poly R)) from
      by simp))
  obtain ⟨j,hj⟩ := hrelevant
  exact hj (all_coordinates_mem_of_base_coordinates hcoeff Fcoeff p hh hF hx j)

/-- Consequently the exact three opens used by the relative Cech model
cover all relevant primes of the actual surface quotient. -/
theorem surface_prime_coordinate_cover
    (hcoeff : FullCubicTailIndex → R) (Fcoeff : FullSexticTailIndex → R)
    (p : Ideal (SurfaceRing R hcoeff Fcoeff)) [p.IsPrime]
    (hrelevant : ∃ j : Fin 5, Ideal.Quotient.mk (surfaceIdeal R hcoeff Fcoeff) (X j) ∉ p) :
    ∃ j : Fin 3, Ideal.Quotient.mk (surfaceIdeal R hcoeff Fcoeff)
      (X (remainingIndex j)) ∉ p := by
  let q : Ideal (Poly R) := p.comap (Ideal.Quotient.mk (surfaceIdeal R hcoeff Fcoeff))
  haveI : q.IsPrime := Ideal.IsPrime.comap _
  have hI : surfaceIdeal R hcoeff Fcoeff ≤ q := by
    intro a ha
    change Ideal.Quotient.mk (surfaceIdeal R hcoeff Fcoeff) a ∈ p
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
    exact p.zero_mem
  exact polynomial_prime_coordinate_cover hcoeff Fcoeff q hI hrelevant

end CycleQ2UniversalSurfaceCoordinateCover

#print axioms CycleQ2UniversalSurfaceCoordinateCover.surface_prime_coordinate_cover
end

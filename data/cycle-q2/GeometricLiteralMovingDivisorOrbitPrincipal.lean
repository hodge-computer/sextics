import Proposal.GeometricLiteralNativeCartierTransitions

/-!
# The two normalized curve equations on every native intersection

The normalized surface equation gives the cofactor syzygy in the degree-zero
ring. Its invertible entry identifies the ideal of the two quadrics with the
principal ideal generated by the native Cartier frame.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2LiteralMovingDivisorOrbitPrincipal

open CycleQ2SeedTrace CycleQ2NormalConnecting CycleQ2GeometricSeedNormalIdeals
  CycleQ2GeometricCartierNormalLift CycleQ2CartierSurfaceGrading
  CycleQ2LiteralGradedDeformation CycleQ2LiteralGradedReduction
  CycleQ2LiteralProjectiveDeformation CycleQ2LiteralProjectiveIntersections
  CycleQ2LiteralNativeHomogeneousFractions CycleQ2LiteralNativeTransitionUnits
  CycleQ2LiteralNativeCartierFrames CycleQ2LiteralNativeCartierTransitions

def normalizedEquation (s : Finset Vertex) (v : Vertex) (hv : v ∈ s) (a : Fin 4) : ClosedRing s :=
  nativeReduction s (normalized s v hv (cartierElement a) (cartierElement_homogeneous a))

theorem normalizedEquation_mul (s : Finset Vertex) (v : Vertex) (hv : v ∈ s) (a : Fin 4) :
    (normalizedEquation s v hv a).val * closedCoordinateValue s v ^ coverDegree a =
      closedPolynomial s (CycleQ2LiteralCartierSplittings.coverPolynomial a) := by
  have h := reduction_normalized_mul s v hv (cartierElement a) (cartierElement_homogeneous a)
  rw [reduction_cartierElement] at h
  fin_cases a <;> exact h

theorem normalizedEquation_isUnit (s : Finset Vertex) (v : Vertex) (hv : v ∈ s) :
    IsUnit (normalizedEquation s v hv v.1) := by
  have h := (normalizedCartierUnit s v hv v.1 ⟨v.2, hv⟩).isUnit.map (nativeReduction s)
  unfold normalizedCartierUnit at h
  rw [normalizedConeUnit_value] at h
  exact h

theorem normalizedEquation_relation (s : Finset Vertex) (v : Vertex) (hv : v ∈ s) :
    normalizedEquation s v hv 2 * normalizedEquation s v hv 0 +
      normalizedEquation s v hv 3 * normalizedEquation s v hv 1 = 0 := by
  let x := closedCoordinateValue s v
  let e := normalizedEquation s v hv
  have h0 : (e 0).val * x ^ 4 = closedPolynomial s (originalG1 57) := normalizedEquation_mul s v hv 0
  have h1 : (e 1).val * x ^ 4 = closedPolynomial s originalG2 := normalizedEquation_mul s v hv 1
  have h2 : (e 2).val * x ^ 2 = closedPolynomial s (originalF1 57) := normalizedEquation_mul s v hv 2
  have h3 : (e 3).val * x ^ 2 = closedPolynomial s originalF2 := normalizedEquation_mul s v hv 3
  apply HomogeneousLocalization.val_injective
  apply ((closedCoordinateValue_isUnit s v hv).pow 6).mul_right_cancel
  simp only [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mul, HomogeneousLocalization.val_zero]
  change ((e 2).val * (e 0).val + (e 3).val * (e 1).val) * x ^ 6 = 0 * x ^ 6
  have h := closed_factorization s
  rw [← h0, ← h1, ← h2, ← h3] at h
  linear_combination h

private theorem dvd_of_unit_cofactor {R : Type*} [CommRing R] (a b f g : R)
    (hf : IsUnit f) (h : a * f + b * g = 0) : b ∣ a := by
  obtain ⟨u, rfl⟩ := hf
  refine ⟨-g * (↑(u⁻¹) : R), ?_⟩
  linear_combination (↑(u⁻¹) : R) * h - a * u.inv_mul

theorem nativeGenerator_span (s : Finset Vertex) (v : Vertex) (hv : v ∈ s) :
    Ideal.span ({normalizedEquation s v hv 2, normalizedEquation s v hv 3} : Set _) =
      Ideal.span ({generator s v hv} : Set _) := by
  obtain ⟨a,l⟩ := v
  have h := normalizedEquation_relation s (a,l) hv
  have hu := normalizedEquation_isUnit s (a,l) hv
  fin_cases a
  · change Ideal.span {normalizedEquation s (0,l) hv 2, normalizedEquation s (0,l) hv 3} =
        Ideal.span {generator s (0,l) hv}
    rw [← reduced_normalized_first_generator s l hv]
    apply Ideal.span_pair_eq_span_right_iff_dvd.mpr
    exact dvd_of_unit_cofactor _ _ _ _ hu h
  · change Ideal.span {normalizedEquation s (1,l) hv 2, normalizedEquation s (1,l) hv 3} =
        Ideal.span {generator s (1,l) hv}
    rw [← reduced_normalized_second_generator s l hv]
    apply Ideal.span_pair_eq_span_left_iff_dvd.mpr
    apply dvd_of_unit_cofactor _ _ _ _ hu
    rw [add_comm]
    exact h
  · change Ideal.span {normalizedEquation s (2,l) hv 2, normalizedEquation s (2,l) hv 3} =
        Ideal.span {generator s (2,l) hv}
    rw [generator_third, Ideal.span_singleton_one]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _)) hu
  · change Ideal.span {normalizedEquation s (3,l) hv 2, normalizedEquation s (3,l) hv 3} =
        Ideal.span {generator s (3,l) hv}
    rw [generator_fourth, Ideal.span_singleton_one]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)) hu

theorem nativeGenerator_map_span {R : Type*} [CommRing R] (s : Finset Vertex)
    (v : Vertex) (hv : v ∈ s) (φ : ClosedRing s →+* R) :
    Ideal.span ({φ (normalizedEquation s v hv 2), φ (normalizedEquation s v hv 3)} : Set R) =
      Ideal.span ({φ (generator s v hv)} : Set R) := by
  simpa only [Ideal.map_span, Set.image_insert_eq, Set.image_singleton] using
    congrArg (Ideal.map φ) (nativeGenerator_span s v hv)

end CycleQ2LiteralMovingDivisorOrbitPrincipal

end


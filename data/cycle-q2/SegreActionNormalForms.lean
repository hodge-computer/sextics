  map_evalTowers coeffHom quotientMap X (X 4) (X 0) (X 1) p
 theorem map_layerValue (p : Layers) : quotientMap (layerValue p) = quotientLayerValue p :=
  map_evalLayers coeffHom quotientMap X (X 1) p

/-! The four ordinary partial derivatives of the literal incidence threefold at
`(r, θ) = (57, 1)` have only the origin as common zero. On the chart `b = 1`,
the order-three symmetry gives three relations in `u = a` and the cubic
value `k`. Two integer Bézout identities eliminate `k`. The remaining
univariate polynomials have degrees 40 and 49 and are coprime modulo 13.
Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false

namespace Q2IntPoly

def val {R : Type*} [CommRing R] (x : R) : List ℤ → R
  | [] => 0
  | a :: p => a + x * val x p

def add : List ℤ → List ℤ → List ℤ
  | [], q => q
  | a :: p, [] => a :: p
  | a :: p, b :: q => (a + b) :: add p q

def scale (a : ℤ) : List ℤ → List ℤ := List.map (a * ·)

def mul : List ℤ → List ℤ → List ℤ
  | [], _ => []
  | a :: p, q => add (scale a q) (0 :: mul p q)

variable {R : Type*} [CommRing R] (x : R)

@[simp] theorem val_add (p q : List ℤ) :
    val x (add p q) = val x p + val x q := by
  induction p generalizing q with
  | nil => simp [add, val]
  | cons a p ih =>
    cases q with
    | nil => simp [add, val]
    | cons b q => simp [add, val, ih]; ring

@[simp] theorem val_scale (a : ℤ) (p : List ℤ) :
    val x (scale a p) = a * val x p := by
  induction p with
  | nil => simp [scale, val]
  | cons b p ih =>
    change ↑(a * b) + x * val x (scale a p) = _
    simp only [val, Int.cast_mul, ih]
    ring

@[simp] theorem val_mul (p q : List ℤ) :
    val x (mul p q) = val x p * val x q := by
  induction p with
  | nil => simp [mul, val]
  | cons a p ih => simp [mul, val, ih]; ring

end Q2IntPoly

namespace Q2BiInt

/-- Coefficients are in ascending degree, first in k and then in u. -/
abbrev Poly := List (List ℤ)

def C (n : ℤ) : Poly := [[n]]
def U : Poly := [[0, 1]]
def K : Poly := [[], [1]]

def add : Poly → Poly → Poly
  | [], q => q
  | a :: p, [] => a :: p
  | a :: p, b :: q => Q2IntPoly.add a b :: add p q

def mul : Poly → Poly → Poly
  | [], _ => []
  | a :: p, q => add (q.map (Q2IntPoly.mul a)) ([] :: mul p q)

def neg (p : Poly) : Poly := p.map (Q2IntPoly.scale (-1))

def sub (p q : Poly) : Poly := add p (neg q)

def pow (p : Poly) : ℕ → Poly
  | 0 => C 1
  | n + 1 => mul (pow p n) p

/-- Disregard trailing zero coefficients in either variable. -/
def bvEq (p q : Poly) : Bool := (sub p q).all (·.all (· == 0))

variable {R : Type*} [CommRing R] (u k : R)

def eval : Poly → R
  | [] => 0
  | a :: p => Q2IntPoly.val u a + k * eval p

@[simp] theorem eval_C (n : ℤ) : eval u k (C n) = n := by simp [eval, C, Q2IntPoly.val]
@[simp] theorem eval_U : eval u k U = u := by simp [eval, U, Q2IntPoly.val]
@[simp] theorem eval_K : eval u k K = k := by simp [eval, K, Q2IntPoly.val]
@[simp] theorem eval_const (p : List ℤ) : eval u k [p] = Q2IntPoly.val u p := by simp [eval]

@[simp] theorem eval_add (p q : Poly) : eval u k (add p q) = eval u k p + eval u k q := by
  induction p generalizing q with
  | nil => simp [eval, add]
  | cons a p ih =>
    cases q with
    | nil => simp [eval, add]
    | cons b q => simp [eval, add, ih]; ring

private theorem eval_scale (a : List ℤ) (p : Poly) :
    eval u k (p.map (Q2IntPoly.mul a)) = Q2IntPoly.val u a * eval u k p := by
  induction p with
  | nil => simp [eval]
  | cons b p ih =>
    simp only [List.map_cons, eval, Q2IntPoly.val_mul, ih]
    ring

@[simp] theorem eval_mul (p q : Poly) : eval u k (mul p q) = eval u k p * eval u k q := by
  induction p with
  | nil => simp [mul, eval]
  | cons a p ih =>
    simp only [mul, eval_add, eval, Q2IntPoly.val, eval_scale, ih]
    ring

@[simp] theorem eval_neg (p : Poly) : eval u k (neg p) = - eval u k p := by
  induction p with
  | nil => simp [neg, eval]
  | cons a p ih =>
    change Q2IntPoly.val u (Q2IntPoly.scale (-1) a) + k * eval u k (neg p) = _
    simp [eval, ih]
    ring

@[simp] theorem eval_sub (p q : Poly) : eval u k (sub p q) = eval u k p - eval u k q := by
  simp [sub, sub_eq_add_neg]

@[simp] theorem eval_pow (p : Poly) (n : ℕ) : eval u k (pow p n) = eval u k p ^ n := by
  induction n with
  | zero => simp [pow]
  | succ n ih => simp [pow, pow_succ, ih]

theorem eval_eq_of_bvEq (p q : Poly) (h : bvEq p q = true) : eval u k p = eval u k q := by
  have hz (a : List ℤ) (ha : a.all (· == 0) = true) : Q2IntPoly.val u a = 0 := by
    induction a with
    | nil => rfl
    | cons i a ih =>
      simp only [List.all_cons, Bool.and_eq_true, beq_iff_eq] at ha
      simp [Q2IntPoly.val, ha.1, ih ha.2]
  apply sub_eq_zero.mp
  rw [← eval_sub]
  generalize hsub : sub p q = r
  change (sub p q).all _ = true at h
  rw [hsub] at h
  clear hsub
  induction r with
  | nil => rfl
  | cons a r ih =>
    simp only [List.all_cons, Bool.and_eq_true] at h
    simp [eval, hz a h.1, ih h.2]

section
local instance : Add Poly := ⟨add⟩
local instance : Sub Poly := ⟨sub⟩
local instance : Mul Poly := ⟨mul⟩
local instance : Pow Poly ℕ := ⟨pow⟩
local instance : Neg Poly := ⟨neg⟩

def inputLambda : Poly := C 2 - C 57 ^ 3
def inputL : Poly := C 3 * inputLambda
def inputS : Poly := -(C 1 + C 3 * U ^ 2) * K - C 3 * U ^ 5
def inputT : Poly := neg (C 6) - C 2 * inputS - C 4 * U * K
def inputV : Poly :=
  inputL * K * (K - U - U ^ 3) - K * inputT - inputL * (U + C 1) * inputS
def inputP : Poly :=
  C 3 * inputV ^ 2 + K * (C 3 * inputV + (U + C 1) * inputS * inputL) * inputL * K
def inputQ : Poly :=
  C 6 * inputT ^ 2 + C 3 * inputLambda * inputT * inputL +
    C 2 * (C 3 * inputT * K + (U + C 1) * inputS * inputL) * inputL
def inputH : Poly := inputV * inputT * K ^ 2 - inputL ^ 2 * inputS ^ 3

private theorem evadd (p q : Poly) : eval u k (p + q) = eval u k p + eval u k q := eval_add ..
private theorem evsub (p q : Poly) : eval u k (p - q) = eval u k p - eval u k q := eval_sub ..
private theorem evmul (p q : Poly) : eval u k (p * q) = eval u k p * eval u k q := eval_mul ..
private theorem evpow (p : Poly) (n : ℕ) : eval u k (p ^ n) = eval u k p ^ n := eval_pow ..
private theorem evneg (p : Poly) : eval u k (-p) = -eval u k p := eval_neg ..
attribute [local simp] evadd evsub evmul evpow evneg

@[simp] theorem eval_inputLambda : eval u k inputLambda = 2 - 57 ^ 3 := by simp [inputLambda]
@[simp] theorem eval_inputL : eval u k inputL = 3 * eval u k inputLambda := by
  simp [inputL]
@[simp] theorem eval_inputS : eval u k inputS = -(1 + 3 * u ^ 2) * k - 3 * u ^ 5 := by simp [inputS]
@[simp] theorem eval_inputT : eval u k inputT = -6 - 2 * eval u k inputS - 4 * u * k := by simp [inputT]
@[simp] theorem eval_inputV : eval u k inputV =
    eval u k inputL * k * (k - u - u ^ 3) - k * eval u k inputT - eval u k inputL * (u + 1) * eval u k inputS := by
  simp [inputV]
@[simp] theorem eval_inputP : eval u k inputP =
    3 * eval u k inputV ^ 2 + k * (3 * eval u k inputV + (u + 1) * eval u k inputS * eval u k inputL) *
      eval u k inputL * k := by simp [inputP]
@[simp] theorem eval_inputQ : eval u k inputQ =
    6 * eval u k inputT ^ 2 + 3 * eval u k inputLambda * eval u k inputT * eval u k inputL +
      2 * (3 * eval u k inputT * k + (u + 1) * eval u k inputS * eval u k inputL) * eval u k inputL := by
  simp [inputQ]
@[simp] theorem eval_inputH : eval u k inputH =
    eval u k inputV * eval u k inputT * k ^ 2 - eval u k inputL ^ 2 * eval u k inputS ^ 3 := by simp [inputH]
end
end Q2BiInt


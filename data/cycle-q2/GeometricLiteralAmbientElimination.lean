set_option maxRecDepth 8192 in
set_option maxHeartbeats 1000000 in
theorem certificateA :
    bvEq (add (mul UP inputP) (mul UQ inputQ)) (mul (C ca) [A]) = true := by decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1000000 in
theorem certificateD :
    bvEq (add (mul UH inputH) (mul VQ inputQ)) (mul (C cd) [D]) = true := by decide

theorem eliminants_vanish {K : Type*} [Field K] [CharZero K] (u k : K)
    (hp : eval u k inputP = 0) (hq : eval u k inputQ = 0) (hh : eval u k inputH = 0) :
    Q2IntPoly.val u A = 0 ∧ Q2IntPoly.val u D = 0 := by
  have ha := eval_eq_of_bvEq u k _ _ certificateA
  have hd := eval_eq_of_bvEq u k _ _ certificateD
  simp only [eval_add, eval_mul, hp, hq, hh, mul_zero, zero_add, eval_C, eval_const] at ha hd
  constructor
  · exact (mul_eq_zero.mp ha.symm).resolve_left (by norm_num [ca])
  · exact (mul_eq_zero.mp hd.symm).resolve_left (by norm_num [cd])

end CycleQ2LiteralAmbientCertificate

open Polynomial
namespace AmbientElimination

/-- A Bézout identity and preservation of both degrees after reduction modulo a prime
give a nonzero integral resultant. -/
theorem resultant_ne_zero_of_mod_coprime {p : ℕ} [Fact p.Prime] (f g : ℤ[X])
    (hf : (Int.castRingHom (ZMod p)) f.leadingCoeff ≠ 0)
    (hg : (Int.castRingHom (ZMod p)) g.leadingCoeff ≠ 0)
    (h : IsCoprime (f.map (Int.castRingHom (ZMod p))) (g.map (Int.castRingHom (ZMod p)))) :
    f.resultant g ≠ 0 := by
  have hn := resultant_ne_zero _ _ h
  rw [natDegree_map_of_leadingCoeff_ne_zero _ hf,
    natDegree_map_of_leadingCoeff_ne_zero _ hg, resultant_map_map] at hn
  intro e
  exact hn (by rw [e, map_zero])

/-- The integral resultant is a Bézout combination, so a nonzero resultant excludes
a common root in every characteristic-zero field. -/
theorem no_common_root_of_resultant {K : Type*} [Field K] [CharZero K]
    (f g : ℤ[X]) (hres : f.resultant g ≠ 0)
    (hdeg : f.natDegree ≠ 0 ∨ g.natDegree ≠ 0) (x : K) :
    aeval x f ≠ 0 ∨ aeval x g ≠ 0 := by
  obtain ⟨s, t, _, _, rel⟩ := exists_mul_add_mul_eq_C_resultant f g le_rfl le_rfl hdeg
  by_contra! h
  have e := congrArg (aeval x) rel
  simp only [map_add, map_mul, h.1, h.2, zero_mul, zero_add, aeval_C] at e
  exact hres (Int.cast_eq_zero.mp (show (↑(f.resultant g) : K) = 0 from e.symm))


/-- Coefficients are stored in ascending degree order. -/
noncomputable def coeffPoly {R : Type*} [CommRing R] : List R → R[X]
  | [] => 0
  | a :: as => C a + X * coeffPoly as

private def addCoeffs {R : Type*} [Add R] : List R → List R → List R
  | [], bs => bs
  | as, [] => as
  | a :: as, b :: bs => (a + b) :: addCoeffs as bs

private def mulCoeffs {R : Type*} [CommRing R] : List R → List R → List R
  | [], _ => []
  | a :: as, bs => addCoeffs (bs.map (a * ·)) (0 :: mulCoeffs as bs)

private theorem coeffPoly_add {R : Type*} [CommRing R] (as bs : List R) :
    coeffPoly (addCoeffs as bs) = coeffPoly as + coeffPoly bs := by
  induction as generalizing bs with
  | nil => simp [addCoeffs, coeffPoly]
  | cons a as ih =>
    cases bs with
    | nil => simp [addCoeffs, coeffPoly]
    | cons b bs => simp only [addCoeffs, coeffPoly, map_add, ih]; ring

private theorem coeffPoly_smul {R : Type*} [CommRing R] (a : R) (bs : List R) :
    coeffPoly (bs.map (a * ·)) = C a * coeffPoly bs := by
  induction bs with
  | nil => simp [coeffPoly]
  | cons b bs ih => simp only [List.map_cons, coeffPoly, map_mul, ih]; ring

private theorem coeffPoly_mul {R : Type*} [CommRing R] (as bs : List R) :
    coeffPoly (mulCoeffs as bs) = coeffPoly as * coeffPoly bs := by
  induction as with
  | nil => simp [mulCoeffs, coeffPoly]
  | cons a as ih =>
    simp only [mulCoeffs, coeffPoly_add, coeffPoly_smul, coeffPoly, map_zero, zero_add, ih]; ring

private theorem coeffPoly_all_zero {R : Type*} [CommRing R] {xs : List R}
    (h : ∀ x ∈ xs, x = 0) : coeffPoly xs = 0 := by
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    simp only [List.mem_cons, forall_eq_or_imp] at h
    simp [coeffPoly, h.1, ih h.2]

/-- Verify a finite-field Bézout certificate by coefficient convolution. -/
theorem isCoprime_coeffPoly {R : Type*} [CommRing R] (as bs cs ds : List R)
    (xs : List R)
    (hc : addCoeffs (mulCoeffs cs as) (mulCoeffs ds bs) = 1 :: xs)
    (hz : ∀ x ∈ xs, x = 0) :
    IsCoprime (coeffPoly as) (coeffPoly bs) := by
  refine ⟨coeffPoly cs, coeffPoly ds, ?_⟩
  rw [← coeffPoly_mul, ← coeffPoly_mul, ← coeffPoly_add, hc, coeffPoly]
  simp [coeffPoly_all_zero hz]

theorem coeffPoly_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (as : List R) :
    (coeffPoly as).map φ = coeffPoly (as.map φ) := by
  induction as with
  | nil => simp [coeffPoly]
  | cons a as ih => simp [coeffPoly, ih]


private theorem coeffPoly_end {R : Type*} [CommRing R] [IsDomain R] (as : List R)
    {b : R} (hb : b ≠ 0) :
    (coeffPoly (as ++ [b])).natDegree = as.length ∧ (coeffPoly (as ++ [b])).leadingCoeff = b := by
  induction as with
  | nil => simp [coeffPoly]
  | cons a as ih =>
    have hn : coeffPoly (as ++ [b]) ≠ 0 := by
      intro h
      exact hb (by rw [← ih.2, h, leadingCoeff_zero])
    have hl : (C a).natDegree < (X * coeffPoly (as ++ [b])).natDegree := by
      simp [natDegree_X_mul hn]
    simp only [List.cons_append, coeffPoly, List.length_cons]
    rw [natDegree_add_eq_right_of_natDegree_lt hl, leadingCoeff_add_of_degree_lt (degree_lt_degree hl)]
    simp [natDegree_X_mul hn, ih.1, ih.2]

open CycleQ2LiteralAmbientCertificate
private def bezA : List (ZMod 13) := [1, 6, 6, 11, 1, 9, 8, 11, 3, 6, 11, 0, 2, 10, 6, 10, 12, 11, 7, 8, 9, 11, 11, 6, 4, 1, 10, 0, 9, 11, 2, 5, 9, 10, 0, 12, 3, 1, 12, 7, 8, 1, 0, 5, 5, 12, 3, 1, 4]
private def bezD : List (ZMod 13) := [5, 10, 9, 5, 7, 12, 4, 9, 11, 6, 1, 8, 1, 8, 10, 10, 11, 3, 5, 9, 8, 7, 10, 10, 3, 0, 6, 0, 1, 7, 7, 2, 1, 9, 5, 7, 12, 7, 6, 8]

private theorem coeffPoly_aeval {K : Type*} [Field K] [CharZero K] (x : K) (as : List ℤ) :
    aeval x (coeffPoly as) = Q2IntPoly.val x as := by
  induction as with
  | nil => simp [coeffPoly, Q2IntPoly.val]
  | cons a as ih => simp [coeffPoly, Q2IntPoly.val, ih]

set_option maxRecDepth 8192 in
set_option maxHeartbeats 4000000 in
theorem eliminants_no_common_root {K : Type*} [Field K] [CharZero K] (x : K) :
    Q2IntPoly.val x A ≠ 0 ∨ Q2IntPoly.val x D ≠ 0 := by
  let _ : Fact (Nat.Prime 13) := ⟨by decide⟩
  let φ := Int.castRingHom (ZMod 13)
  have hAend : A = A.dropLast ++ [A.getLast!] := by decide
  have hDend : D = D.dropLast ++ [D.getLast!] := by decide
  have hdegA := coeffPoly_end A.dropLast (b := A.getLast!) (by decide)
  have hdegD := coeffPoly_end D.dropLast (b := D.getLast!) (by decide)
  rw [← hAend] at hdegA
  rw [← hDend] at hdegD
  have hA : φ (coeffPoly A).leadingCoeff ≠ 0 := by
    rw [hdegA.2]
    decide +kernel
  have hD : φ (coeffPoly D).leadingCoeff ≠ 0 := by
    rw [hdegD.2]
    decide +kernel
  have hres : (coeffPoly A).resultant (coeffPoly D) ≠ 0 := by
    apply resultant_ne_zero_of_mod_coprime _ _ hA hD
    rw [coeffPoly_map, coeffPoly_map]
    apply isCoprime_coeffPoly _ _ bezA bezD (List.replicate 88 0)
    · decide +kernel
    · simp
  have hdeg : (coeffPoly A).natDegree ≠ 0 := by
    rw [hdegA.1]
    decide
  simpa only [coeffPoly_aeval] using no_common_root_of_resultant _ _ hres (.inl hdeg) x

end AmbientElimination

namespace CycleQ2LiteralAmbientCertificate

open Q2BiInt

theorem no_common_zero {K : Type*} [Field K] [CharZero K] (u k : K)
    (hp : eval u k inputP = 0) (hq : eval u k inputQ = 0) (hh : eval u k inputH = 0) : False := by
  obtain ⟨ha, hd⟩ := eliminants_vanish u k hp hq hh
  exact (AmbientElimination.eliminants_no_common_root u).elim (· ha) (· hd)

end CycleQ2LiteralAmbientCertificate

namespace CycleQ2LiteralAmbientElimination

variable {K : Type*} [Field K] [CharZero K]

def ambientLambda : K := 2 - 57 ^ 3

def ambientL : K := 3 * ambientLambda

def elimS (u k : K) : K := -(1 + 3 * u ^ 2) * k - 3 * u ^ 5

def elimT (u k : K) : K := -6 - 2 * elimS u k - 4 * u * k

def elimV (u k : K) : K :=
  ambientL * k * (k - u - u ^ 3) - k * elimT u k - ambientL * (u + 1) * elimS u k

def elimP (u k : K) : K :=
  3 * elimV u k ^ 2 + k * (3 * elimV u k + (u + 1) * elimS u k * ambientL) * ambientL * k

def elimQ (u k : K) : K :=
  6 * elimT u k ^ 2 + 3 * ambientLambda * elimT u k * ambientL +
    2 * (3 * elimT u k * k + (u + 1) * elimS u k * ambientL) * ambientL

def elimH (u k : K) : K :=
  elimV u k * elimT u k * k ^ 2 - ambientL ^ 2 * elimS u k ^ 3

/-- Eliminate the three invariant monomials on the chart where the second
coordinate is one. All three elimination identities hold even when the
cubic value vanishes. -/
theorem chart_relations (u x y k : K)
    (hk : k = y ^ 3 + x ^ 3 + (u + 1) * x * y + u + u ^ 3)
    (ha : 6 * u ^ 5 + 2 * k * (x * y + 1 + 3 * u ^ 2) = 0)
    (hb : 6 + 3 * ambientLambda * y ^ 3 + 2 * k * (x * y + 2 * u) = 0)
    (hc : 6 * x ^ 5 + 2 * k * (3 * x ^ 2 + (1 + u) * y) = 0)
    (hd : 6 * y ^ 5 + 3 * ambientLambda * y ^ 2 +
      2 * k * (3 * y ^ 2 + (1 + u) * x) = 0) :
    elimP u k = 0 ∧ elimQ u k = 0 ∧ elimH u k = 0 := by
  have hs : elimS u k = k * (x * y) := by
    unfold elimS
    linear_combination -ha / 2
  have ht : elimT u k = ambientL * y ^ 3 := by
    unfold elimT ambientL
    rw [hs]
    linear_combination -hb
  have hv : elimV u k = ambientL * k * x ^ 3 := by
    unfold elimV
    rw [ht, hs]
    linear_combination ambientL * k * hk
  refine ⟨?_, ?_, ?_⟩
  · unfold elimP
    rw [hs, hv]
    linear_combination ambientL ^ 2 * k ^ 2 * x * hc / 2
  · unfold elimQ
    rw [hs, ht]
    linear_combination ambientL ^ 2 * y * hd
  · unfold elimH
    rw [hs, ht, hv]
    ring

end CycleQ2LiteralAmbientElimination

namespace CycleQ2LiteralAmbientEquation

open CycleQ2LiteralAmbientElimination

/-- The normalized chart has no critical point over a characteristic-zero field. -/
theorem gradient_chart_no_zero {K : Type*} [Field K] [CharZero K] (u x y : K)
    (hg : ∀ j, gradient u 1 x y j = 0) : False := by
  let k := cubic u 1 x y
  have hk : k = y ^ 3 + x ^ 3 + (u + 1) * x * y + u + u ^ 3 := by
    unfold k cubic
    ring
  obtain ⟨hp, hq, hh⟩ := chart_relations u x y k hk
    (by simpa [gradient, k] using hg 0)
    (by simpa [gradient, k, ambientLambda] using hg 1)
    (by simpa [gradient, k, add_mul, add_assoc] using hg 2)
    (by simpa [gradient, k, ambientLambda, add_mul, add_assoc] using hg 3)
  apply CycleQ2LiteralAmbientCertificate.no_common_zero u k
  · simpa [elimP, elimV, elimT, elimS, ambientL, ambientLambda] using hp
  · simpa [elimQ, elimT, elimS, ambientL, ambientLambda] using hq
  · simpa [elimH, elimV, elimT, elimS, ambientL, ambientLambda] using hh

/-- Over every characteristic-zero field the ordinary gradient vanishes only at the origin. -/
theorem gradient_zero {K : Type*} [Field K] [CharZero K] (a b c d : K)
    (hg : ∀ j, gradient a b c d j = 0) : a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0 :=
  gradient_zero_of_chart (by norm_num) (by norm_num) gradient_chart_no_zero a b c d hg

end CycleQ2LiteralAmbientEquation

import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.Tactic.Ring

/-!
# Base change on the native homogeneous localization of a graded ring

A homogeneous specialization whose kernel is generated by degree-zero base
coefficients induces a tensor-product equivalence on every homogeneous chart.
A localization denominator may annihilate a numerator after specialization.
Multiplying by a sufficient power of that denominator brings the numerator
into the original graded kernel, where its degreewise decomposition applies.

Prepared for `fqlx` with OpenAI ChatGPT assistance.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section

namespace CycleQ2LiteralAmbientProjFiberChart

open HomogeneousLocalization
open scoped TensorProduct

variable {A B R K σ τ : Type*} [CommRing A] [CommRing B] [CommRing R] [CommRing K]
  [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]

private theorem fraction_val {x : A} {d : ℕ} (hx : x ∈ 𝒜 d) (n : ℕ) (a : A)
    (ha : a ∈ 𝒜 (n • d)) :
    (Away.mk 𝒜 hx n a ha).val = algebraMap A (Localization.Away x) a *
      IsLocalization.Away.invSelf x ^ n := by
  rw [Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq_mul]
  simp only [map_pow]
  rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf x ^ n), ← mul_pow,
    IsLocalization.Away.mul_invSelf, one_pow, mul_one]

private theorem clear_fraction {x : A} {d : ℕ} (hx : x ∈ 𝒜 d)
    (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • d)) (m : ℕ) :
    Away.mk 𝒜 hx n a ha = Away.mk 𝒜 hx (m + n) (x ^ m * a)
      (by rw [add_nsmul]; exact SetLike.mul_mem_graded (SetLike.pow_mem_graded m hx) ha) := by
  apply HomogeneousLocalization.val_injective
  rw [fraction_val, fraction_val, map_mul, map_pow, pow_add]
  calc
    _ = (algebraMap A (Localization.Away x) a * IsLocalization.Away.invSelf x ^ n) *
        ((algebraMap A (Localization.Away x) x * IsLocalization.Away.invSelf x) ^ m) := by
      rw [IsLocalization.Away.mul_invSelf, one_pow, mul_one]
    _ = _ := by rw [mul_pow]; ring

private theorem nativeMap_surjective (φ : 𝒜 →+*ᵍ ℬ)
    (hsurj : ∀ n (b : B), b ∈ ℬ n → ∃ a : A, a ∈ 𝒜 n ∧ φ a = b)
    {x : A} {d : ℕ} (hx : x ∈ 𝒜 d) : Function.Surjective (Away.map φ x) := by
  intro z
  obtain ⟨n,b,hb,rfl⟩ := Away.mk_surjective ℬ (φ.2 hx) z
  obtain ⟨a,ha,rfl⟩ := hsurj _ _ hb
  exact ⟨Away.mk 𝒜 hx n a ha, Away.map_mk ..⟩

private theorem numerator_in_graded_kernel (φ : 𝒜 →+*ᵍ ℬ)
    {x : A} {d : ℕ} (hx : x ∈ 𝒜 d) (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • d))
    (hz : Away.map φ x (Away.mk 𝒜 hx n a ha) = 0) : ∃ m : ℕ, φ (x ^ m * a) = 0 := by
  rw [Away.map_mk] at hz
  have hz' := congrArg HomogeneousLocalization.val hz
  rw [Away.val_mk, val_zero, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hz'
  obtain ⟨⟨_, ⟨m, rfl⟩⟩, hm⟩ := hz'
  exact ⟨m, by simpa only [map_mul, map_pow] using hm⟩

variable [Algebra R A] [Algebra R K]

/-- Same-degree coefficient decomposition of the homogeneous kernel. -/
def HasHomogeneousKernelDecomposition (φ : 𝒜 →+*ᵍ ℬ) : Prop :=
  ∀ (n : ℕ) (a : A), a ∈ 𝒜 n → φ a = 0 →
    ∃ (m : ℕ) (r : Fin m → R) (t : Fin m → A),
      (∀ j, algebraMap R K (r j) = 0) ∧ (∀ j, t j ∈ 𝒜 n) ∧
        a = ∑ j, algebraMap R A (r j) * t j

private theorem fraction_sum {x : A} {d : ℕ} (hx : x ∈ 𝒜 d) [Algebra R (Away 𝒜 x)]
    (hscalar : ∀ r, (algebraMap R (Away 𝒜 x) r).val =
      algebraMap A (Localization.Away x) (algebraMap R A r))
    (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • d)) {m : ℕ} (r : Fin m → R)
    (t : Fin m → A) (ht : ∀ j, t j ∈ 𝒜 (n • d))
    (he : a = ∑ j, algebraMap R A (r j) * t j) :
    Away.mk 𝒜 hx n a ha = ∑ j, algebraMap R (Away 𝒜 x) (r j) * Away.mk 𝒜 hx n (t j) (ht j) := by
  apply HomogeneousLocalization.val_injective
  change _ = algebraMap (Away 𝒜 x) (Localization.Away x) _
  rw [map_sum, fraction_val, he, map_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  simp only [map_mul, algebraMap_apply, hscalar, fraction_val, mul_assoc]

private theorem native_kernel_in_tensor (φ : 𝒜 →+*ᵍ ℬ)
    (hker : HasHomogeneousKernelDecomposition (R := R) (K := K) φ)
    {x : A} {d : ℕ} (hx : x ∈ 𝒜 d) [Algebra R (Away 𝒜 x)]
    (hscalar : ∀ r, (algebraMap R (Away 𝒜 x) r).val =
      algebraMap A (Localization.Away x) (algebraMap R A r))
    (z : Away 𝒜 x) (hz : Away.map φ x z = 0) :
    (Algebra.TensorProduct.includeRight (R := R) (A := K) z) = 0 := by
  obtain ⟨n,a,ha,rfl⟩ := Away.mk_surjective 𝒜 hx z
  obtain ⟨m,hm⟩ := numerator_in_graded_kernel φ hx n a ha hz
  have hma : x ^ m * a ∈ 𝒜 ((m + n) • d) := by
    rw [add_nsmul]
    exact SetLike.mul_mem_graded (SetLike.pow_mem_graded m hx) ha
  obtain ⟨s,r,t,hr,ht,he⟩ := hker _ _ hma hm
  rw [clear_fraction hx n a ha m, fraction_sum hx hscalar _ _ hma r t ht he, map_sum]
  apply Finset.sum_eq_zero
  intro j _
  rw [map_mul, AlgHom.commutes, IsScalarTower.algebraMap_apply R K, hr j, map_zero, zero_mul]

/-- An algebra homomorphism out of a tensor product is bijective if its
restriction to the right-hand factor is surjective and has precisely the
relations killed by tensoring along a surjection. -/
private theorem exists_tensorEquiv {C D : Type*} [CommRing C] [CommRing D]
    [Algebra R C] [Algebra K D] (g : C →+* D)
    (hc : ∀ r, g (algebraMap R C r) = algebraMap K D (algebraMap R K r))
    (hα : Function.Surjective (algebraMap R K)) (hg : Function.Surjective g)
    (hk : ∀ c, g c = 0 → Algebra.TensorProduct.includeRight (R := R) (A := K) c = 0) :
    ∃ e : K ⊗[R] C ≃ₐ[K] D, ∀ k c, e (k ⊗ₜ[R] c) = k • g c := by
  let : Algebra R D := ((algebraMap K D).comp (algebraMap R K)).toAlgebra
  let : IsScalarTower R K D := IsScalarTower.of_algebraMap_eq' rfl
  let g' : C →ₐ[R] D := { g with commutes' := hc }
  let G := AlgHom.liftEquiv R K C D g'
  have hG (k : K) (c : C) : G (k ⊗ₜ[R] c) = k • g c := rfl
  have hGR (c : C) : G (Algebra.TensorProduct.includeRight (R := R) (A := K) c) = g c := by
    change G (1 ⊗ₜ[R] c) = _
    rw [hG, one_smul]
  have hinj : Function.Injective G := by
    apply (injective_iff_map_eq_zero G).mpr
    intro z hz
    obtain ⟨c, rfl⟩ := Algebra.TensorProduct.includeRight_surjective C hα z
    exact hk c ((hGR c).symm.trans hz)
  have hsurj : Function.Surjective G := by
    intro z
    obtain ⟨c, rfl⟩ := hg z
    exact ⟨_, hGR c⟩
  exact ⟨AlgEquiv.ofBijective G ⟨hinj, hsurj⟩, hG⟩

/-- The tensor-product equivalence identifies specialization of homogeneous
fractions with the native `Away.map`, and respects the new coefficient algebra.
The homogeneous coordinate can have any degree. -/
theorem exists_awayTensorEquiv (φ : 𝒜 →+*ᵍ ℬ)
    (hα : Function.Surjective (algebraMap R K))
    (hsurj : ∀ n (b : B), b ∈ ℬ n → ∃ a : A, a ∈ 𝒜 n ∧ φ a = b)
    (hker : HasHomogeneousKernelDecomposition (R := R) (K := K) φ)
    {x : A} {d : ℕ} (hx : x ∈ 𝒜 d) [Algebra R (Away 𝒜 x)] [Algebra K (Away ℬ (φ x))]
    (hscalar : ∀ r, (algebraMap R (Away 𝒜 x) r).val =
      algebraMap A (Localization.Away x) (algebraMap R A r))
    (hcompat : ∀ r, Away.map φ x (algebraMap R (Away 𝒜 x) r) =
      algebraMap K (Away ℬ (φ x)) (algebraMap R K r)) :
    ∃ e : K ⊗[R] Away 𝒜 x ≃ₐ[K] Away ℬ (φ x),
      ∀ c z, e (c ⊗ₜ[R] z) = c • Away.map φ x z :=
  exists_tensorEquiv (Away.map φ x) hcompat hα (nativeMap_surjective φ hsurj hx)
    (native_kernel_in_tensor φ hker hx hscalar)

end CycleQ2LiteralAmbientProjFiberChart

end

#print axioms CycleQ2LiteralAmbientProjFiberChart.exists_awayTensorEquiv

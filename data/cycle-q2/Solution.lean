    Module.finrank ℂ globalCofactorImage≤Module.finrank ℂ (LinearMap.range entryDifferential) :=
  LinearMap.finrank_le_finrank_of_injective cofactorImageToRange_injective

theorem entry_rank_le_of_kernel_bound

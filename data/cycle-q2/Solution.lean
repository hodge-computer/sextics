#print axioms CycleQ2SegreExactRanks.full_range_eq_relation_kernel
#print axioms CycleQ2SegreExactRanks.literal_coefficient_matrix_rank
#print axioms CycleQ2SegreExactRanks.relationObstruction_finrank

theorem degree28ToGlobal_injective : Function.Injective degree28ToGlobal := by
  intro C D h
  funext i j
  apply Subtype.ext
  exact congrArg (fun M : GlobalMatrix ℂ (57:ℂ) Complex.I => M i j) h


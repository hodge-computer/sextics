    (he : ∀ q, aeval y ((presentation ℂ 57).equation q)=0)
    (hu : IsUnit (aeval y (leadingProduct ℂ)))
    (hb : IsUnit (aeval y basepointPolynomial))
    (P : Ideal (PointSurface y)) [P.IsPrime]
    (hx : ∃ j, curveCoordinate (pointMap y) j∉P) :

#print axioms CycleQ2IncidenceSexticFamily.family_seed_jacobian
#print axioms CycleQ2IncidenceSexticFamily.family_seed_open
#print axioms CycleQ2IncidenceSexticFamily.sextic_coordinate_fixed
end

def primeMatrix (y : ParameterIndex → S) (P : Ideal (PointSurface y)) [P.IsPrime] :
    Matrix (Fin 3) (Fin 3) (PointPrimeRing y P) :=
  (algebraMap (PointSurface y) (PointPrimeRing y P)).mapMatrix (curveMatrix (pointMap y))


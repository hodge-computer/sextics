def target3 : Sparse := [((0,0,0,17,0),denominator3)]

def residual3 : Sparse := add (combine generators multipliers3) (neg target3)

theorem checked3 : checkZero residual3 = true := by decide +kernel

theorem eval_target3 {R : Type*} [CommRing R] (φ : GaussianInt →+* R)
    (x : Fin 5 → R) : eval φ x target3 = φ denominator3 * x 3^17 := by
  simp [target3,eval,termValue,monomial]

theorem identity3 {R : Type*} [CommRing R] (φ : GaussianInt →+* R)
    (x : Fin 5 → R) :
    φ denominator3 * x 3^17 =
      ∑ k, eval φ x (multipliers3 k) * eval φ x (generators k) := by
  have h := eval_eq_zero_of_check φ x residual3 checked3
  rw [residual3,eval_add,eval_neg,eval_combine,eval_target3] at h
  have hh : (∑ k, eval φ x (generators k) * eval φ x (multipliers3 k)) =
      φ denominator3 * x 3^17 := sub_eq_zero.mp (by simpa only [sub_eq_add_neg] using h)
  rw [←hh]
  exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)

end CycleQ2SeedSurfaceBranchSparse


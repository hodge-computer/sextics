import Proposal.GeometricRelativeConstantCurve

/-!
# Principal equations for the actual relative constant-section ideal

The original cofactor identities reduce the three rows M*t to one row
after localizing at an original matrix pivot. Dividing by that homogeneous
pivot gives its genuine degree-zero equation. The contraction theorem
identifies the actual projective chart kernel, and the original basepoint
condition supplies a cover of the whole original surface.

This file establishes principality of the actual scheme-theoretic ideal.
Regularity is supplied separately by simultaneous associated-prime
avoidance. Neither flatness over parameters nor nonemptiness is inferred
from principality.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md for
attribution of the geometric strategy and the protected certificate gap.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2RelativeSectionIdeal

open CategoryTheory AlgebraicGeometry MvPolynomial Matrix
open CycleQ2IncidenceNormalForm CycleQ2IncidenceEquations
  CycleQ2IncidenceUniversalChart CycleQ2IncidenceImageLine
  CycleQ2GeometricIncidenceProj CycleQ2IncidenceGenericPointSemantics
  CycleQ2IncidencePolynomialRelations CycleQ2IncidenceCoefficientRelations
  CycleQ2SegreGenericSection CycleQ2GenericLinearSection
  CycleQ2UniversalCurveCartier CycleQ2GradedLocalizationProjection
  CycleQ2RelativeConstantSection CycleQ2RelativeConstantCurve

variable {S : Type} [CommRing S] [Algebra ℂ S]
variable (y : ParameterIndex → S) (t : Fin 3 → ℂ)

def relativePivotEvaluation (p : CycleQ2SegreCech.Chart) :
    MvPolynomial (Fin 3) (CoefficientPivot y p) →+* CoefficientPivot y p :=
  MvPolynomial.eval (fun j => algebraMap ℂ (CoefficientPivot y p) (t j))

theorem relativePivotEvaluation_sectionVector (p : CycleQ2SegreCech.Chart) (i : Fin 3) :
    relativePivotEvaluation y t p (sectionVector (localizedMatrix y p) i) =
      algebraMap (PointSurface y) (CoefficientPivot y p) (relativeEquation y t i) := by
  rw [relativeEquation_localize_row]
  simp only [relativePivotEvaluation, sectionVector, linearForm, map_sum, map_mul,
    MvPolynomial.eval_C, MvPolynomial.eval_X]
  apply Finset.sum_congr rfl
  intro j _
  exact (mul_comm _ _).trans (Algebra.smul_def (t j) (localizedMatrix y p i j)).symm

theorem relativeSectionIdeal_localize (p : CycleQ2SegreCech.Chart) :
    (relativeSectionIdeal y t).map
        (algebraMap (PointSurface y) (CoefficientPivot y p)) =
      (sectionIdeal (localizedMatrix y p)).map (relativePivotEvaluation y t p) := by
  rw [relativeSectionIdeal, sectionIdeal, Ideal.map_span, Ideal.map_span]
  congr 1
  ext a
  constructor
  · rintro ⟨b, ⟨i, rfl⟩, rfl⟩
    exact ⟨sectionVector (localizedMatrix y p) i, ⟨i, rfl⟩,
      relativePivotEvaluation_sectionVector y t p i⟩
  · rintro ⟨b, ⟨i, rfl⟩, rfl⟩
    exact ⟨relativeEquation y t i, ⟨i, rfl⟩,
      (relativePivotEvaluation_sectionVector y t p i).symm⟩

theorem ordinaryRelativeIdeal_principal [Nontrivial S]
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    (relativeSectionIdeal y t).map
        (algebraMap (PointSurface y) (CoefficientPivot y p)) =
      Ideal.span {algebraMap (PointSurface y) (CoefficientPivot y p)
        (relativeEquation y t p.1)} := by
  rw [relativeSectionIdeal_localize]
  obtain ⟨u, hu'⟩ := localizedMatrix_pivot_isUnit y p
  have hc := @CycleQ2SegreCech.cofactors_map_zero
    (PointSurface y) (inferInstance : CommRing (PointSurface y))
    (CoefficientPivot y p) (inferInstance : CommRing (CoefficientPivot y p))
    (algebraMap (PointSurface y) (CoefficientPivot y p))
    (CycleQ2IncidenceBasepointOpen.curveMatrix (pointMap y))
    (curveMatrix_cofactors y he hu)
  rw [sectionIdeal_principal (localizedMatrix y p) hc p u hu',
    Ideal.map_span, Set.image_singleton]
  change Ideal.span {relativePivotEvaluation y t p
    (sectionVector (localizedMatrix y p) p.1)} = _
  rw [relativePivotEvaluation_sectionVector]

theorem ordinaryRelativeIdeal_principal_fraction [Nontrivial S]
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    (relativeSectionIdeal y t).map
        (algebraMap (PointSurface y) (CoefficientPivot y p)) =
      Ideal.span {(relativeProjectiveEquation y t p).val} := by
  rw [ordinaryRelativeIdeal_principal y t he hu p,
    ← relativeProjectiveEquation_val_mul,
    Ideal.span_singleton_mul_right_unit
      (IsLocalization.Away.algebraMap_isUnit (basePivot y p))]

/-- The contracted ideal is generated by the original normalized row. -/
theorem projectiveRelativeIdeal_principal [Nontrivial S]
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    projectiveRelativeIdeal y t p = Ideal.span {relativeProjectiveEquation y t p} := by
  rw [projectiveRelativeIdeal, ordinaryRelativeIdeal_principal_fraction y t he hu p]
  exact principalIdeal_comap_val (surfaceGrade y)
    (relativePivot_homogeneous y p) (relativeProjectiveEquation y t p)

/-- The actual structure-sheaf map of the original relative closed
immersion has precisely the displayed principal kernel. -/
theorem relativeSectionKernel_principal [Nontrivial S]
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    RingHom.ker ((relativeCurveToSurface y t).app (relativePivotOpen y p)).hom =
      Ideal.span {relativeEquationSection y t p} := by
  rw [← Ideal.map_comap_of_surjective (relativeSurfacePivotSectionsEquiv y p).toRingHom
      (relativeSurfacePivotSectionsEquiv y p).surjective
      (RingHom.ker ((relativeCurveToSurface y t).app (relativePivotOpen y p)).hom),
    relativeSectionKernel_comap, projectiveRelativeIdeal_principal y t he hu p,
    Ideal.map_span, Set.image_singleton]
  rfl

/-- The original basepoint condition makes these actual pivot opens
cover the entire original surface, over the original coefficient ring. -/
theorem relativePivotOpen_cover [Nontrivial S]
    (hb : IsUnit (aeval y CycleQ2IncidenceBasepointOpen.basepointPolynomial)) :
    (⨆ p : CycleQ2SegreCech.Chart, relativePivotOpen y p) = ⊤ := by
  apply top_unique
  intro x hx
  obtain ⟨i, j, hij⟩ := CycleQ2IncidenceBasepointOpen.specialized_prime_pivot_cover
    (pointMap y) hb x.asHomogeneousIdeal.toIdeal (surface_coordinate_exists y x)
  apply TopologicalSpace.Opens.mem_iSup.mpr
  refine ⟨(i, j), ?_⟩
  change basePivot y (i, j) ∉ x.asHomogeneousIdeal.toIdeal
  exact hij

#print axioms relativeSectionIdeal_localize
#print axioms projectiveRelativeIdeal_principal
#print axioms relativeSectionKernel_principal
#print axioms relativePivotOpen_cover

end CycleQ2RelativeSectionIdeal

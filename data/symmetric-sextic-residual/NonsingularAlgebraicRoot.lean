import Mathlib.RingTheory.Unramified.Field
import Mathlib.RingTheory.Kaehler.Polynomial
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
import Mathlib.Tactic

/-!
# Algebraicity of a nonsingular polynomial zero

A zero of a square polynomial system over a field, whose evaluated Jacobian
is invertible, generates a finite field extension.  This concerns the actual
zero, without any numerical approximation or asserted algebraicity premise.

The proof kills the universal differentials of the generators by the
Jacobian.  The generated field is therefore formally unramified and, being
essentially of finite type, finite over the coefficient field.
-/

noncomputable section

namespace NonsingularAlgebraicRoot

open MvPolynomial
open scoped BigOperators

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000

section ChainRule

variable {K L M ι : Type*} [Field K] [Field L] [Algebra K L]
  [AddCommGroup M] [Module L M] [Module K M] [IsScalarTower K L M]
  [Fintype ι] [DecidableEq ι]

omit [IsScalarTower K L M] in
/-- The multivariate chain rule, including module-valued derivations. -/
theorem derivation_aeval (D : Derivation K L M) (x : ι → L)
    (p : MvPolynomial ι K) :
    D (aeval x p) = ∑ i, aeval x (pderiv i p) • D (x i) := by
  induction p using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq =>
      simp only [map_add, hp, hq, add_smul, Finset.sum_add_distrib]
  | mul_X p j hp =>
      rw [map_mul, Derivation.leibniz]
      simp only [aeval_X] at hp ⊢
      rw [hp]
      simp only [pderiv_mul, map_add, map_mul, aeval_X, add_smul,
        Finset.sum_add_distrib]
      have hfirst : (∑ i, (aeval x (pderiv i p) * x j) • D (x i)) =
          x j • (∑ i, aeval x (pderiv i p) • D (x i)) := by
        rw [Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [mul_comm, mul_smul]
      rw [hfirst]
      have hsecond : (∑ i, (aeval x p *
          aeval x (pderiv i (X j : MvPolynomial ι K))) • D (x i)) =
          aeval x p • D (x j) := by
        simp [pderiv_X, Pi.single_apply, apply_ite, ite_smul]
      rw [hsecond, add_comm]

/-- An invertible scalar matrix has zero kernel on tuples from every module. -/
theorem tuple_eq_zero_of_left_inverse
    (A B : Matrix ι ι L) (hAB : A * B = 1) (v : ι → M)
    (hv : ∀ i, ∑ j, B i j • v j = 0) : ∀ i, v i = 0 := by
  intro i
  calc
    v i = ∑ k, (A * B) i k • v k := by simp [hAB, Matrix.one_apply, ite_smul]
    _ = ∑ j, A i j • (∑ k, B j k • v k) := by
      simp only [Matrix.mul_apply, Finset.sum_smul, Finset.smul_sum, mul_smul]
      exact Finset.sum_comm
    _ = 0 := by simp [hv]

end ChainRule

section GeneratedField

variable {K E ι : Type*} [Field K] [Field E] [Algebra K E]
  [Fintype ι] [DecidableEq ι]

def coordinateField (x : ι → E) : IntermediateField K E :=
  IntermediateField.adjoin K (Set.range x)

def coordinate (x : ι → E) (i : ι) : coordinateField (K := K) x :=
  ⟨x i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem coordinate_val (x : ι → E) (i : ι) :
    ((coordinate (K := K) x i : coordinateField (K := K) x) : E) = x i := rfl

omit [Fintype ι] [DecidableEq ι] in
theorem coordinate_aeval_val (x : ι → E) (p : MvPolynomial ι K) :
    ((aeval (coordinate (K := K) x) p : coordinateField (K := K) x) : E) =
      aeval x p := by
  change (coordinateField (K := K) x).val (aeval (coordinate (K := K) x) p) = _
  simpa only [IntermediateField.coe_val, coordinate_val] using
    comp_aeval_apply (coordinate (K := K) x) (coordinateField (K := K) x).val p

omit [Fintype ι] [DecidableEq ι] in
theorem derivation_eq_zero_of_coordinates (x : ι → E)
    (D : Derivation K (coordinateField (K := K) x)
      Ω[coordinateField (K := K) x⁄K])
    (hD : ∀ i, D (coordinate (K := K) x i) = 0) :
    ∀ a, D a = 0 := by
  rintro ⟨a, ha⟩
  refine IntermediateField.adjoin_induction K
    (p := fun a ha => D ⟨a, ha⟩ = 0) ?_ ?_ ?_ ?_ ?_ ha
  · rintro a ⟨i, rfl⟩
    exact hD i
  · intro c
    exact D.map_algebraMap c
  · intro a b ha hb hDa hDb
    change D (⟨a, ha⟩ + ⟨b, hb⟩) = 0
    rw [map_add, hDa, hDb, add_zero]
  · intro a ha hDa
    change D (⟨a, ha⟩⁻¹) = 0
    rw [Derivation.leibniz_inv, hDa, smul_zero]
  · intro a b ha hb hDa hDb
    change D (⟨a, ha⟩ * ⟨b, hb⟩) = 0
    rw [Derivation.leibniz, hDa, hDb, smul_zero, smul_zero, add_zero]

/-- The field generated by a nonsingular polynomial zero is finite. -/
theorem finite_coordinateField (p : ι → MvPolynomial ι K) (x : ι → E)
    (hroot : ∀ i, aeval x (p i) = 0)
    (hdet : (Matrix.det fun i j => aeval x (pderiv j (p i))) ≠ 0) :
    FiniteDimensional K (coordinateField (K := K) x) := by
  let L := coordinateField (K := K) x
  let y : ι → L := coordinate (K := K) x
  let J : Matrix ι ι L := fun i j => aeval y (pderiv j (p i))
  have hrootL : ∀ i, aeval y (p i) = 0 := by
    intro i
    apply Subtype.val_injective
    change ((aeval (coordinate (K := K) x) (p i) : coordinateField (K := K) x) : E) = 0
    rw [coordinate_aeval_val, hroot i]
  have hdetL : J.det ≠ 0 := by
    intro hzero
    apply hdet
    have hmap : (coordinateField (K := K) x).val J.det = 0 := by rw [hzero, map_zero]
    rw [AlgHom.map_det] at hmap
    change (Matrix.det fun i j =>
      ((aeval (coordinate (K := K) x) (pderiv j (p i)) :
        coordinateField (K := K) x) : E)) = 0 at hmap
    simpa only [coordinate_aeval_val] using hmap
  let D := KaehlerDifferential.D K L
  have hDJ : ∀ i, ∑ j, J i j • D (y j) = 0 := by
    intro i
    simpa only [J, hrootL i, map_zero] using
      (derivation_aeval D y (p i)).symm
  have hDy : ∀ i, D (y i) = 0 :=
    tuple_eq_zero_of_left_inverse J⁻¹ J
      (Matrix.nonsing_inv_mul J (isUnit_iff_ne_zero.mpr hdetL))
      (fun i => D (y i)) hDJ
  have hD : ∀ a, D a = 0 := derivation_eq_zero_of_coordinates x D hDy
  have : Algebra.FormallyUnramified K L := by
    constructor
    suffices (⊤ : Submodule L Ω[L⁄K]) ≤ ⊥ from
      (subsingleton_iff_forall_eq 0).mpr fun z => this trivial
    rw [← KaehlerDifferential.span_range_derivation, Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    change D a = 0
    exact hD a
  have : Algebra.EssFiniteType K L :=
    IntermediateField.essFiniteType_iff.mpr
      (IntermediateField.fg_adjoin_of_finite (Set.finite_range x))
  exact Algebra.FormallyUnramified.finite_of_free K L

/-- Every coordinate of a nonsingular polynomial zero is algebraic. -/
theorem coordinate_isAlgebraic (p : ι → MvPolynomial ι K) (x : ι → E)
    (hroot : ∀ i, aeval x (p i) = 0)
    (hdet : (Matrix.det fun i j => aeval x (pderiv j (p i))) ≠ 0) :
    ∀ i, IsAlgebraic K (x i) := by
  have := finite_coordinateField p x hroot hdet
  intro i
  exact IsAlgebraic.algHom (coordinateField (K := K) x).val
    (IsAlgebraic.of_finite K (coordinate (K := K) x i))

end GeneratedField

#print axioms finite_coordinateField
#print axioms coordinate_isAlgebraic

end NonsingularAlgebraicRoot

import Proposal.SymmetricNegativeMultiplierClassification
import Proposal.WeightedComponentMultiplication
import Mathlib.RingTheory.Ideal.Operations

/-!
# The full negative weighted-degree-six Jacobian quotient

This identifies the span of the twelve actual directions with the entire
Jacobian ideal in the coefficient-defined negative source space. Thus the
dimension theorem concerns the full Jacobian quotient of the exact target.
-/

noncomputable section

namespace SymmetricNegativeJacobian

open MvPolynomial SymmetricNegativeSource
open scoped BigOperators

set_option maxHeartbeats 4000000
set_option backward.isDefEq.respectTransparency false

/-- The full ideal generated by all five actual partial derivatives. -/
def jacobianIdeal : Ideal Poly :=
  Ideal.span (Set.range fun i : Fin 5 => pderiv i WeightedFiberSmoothness.weightedG)

theorem ambientDirectionSpan_le_jacobian :
    ambientDirectionSpan ≤ jacobianIdeal.restrictScalars ℂ := by
  apply Submodule.span_le.mpr
  rintro _ ⟨j, rfl⟩
  change direction j ∈ jacobianIdeal
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨partialIndex j, rfl⟩)

theorem source_mem_jacobian_iff (p : Poly) (hp : p ∈ source) :
    p ∈ jacobianIdeal ↔ p ∈ ambientDirectionSpan := by
  constructor
  · intro hJ
    obtain ⟨q, hq⟩ := Ideal.mem_span_range_iff_exists_fun.mp hJ
    have hhom := (bihomogeneous_iff_mem_source p).mpr hp
    have hproj := congrArg (weightedHomogeneousComponent bidegreeWeight (6,1)) hq
    rw [hhom.weightedHomogeneousComponent_same, map_sum] at hproj
    rw [← hproj]
    apply Submodule.sum_mem
    intro i _
    rw [← complementary_add_derivative i,
      weightedComponent_mul_homogeneous bidegreeWeight (partial_bihomogeneous i)]
    exact homogeneous_mul_partial_mem_directionSpan i _
      (weightedHomogeneousComponent_isWeightedHomogeneous _ _)
  · intro hpSpan
    exact ambientDirectionSpan_le_jacobian hpSpan

/-- The full Jacobian ideal intersected with the actual negative sextic space. -/
def jacobianPiece : Submodule ℂ source :=
  (jacobianIdeal.restrictScalars ℂ).comap source.subtype

theorem ambientDirectionSpan_eq_map :
    ambientDirectionSpan = directionSpan.map source.subtype := by
  unfold ambientDirectionSpan directionSpan
  rw [Submodule.map_span, ← Set.range_comp]
  rfl

theorem jacobianPiece_eq_directionSpan : jacobianPiece = directionSpan := by
  ext p
  change (p.val ∈ jacobianIdeal) ↔ p ∈ directionSpan
  rw [source_mem_jacobian_iff p.val p.property, ambientDirectionSpan_eq_map]
  constructor
  · rintro ⟨x, hx, he⟩
    have hxp : x = p := Subtype.ext he
    cases hxp
    exact hx
  · intro hp
    exact ⟨p, hp, rfl⟩

theorem jacobianPiece_finrank : Module.finrank ℂ jacobianPiece = 12 := by
  rw [jacobianPiece_eq_directionSpan, directionSpan_finrank]

/-- The exact negative weighted-degree-six Jacobian quotient has dimension 48. -/
theorem negative_jacobian_quotient_finrank :
    Module.finrank ℂ (source ⧸ jacobianPiece) = 48 := by
  rw [jacobianPiece_eq_directionSpan]
  exact direction_quotient_finrank

#print axioms source_mem_jacobian_iff
#print axioms jacobianPiece_eq_directionSpan
#print axioms negative_jacobian_quotient_finrank

end SymmetricNegativeJacobian

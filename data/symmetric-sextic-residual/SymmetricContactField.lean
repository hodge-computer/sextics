def jacobianIntegerData (i j : Index) : ℤ := rowEntry (jacobianRows i) j

def jacobianData : Matrix Index Index (ZMod 37) := fun i j => (jacobianIntegerData i j : ZMod 37)

def inverseData : Matrix Index Index (ZMod 37) := fun i j => (inverseIntegerData i j : ZMod 37)

def equations (i : Index) : EqPoly := polynomial (equationData i)

instance : Fact (Nat.Prime 37) := ⟨by decide⟩

def seedParameters : Fin 3 → ZMod 37 := ![1,3,13]
def seedPoint : Index → ZMod 37 := fun i => if i = 71 then 27 else if i = 72 then 4 else 0

def specialMap : Base →+* ZMod 37 := eval₂Hom (Int.castRingHom (ZMod 37)) seedParameters

instance specialAlgebra : Algebra Base (ZMod 37) := specialMap.toAlgebra
instance genericAlgebra : Algebra Base FunctionField := parameterMap.toAlgebra

@[simp] theorem specialMap_X (i : Fin 3) : algebraMap Base (ZMod 37) (X i) = seedParameters i := by
  change specialMap (X i) = _
  simp [specialMap]

def seedParametersInt : Fin 3 → ℤ := ![1,3,13]
def seedPointInt : Index → ℤ := fun i => if i = 71 then 27 else if i = 72 then 4 else 0

@[simp] theorem cast_seedParameters (i : Fin 3) :
    (seedParametersInt i : ZMod 37) = seedParameters i := by
  fin_cases i <;> norm_num [seedParametersInt, seedParameters]

@[simp] theorem cast_seedPoint (i : Index) : (seedPointInt i : ZMod 37) = seedPoint i := by
  simp only [seedPointInt, seedPoint]
  split_ifs <;> norm_num

theorem seed_values_integer : ∀ i : Index,
    polynomialValue seedParametersInt seedPointInt (equationData i) % 37 = 0 := by decide

theorem seed_jacobian_integer : ∀ i j : Index,
    polynomialPartial seedParametersInt seedPointInt j (equationData i) % 37 =
      jacobianIntegerData i j := by decide

theorem seed_inverse_integer : ∀ i j : Index,
    rowProduct (jacobianRows i) (fun k => inverseIntegerData k j) % 37 =
      if i = j then 1 else 0 := by decide

open MvPolynomial SymmetricAffineField SymmetricRatioCurrent
open HoldoutConstruction ReflectionCoupledFano
open scoped BigOperators
set_option maxHeartbeats 2000000
set_option maxRecDepth 16384
set_option backward.isDefEq.respectTransparency false

theorem seed_values (i : Index) : polynomialValue seedParameters seedPoint (equationData i) = 0 := by
  have h := congrArg (Int.castRingHom (ZMod 37)) (seed_values_integer i)
  change ((polynomialValue seedParametersInt seedPointInt (equationData i) % 37 : ℤ) : ZMod 37) = 0 at h
  have hc := (ZMod.intCast_mod
    (polynomialValue seedParametersInt seedPointInt (equationData i)) 37).symm.trans h
  have hm := polynomialValue_map (Int.castRingHom (ZMod 37)) seedParametersInt seedPointInt (equationData i)
  change ((polynomialValue seedParametersInt seedPointInt (equationData i) : ℤ) : ZMod 37) =
    polynomialValue (fun j => (seedParametersInt j : ZMod 37))
      (fun j => (seedPointInt j : ZMod 37)) (equationData i) at hm
  simpa only [cast_seedParameters, cast_seedPoint] using hm.symm.trans hc

theorem seed_jacobian_table (i j : Index) :
    polynomialPartial seedParameters seedPoint j (equationData i) = jacobianData i j := by
  have h := congrArg (Int.castRingHom (ZMod 37)) (seed_jacobian_integer i j)
  change ((polynomialPartial seedParametersInt seedPointInt j (equationData i) % 37 : ℤ) : ZMod 37) =
    (jacobianIntegerData i j : ZMod 37) at h
  have hc := (ZMod.intCast_mod
    (polynomialPartial seedParametersInt seedPointInt j (equationData i)) 37).symm.trans h
  have hm := polynomialPartial_map (Int.castRingHom (ZMod 37)) seedParametersInt seedPointInt (equationData i) j
  change ((polynomialPartial seedParametersInt seedPointInt j (equationData i) : ℤ) : ZMod 37) =
    polynomialPartial (fun k => (seedParametersInt k : ZMod 37))
      (fun k => (seedPointInt k : ZMod 37)) j (equationData i) at hm
  simpa only [cast_seedParameters, cast_seedPoint, jacobianData] using hm.symm.trans hc

theorem seed_inverse_table (i j : Index) :
    (∑ k : Index, jacobianData i k*inverseData k j) = if i = j then 1 else 0 := by
  have h := congrArg (Int.castRingHom (ZMod 37)) (seed_inverse_integer i j)
  change ((rowProduct (jacobianRows i) (fun k => inverseIntegerData k j) % 37 : ℤ) : ZMod 37) =
    ((if i = j then 1 else 0 : ℤ) : ZMod 37) at h
  have hc := (ZMod.intCast_mod
    (rowProduct (jacobianRows i) (fun k => inverseIntegerData k j)) 37).symm.trans h
  have hsum : (∑ k : Index, jacobianData i k*inverseData k j) =
      (rowProduct (jacobianRows i) (fun k => inverseIntegerData k j) : ZMod 37) := by
    rw [← sum_rowEntry_mul]
    simp [jacobianData, inverseData, jacobianIntegerData]
  rw [hsum, hc]
  split_ifs <;> norm_num

theorem seed_equations (i : Index) : aeval seedPoint (equations i) = 0 := by
  rw [equations, eval_polynomial]
  simpa using seed_values i

theorem seed_jacobian_unit : IsUnit (Matrix.det
    (fun i j : Index => aeval seedPoint (pderiv i (equations j)))) := by
  have hmatrix : (fun i j : Index => aeval seedPoint (pderiv i (equations j))) =
      jacobianData.transpose := by
    ext i j
    rw [equations, eval_partial_polynomial]
    simpa using seed_jacobian_table j i
  rw [hmatrix, Matrix.det_transpose]
  have hprod : jacobianData*inverseData = 1 := by
    ext i j
    simpa [Matrix.mul_apply, Matrix.one_apply] using seed_inverse_table i j
  have hdet := congrArg Matrix.det hprod
  rw [Matrix.det_mul, Matrix.det_one] at hdet
  apply isUnit_iff_ne_zero.mpr
  intro hzero
  rw [hzero, zero_mul] at hdet
  exact zero_ne_one hdet

/-- A finite separable generic solution of this exact integral system.
The source matching needed for a certificate is a separate obligation. -/
theorem exists_generic_field :
    ∃ I : Ideal (SquareGenericAlgebra FunctionField equations), I.IsMaximal ∧
      Module.Finite FunctionField ((SquareGenericAlgebra FunctionField equations) ⧸ I) ∧
      Algebra.IsSeparable FunctionField ((SquareGenericAlgebra FunctionField equations) ⧸ I) ∧
      (∀ i, aeval (squareGenericCoordinates equations I) (equations i) = 0) ∧
      IsUnit (Matrix.det (fun i j => aeval (squareGenericCoordinates equations I)
        (pderiv i (equations j)))) :=
  square_system_generic_lift equations seedPoint seed_equations seed_jacobian_unit
    parameterMap_injective


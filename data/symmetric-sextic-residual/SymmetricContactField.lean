/-!
# Integral contact-point incidence for the exact reflection pencil

The 70 coefficient equations of a norm presentation are restricted to a
71-dimensional affine slice. Three moving-point equations give a square
system of size 73 over Z[lambda,r,s]. All finite data are exact inputs to
kernel-checked arithmetic, not an asserted characteristic-zero root.

The field factor below is selected from a 74-variable augmentation,
inverting both the 70-dimensional coefficient Jacobian minor and the
ambient point minor in `(r,alpha,beta)`. These opens are verified at the
seed and retained in characteristic zero. They make the contact parameter
nonconstant and provide its normalized derivation.

The finite seed is derived from the norm-contact construction in
`scripts/verify-norm-contact-span.py`. Its balanced integral lifts define
the square incidence; they are not asserted to solve it in characteristic
zero. Arithmetic lifting supplies the field factor instead.

Prepared with OpenAI Codex assistance for fqlx. The maintained arithmetic
lifting and the original norm-contact construction retain their attribution.
No prescribed-source primitive or source trace equality is asserted here.
-/

noncomputable section
namespace SymmetricContactField

open MvPolynomial SymmetricAffineField SymmetricRatioCurrent
open HoldoutConstruction ReflectionCoupledFano
open scoped BigOperators

set_option maxHeartbeats 0
set_option maxRecDepth 16384
set_option backward.isDefEq.respectTransparency false

abbrev Base := ParameterRing
abbrev Index := Fin 73
abbrev EqPoly := MvPolynomial Index Base

structure Term where
  coefficient : ℤ
  parameters : List (Fin 3)
  unknowns : List Index
  deriving DecidableEq

def monomialPoly : List Index → EqPoly
  | [] => 1
  | i :: m => X i*monomialPoly m

def termCoefficient (s : Term) : Base :=
  C s.coefficient*(s.parameters.map (fun i => X i)).prod

def polynomial : List Term → EqPoly
  | [] => 0
  | s :: p => C (termCoefficient s)*monomialPoly s.unknowns+polynomial p

def monomialValue {K : Type*} [CommRing K] (m : List Index) (x : Index → K) : K :=
  (m.map x).prod

def monomialPartial {K : Type*} [CommRing K] : List Index → (Index → K) → Index → K
  | [], _, _ => 0
  | i :: m, x, k => (if i = k then monomialValue m x else 0)+x i*monomialPartial m x k

def termValue {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K) (s : Term) : K :=
  (s.coefficient : K)*(s.parameters.map p).prod*monomialValue s.unknowns x

def polynomialValue {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K) : List Term → K
  | [] => 0
  | s :: q => termValue p x s+polynomialValue p x q

def polynomialPartial {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K)
    (i : Index) : List Term → K
  | [] => 0
  | s :: q => (s.coefficient : K)*(s.parameters.map p).prod*monomialPartial s.unknowns x i+
      polynomialPartial p x i q

theorem eval_monomial {K : Type*} [CommRing K] [Algebra Base K]
    (x : Index → K) (m : List Index) :
    aeval x (monomialPoly m) = monomialValue m x := by
  induction m with
  | nil => simp [monomialPoly, monomialValue]
  | cons i m ih => simp [monomialPoly, monomialValue, ih]

theorem eval_coefficient {K : Type*} [CommRing K] [Algebra Base K] (s : Term) :
    algebraMap Base K (termCoefficient s) =
      (s.coefficient : K)*(s.parameters.map (fun i => algebraMap Base K (X i))).prod := by
  simp [termCoefficient, map_list_prod, Function.comp_def]

theorem eval_polynomial {K : Type*} [CommRing K] [Algebra Base K]
    (x : Index → K) (p : List Term) :
    aeval x (polynomial p) =
      polynomialValue (fun i => algebraMap Base K (X i)) x p := by
  induction p with
  | nil => simp [polynomial, polynomialValue]
  | cons s p ih => simp [polynomial, polynomialValue, termValue, eval_monomial,
      eval_coefficient, ih]

theorem eval_partial_monomial {K : Type*} [CommRing K] [Algebra Base K]
    (x : Index → K) (m : List Index) (j : Index) :
    aeval x (pderiv j (monomialPoly m)) = monomialPartial m x j := by
  induction m with
  | nil => simp [monomialPoly, monomialPartial]
  | cons i m ih =>
    by_cases h : i = j
    · subst i
      simp [monomialPoly, monomialPartial, eval_monomial, ih, add_comm]
    · simp [monomialPoly, monomialPartial, pderiv_X, h, ih, add_comm]

theorem eval_partial_polynomial {K : Type*} [CommRing K] [Algebra Base K]
    (x : Index → K) (p : List Term) (j : Index) :
    aeval x (pderiv j (polynomial p)) =
      polynomialPartial (fun i => algebraMap Base K (X i)) x j p := by
  induction p with
  | nil => simp [polynomial, polynomialPartial]
  | cons s p ih =>
    simp [polynomial, polynomialPartial, eval_coefficient,
      eval_partial_monomial, ih]

def rowEntry : List (Index × ℤ) → Index → ℤ
  | [], _ => 0
  | (i,c) :: row, j => (if i = j then c else 0)+rowEntry row j

def rowProduct : List (Index × ℤ) → (Index → ℤ) → ℤ
  | [], _ => 0
  | (i,c) :: row, v => c*v i+rowProduct row v

theorem sum_rowEntry_mul (row : List (Index × ℤ)) (v : Index → ℤ) :
    (∑ j : Index, rowEntry row j*v j) = rowProduct row v := by
  induction row with
  | nil => simp [rowEntry, rowProduct]
  | cons s row ih =>
    rcases s with ⟨i,c⟩
    simp [rowEntry, rowProduct, add_mul, Finset.sum_add_distrib, ih, ite_mul]

theorem monomialValue_map {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (x : Index → A) (m : List Index) :
    f (monomialValue m x) = monomialValue m (fun i => f (x i)) := by
  simp [monomialValue, map_list_prod, Function.comp_def]

theorem monomialPartial_map {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (x : Index → A) (m : List Index) (i : Index) :
    f (monomialPartial m x i) = monomialPartial m (fun j => f (x j)) i := by
  induction m with
  | nil => simp [monomialPartial]
  | cons j m ih =>
    by_cases h : j = i <;> simp [monomialPartial, h, monomialValue_map, ih]

theorem polynomialValue_map {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (p : Fin 3 → A) (x : Index → A) (q : List Term) :
    f (polynomialValue p x q) = polynomialValue (fun i => f (p i)) (fun i => f (x i)) q := by
  induction q with
  | nil => simp [polynomialValue]
  | cons s q ih =>
    simp [polynomialValue, termValue, monomialValue_map, map_list_prod, Function.comp_def, ih]

theorem polynomialPartial_map {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (p : Fin 3 → A) (x : Index → A) (q : List Term) (i : Index) :
    f (polynomialPartial p x i q) =
      polynomialPartial (fun j => f (p j)) (fun j => f (x j)) i q := by
  induction q with
  | nil => simp [polynomialPartial]
  | cons s q ih =>
    simp [polynomialPartial, monomialPartial_map, map_list_prod, Function.comp_def, ih]


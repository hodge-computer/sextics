theorem time_evalG_of_omits_x_u (p : GP) (hx : pderiv 3 p = 0) (hu : pderiv 4 p = 0) :
    ratioTangent 0 (evalG p) = 0 := by
  have hs : ratioTangent 0 (evalG p) = 2*t*Dx (evalG p) := by

  factorValue 0 x y*factorValue 2 x y+factorValue 1 x y*factorValue 3 x y+
    factorValue 4 x y^2-factorValue 5 x y^2

def integerTarget {K : Type*} [CommRing K] (lam : K) (y : Fin 5 → K) : K :=
  let qx := y 0^2+2*y 0*y 1-y 4
  let qy := y 2^2+2*y 2*y 3-lam^2*y 4
  14*y 0^6+7*y 1^6+14*y 2^6+7*y 3^6+
    210*y 0^4*y 4+210*y 0^2*y 4^2+14*y 4^3+
    210*lam^2*y 2^4*y 4+210*lam^4*y 2^2*y 4^2+14*lam^6*y 4^3+
    5*qx^2*qy+10*qx*qy^2

/-- The 70 sparse integral equations are the full norm identity for the
unchanged weighted reflection pencil, not an unrelated modular system. -/
theorem norm_identity {K : Type*} [CommRing K] (p : Fin 3 → K)
    (x : Index → K) (y : Fin 5 → K) :
    7*normValue x y-integerTarget (p 0) y =
      (normIndices.map (fun i => polynomialValue p x (equationData (normIndex i))*
        (List.map y (plusMonomial i)).prod)).sum := by
  simp [normValue, factorValue, coefficientValue, coefficientConstant,
    coefficientVelocity, activeCoordinate, ambientMonomial, plusMonomial,
    integerTarget, factorIndices, normIndices, polynomialValue, termValue, monomialValue, normIndex, equationData, Matrix.cons_val]
  ring

def pointCoordinates {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K) : Fin 5 → K :=
  ![1,p 1,x 71,p 2*x 71,x 72]

theorem point_equation_first {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K) :
    polynomialValue p x (equationData 70) = factorValue 0 x (pointCoordinates p x) := by
  simp [factorValue, coefficientValue, coefficientConstant,
    coefficientVelocity, activeCoordinate, ambientMonomial, pointCoordinates, factorIndices,
    polynomialValue, termValue, monomialValue, equationData, Matrix.cons_val]
  ring

theorem point_equation_second {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K) :
    polynomialValue p x (equationData 71) = factorValue 1 x (pointCoordinates p x) := by
  simp [factorValue, coefficientValue, coefficientConstant,
    coefficientVelocity, activeCoordinate, ambientMonomial, pointCoordinates, factorIndices,
    polynomialValue, termValue, monomialValue, equationData, Matrix.cons_val]
  ring

theorem point_equation_third {K : Type*} [CommRing K] (p : Fin 3 → K) (x : Index → K) :
    polynomialValue p x (equationData 72) =
      factorValue 4 x (pointCoordinates p x)+factorValue 5 x (pointCoordinates p x) := by
  simp [factorValue, coefficientValue, coefficientConstant,
    coefficientVelocity, activeCoordinate, ambientMonomial, pointCoordinates, factorIndices,
    polynomialValue, termValue, monomialValue, equationData, Matrix.cons_val]
  ring


def relativePrimitiveOfSixTraceMatches (H : CurveField)
    (hslots : ∀ j, j ≠ 6 → momentSlots 6*(moments H j-TargetSlots.targetMomentSlots j) =
      momentSlots j*(moments H 6-TargetSlots.targetMomentSlots 6)) : RelativePrimitive :=

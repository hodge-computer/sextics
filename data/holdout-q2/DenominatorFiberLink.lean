import Proposal.NewLineAlgebra
import Proposal.QuadraticSolver
import Proposal.HoldoutDenominator
import Proposal.HoldoutCoefficientMap
import Proposal.SexticAssembly

/-! Exact legality of the generic degree-27 norm denominator on the endpoint
fiber. Matrix specialization and the determinant Bezout argument reuse the
accepted finite-algebra infrastructure. -/
noncomputable section
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
namespace HoldoutQ2.DenominatorFiberLink
open Polynomial NewSpecialization
open CheckedPolynomialLists

def legalityReductionQuotientData : List ℚ := [(-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (), (-), (-), (), (-), (), (-), (), (-), (), (), (-), (), (-), (), (-), ()]
def legalityReductionQuotient : Polynomial ℚ := encode legalityReductionQuotientData

theorem legalityReductionChecked :
    pad 80 (CheckedPolynomialLists.sub
      (CheckedPolynomialLists.add
        (CheckedPolynomialLists.pow (CheckedPolynomialLists.add eData fData) 3) [5])
      legality_factorData) =
      pad 80 (CheckedPolynomialLists.mul PData legalityReductionQuotientData) := by
  decide +kernel

theorem legalityReduction : (e+f)^3+5-legality_factor=P*legalityReductionQuotient := by
  have h := eq_of_pad_eq legalityReductionChecked
  simpa only [encode_sub, encode_add, encode_pow, encode_mul, e, f, P,
    legality_factor, legalityReductionQuotient, encode, map_ofNat, mul_zero, add_zero] using h

/-- The supplied reduced polynomial is the cubic in the actual line sum. -/
theorem legality_actual : AdjoinRoot.mk NewSpecialization.P legality_factor =
    (AdjoinRoot.mk NewSpecialization.P e + AdjoinRoot.mk NewSpecialization.P f)^3 + 5 := by
  have h := congrArg (AdjoinRoot.mk NewSpecialization.P) legalityReduction
  simp only [map_add,map_sub,map_pow,map_ofNat,map_mul,AdjoinRoot.mk_self,zero_mul] at h
  linear_combination -h

abbrev RationalAlgebra := AdjoinRoot NewSpecialization.P
def rationalBasis : Module.Basis (Fin 27) ℚ RationalAlgebra :=
  AdjoinRootSpecialization.basis NewSpecialization.P NewSpecialization.P_monic
    NewSpecialization.P_natDegree

def rationalSum : RationalAlgebra := AdjoinRoot.mk NewSpecialization.P (e+f)
def rationalInverse : RationalAlgebra := AdjoinRoot.mk NewSpecialization.P legality_inverse

theorem rational_inverse : (rationalSum^3+5)*rationalInverse=1 := by
  have h := congrArg (AdjoinRoot.mk NewSpecialization.P) legality_bezout
  simp only [map_sub,map_mul,AdjoinRoot.mk_self,zero_mul,sub_zero,map_one] at h
  rw [legality_actual] at h
  simpa only [rationalSum,rationalInverse,map_add] using h

def rationalSumMatrix : Matrix (Fin 27) (Fin 27) ℚ :=
  Algebra.leftMulMatrix rationalBasis rationalSum

def rationalInverseMatrix : Matrix (Fin 27) (Fin 27) ℚ :=
  Algebra.leftMulMatrix rationalBasis rationalInverse

theorem rational_matrix_inverse :
    (rationalSumMatrix^3+5)*rationalInverseMatrix=1 := by
  have h := congrArg (Algebra.leftMulMatrix rationalBasis) rational_inverse
  simpa only [map_mul,map_add,map_pow,map_ofNat,map_one,
    rationalSumMatrix,rationalInverseMatrix] using h

def complexSumMatrix : Matrix (Fin 27) (Fin 27) ℂ :=
  rationalSumMatrix.map (Rat.castHom ℂ)
def complexInverseMatrix : Matrix (Fin 27) (Fin 27) ℂ :=
  rationalInverseMatrix.map (Rat.castHom ℂ)

theorem complex_matrix_inverse :
    (complexSumMatrix^3+(5:ℂ) • (1:Matrix (Fin 27) (Fin 27) ℂ))*complexInverseMatrix=1 := by
  have h := congrArg ((Rat.castHom ℂ).mapMatrix) rational_matrix_inverse
  simp only [map_mul,map_add,map_pow,map_ofNat,map_one,RingHom.mapMatrix_apply] at h
  have h5 : (5:ℂ) • (1:Matrix (Fin 27) (Fin 27) ℂ) = 5 := by
    ext i j
    by_cases hij : i=j <;> simp [Matrix.smul_apply,Matrix.ofNat_apply,hij]
  simpa only [complexSumMatrix,complexInverseMatrix,h5] using h

/-- Generic multiplication matrices specialize in the monic power basis. -/
theorem map_leftMulMatrix_target {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (p : R[X]) (q : S[X]) (hp : p.Monic) (hq : q.Monic)
    {n : ℕ} (hn : p.natDegree=n) (hm : q.natDegree=n)
    (he : p.map φ=q) (x : AdjoinRoot p) :
    (Algebra.leftMulMatrix (AdjoinRootSpecialization.basis p hp hn) x).map φ =
      Algebra.leftMulMatrix (AdjoinRootSpecialization.basis q hq hm)
        (AdjoinRoot.map φ p q (he ▸ dvd_refl q) x) := by
  subst q
  exact AdjoinRootSpecialization.map_leftMulMatrix φ p hp hn hm x

open NewLineAlgebra

def coefficientToComplex : Coefficients →+* ℂ :=
  (Rat.castHom ℂ).comp NewLineAlgebra.specialize

def genericBasis : Module.Basis (Fin 27) Coefficients E :=
  AdjoinRootSpecialization.basis NewLineAlgebra.P NewLineAlgebra.P_monic
    NewLineAlgebra.P_natDegree

def genericSumMatrix : Matrix (Fin 27) (Fin 27) Coefficients :=
  Algebra.leftMulMatrix genericBasis (lineE+lineF)

theorem generic_matrix_specializes :
    genericSumMatrix.map NewLineAlgebra.specialize = rationalSumMatrix := by
  have h := map_leftMulMatrix_target NewLineAlgebra.specialize NewLineAlgebra.P
    NewSpecialization.P NewLineAlgebra.P_monic NewSpecialization.P_monic
    NewLineAlgebra.P_natDegree NewSpecialization.P_natDegree P_specialize (lineE+lineF)
  change genericSumMatrix.map NewLineAlgebra.specialize =
    Algebra.leftMulMatrix rationalBasis (toSpecial (lineE+lineF)) at h
  rw [map_add,toSpecial_lineE,toSpecial_lineF,← map_add] at h
  exact h

theorem generic_matrix_cast : genericSumMatrix.map coefficientToComplex = complexSumMatrix := by
  rw [coefficientToComplex]
  change (genericSumMatrix.map NewLineAlgebra.specialize).map (Rat.castHom ℂ) = _
  rw [generic_matrix_specializes]
  rfl

/-- Definitionally the same determinant as `GenericQuadratic.D`. -/
def activeDenominator : MvPolynomial (Fin 4) Coefficients :=
  QuadraticSolver.denominator (Algebra.leftMulMatrix genericBasis) lineE lineF

def activeFiberValues : Fin 4 → Polynomial ℂ := ![1,1,Polynomial.X^2,0]

theorem activeDenominator_fiber :
    MvPolynomial.eval₂Hom (Polynomial.C.comp coefficientToComplex)
      activeFiberValues activeDenominator = HoldoutDenominator.normFiber complexSumMatrix := by
  rw [activeDenominator,QuadraticSolver.denominator_eval₂]
  rw [HoldoutDenominator.normFiber,← generic_matrix_cast]
  congr 1
  ext i j : 2
  simp [activeFiberValues,genericSumMatrix,Matrix.sub_apply,Matrix.smul_apply,
    Matrix.add_apply,Matrix.map_apply,map_add,sub_sub]

theorem activeDenominator_fiber_legal :
    IsRelPrime HoldoutDenominator.fFiber
      (MvPolynomial.eval₂Hom (Polynomial.C.comp coefficientToComplex)
        activeFiberValues activeDenominator) := by
  rw [activeDenominator_fiber]
  exact HoldoutDenominator.normFiber_legal complexSumMatrix complexInverseMatrix complex_matrix_inverse

/-- The final clearing argument only needs its nonzero scalar fiber factor. -/
theorem denominator_legal_of_active_fiber {k : ℂ} (hk : k^2+k+1=0)
    (D : HodgeComputer.Poly) (u : ℂ) (hu : u≠0)
    (hD : HoldoutDenominator.fiber k D = Polynomial.C u *
      MvPolynomial.eval₂Hom (Polynomial.C.comp coefficientToComplex)
        activeFiberValues activeDenominator) :
    IsRelPrime HoldoutDenominator.targetF D := by
  apply HoldoutDenominator.denominator_legal_of_scaled_normFiber hk D
    complexSumMatrix complexInverseMatrix u hu complex_matrix_inverse
  simpa only [activeDenominator_fiber] using hD

/-- Naturality of the good-fiber map after the actual passive-ratio substitution. -/
theorem passive_fiber (k : ℂ) (hk : k^2+k+1=0)
    (P : MvPolynomial (Fin 4) Coefficients) :
    HoldoutSexticAssembly.activeNormFiber k
      (MvPolynomial.map (CoefficientMap.lineCoefficientMap k hk) P) =
    MvPolynomial.eval₂Hom (Polynomial.C.comp coefficientToComplex) activeFiberValues P := by
  induction P using MvPolynomial.induction_on with
  | C r =>
      simp only [MvPolynomial.map_C,HoldoutSexticAssembly.activeNormFiber,
        MvPolynomial.eval₂Hom_C,RingHom.comp_apply,CoefficientMap.lineCoefficientMap_specialization]
      rfl
  | add p q hp hq => simp only [map_add,hp,hq]
  | mul_X p i hp =>
      simp only [map_mul,MvPolynomial.map_X,hp]
      simp [HoldoutSexticAssembly.activeNormFiber,activeFiberValues]

/-- The underlying determinant has scalar factor one after passive substitution. -/
theorem passive_activeDenominator_fiber (k : ℂ) (hk : k^2+k+1=0) :
    HoldoutSexticAssembly.activeNormFiber k
      (MvPolynomial.map (CoefficientMap.lineCoefficientMap k hk) activeDenominator) =
      HoldoutDenominator.normFiber complexSumMatrix := by
  rw [passive_fiber,activeDenominator_fiber]

/-- The q=2 denominator introduces exactly the nonzero scalar factor six. -/
theorem passive_q2Denominator_fiber (k : ℂ) (hk : k^2+k+1=0) :
    HoldoutSexticAssembly.activeNormFiber k
      (MvPolynomial.map (CoefficientMap.lineCoefficientMap k hk)
        (MvPolynomial.C (6:Coefficients)*activeDenominator)) =
      Polynomial.C (6:ℂ) * HoldoutDenominator.normFiber complexSumMatrix := by
  simp only [map_mul,map_ofNat,passive_activeDenominator_fiber]

end HoldoutQ2.DenominatorFiberLink
#print axioms HoldoutQ2.DenominatorFiberLink.denominator_legal_of_active_fiber

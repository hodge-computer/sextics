private lemma encode_append_singleton (xs : List ℚ) (c : ℚ) :
    encode (xs ++ [c]) = encode xs + Polynomial.C c * Polynomial.X^xs.length := by
  rw [encode_append]
  simp only [encode, mul_zero, add_zero]
  rw [mul_comm]

private lemma map_encode_append_singleton (xs : List ℚ) (c : ℚ) :
    (encode (xs ++ [c])).map (Rat.castHom ℂ) =
      (encode xs).map (Rat.castHom ℂ) + Polynomial.C ((Rat.castHom ℂ) c) * Polynomial.X^xs.length := by
  rw [encode_append_singleton]
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]

private lemma map_encode_singleton (c : ℚ) :
    (encode [c]).map (Rat.castHom ℂ) = Polynomial.C ((Rat.castHom ℂ) c) := by
  simp only [encode, mul_zero, add_zero, Polynomial.map_C]

private lemma clear_certificate (S I P B : Polynomial ℚ) (a b c d : ℚ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hd : d ≠ 0)
    (h : Polynomial.C (c*d) *
      (((Polynomial.C a*S)^3 + Polynomial.C (140*a^2)*(Polynomial.C a*S) +
        Polynomial.C (536*a^3)) * (Polynomial.C b*I)) +
      Polynomial.C (a^3*b) * ((Polynomial.C c*P) * (Polynomial.C d*B)) =
      Polynomial.C (a^3*b*c*d)) :
    (S^3 + 140*S + 536)*I + P*B = 1 := by
  have hn : Polynomial.C (a^3*b*c*d) ≠ (0 : Polynomial ℚ) :=
    Polynomial.C_ne_zero.mpr (mul_ne_zero (mul_ne_zero (mul_ne_zero (pow_ne_zero 3 ha) hb) hc) hd)
  apply mul_left_cancel₀ hn
  calc
    Polynomial.C (a^3*b*c*d) * ((S^3 + 140*S + 536)*I + P*B) =
      Polynomial.C (c*d) *
        (((Polynomial.C a*S)^3 + Polynomial.C (140*a^2)*(Polynomial.C a*S) +
          Polynomial.C (536*a^3)) * (Polynomial.C b*I)) +
        Polynomial.C (a^3*b) * ((Polynomial.C c*P) * (Polynomial.C d*B)) := by
          simp only [map_mul, map_pow, map_ofNat]
          ring
    _ = Polynomial.C (a^3*b*c*d) := h
    _ = Polynomial.C (a^3*b*c*d) * 1 := (mul_one _).symm


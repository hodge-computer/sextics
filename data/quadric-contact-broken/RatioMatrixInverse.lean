/-- Exact inverse certificate for f(x(r)+y(r)) modulo the 27-line polynomial. -/
theorem inverse_identity :
    (lineSum ^ 3 + 140 * lineSum + 536) * inversePolynomial +
      linePolynomial * bezoutPolynomial = 1 := by
  have h := eq_of_pad_eq inverse_integer_data_identity
  simp only [encode_add, encode_mul, encode_pow, encode_scale, encode,
    encode_lineSumIntegerData, encode_inversePolynomialIntegerData,
    encode_linePolynomialIntegerData, encode_bezoutPolynomialIntegerData,
    mul_zero, add_zero] at h
  have hrat := clear_certificate (encode lineSumData) (encode inversePolynomialData)
    (encode linePolynomialData) (encode bezoutPolynomialData)
    lineSumDen inversePolynomialDen linePolynomialDen bezoutPolynomialDen
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) h
  have hc := congrArg (Polynomial.mapRingHom (Rat.castHom ℂ)) hrat
  simpa only [map_add, map_mul, map_pow, map_ofNat, map_one,
    map_lineSumData, map_linePolynomialData, map_inversePolynomialData,
    map_bezoutPolynomialData] using hc

/-- Evaluating the polynomial identity supplies an inverse in any complex algebra,
including the noncommutative matrix algebra used by the witness. -/
theorem evaluated_inverse {A : Type*} [Ring A] [Algebra ℂ A]
    (r : A) (hP : Polynomial.aeval r linePolynomial = 0) :
    ((Polynomial.aeval r lineSum) ^ 3 + 140 * Polynomial.aeval r lineSum + 536) *
      Polynomial.aeval r inversePolynomial = 1 := by
  have h := congrArg (Polynomial.aeval r) inverse_identity
  simpa only [map_add, map_mul, map_pow, map_ofNat, map_one, hP, zero_mul, add_zero] using h

theorem evaluated_matrix_inverse {n : Type*} [Fintype n] [DecidableEq n]
    (R : Matrix n n ℂ) (hP : Polynomial.aeval R linePolynomial = 0) :
    ((Polynomial.aeval R lineSum) ^ 3 + (140 : ℂ) • Polynomial.aeval R lineSum +
      (536 : ℂ) • (1 : Matrix n n ℂ)) * Polynomial.aeval R inversePolynomial = 1 := by
  simpa only [Algebra.smul_def, map_ofNat, mul_one] using evaluated_inverse R hP

